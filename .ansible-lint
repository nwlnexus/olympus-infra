---
# ansible-lint configuration
profile: basic

# Skip rules that are cosmetic/naming preferences and consistent across all roles
skip_list:
  - var-naming[no-role-prefix]  # register vars and cross-role vars intentionally short
  - role-name                   # hyphenated role names (cloudflared-k8s, cloudflare-access) are intentional
  - parser-error                # k3s linux.yml: ansible-lint cannot parse heredoc with embedded Jinja2
