<file path="roles/iscsi/tasks/linux_csi_node.yml">
# roles/iscsi/tasks/linux_csi_node.yml
---
# Ensures host-level iSCSI prerequisites for Trident CSI driver.
# The CSI driver handles target discovery, CHAP authentication, and login.
# Ansible only needs: packages installed, services running, initiator name set.

- name: Set deterministic iSCSI initiator name
  ansible.builtin.copy:
    content: "InitiatorName=iqn.2004-04.net.olympus:{{ ansible_facts['hostname'] }}\n"
    dest: /etc/iscsi/initiatorname.iscsi
    mode: "0600"
  become: true
  notify: Restart iscsid

- name: Install iSCSI and multipath packages
  ansible.builtin.apt:
    name:
      - open-iscsi
      - multipath-tools
    state: present
    update_cache: true
  become: true

- name: Enable and start iscsid
  ansible.builtin.systemd:
    name: iscsid
    enabled: true
    state: started
  become: true

- name: Configure multipath.conf for Trident + Longhorn coexistence
  # Trident's iSCSI volumes are single-path; the multipath-tools default
  # (find_multipaths "strict"/"yes") skips single-path devices, so the LUN never
  # gets a /dev/mapper map and the mount fails with "multipath device not found".
  # find_multipaths "no" makes multipathd claim it. (NetApp Trident recommendation.)
  #
  # Side effect of find_multipaths "no": multipathd also claims Longhorn's volume
  # frontend, which presents as an IET (tgt) VIRTUAL-DISK iSCSI device. Once claimed
  # as an mpath_member, Longhorn's CSI mkfs fails with "/dev/longhorn/pvc-... is
  # apparently in use by the system" and pods hang in ContainerCreating.
  # Blacklist the IET/VIRTUAL-DISK signature so multipathd leaves Longhorn devices
  # alone while still claiming QNAP "iSCSI Storage" LUNs. (olympus-sdk#133)
  ansible.builtin.copy:
    dest: /etc/multipath.conf
    content: |
      defaults {
          user_friendly_names yes
          find_multipaths no
      }

      # Longhorn volume frontend (tgt) — must NOT be claimed by multipathd,
      # otherwise mkfs on /dev/longhorn/* fails ("in use by the system").
      blacklist {
          device {
              vendor "IET"
              product "VIRTUAL-DISK"
          }
      }
    owner: root
    group: root
    mode: "0644"
  become: true
  notify: Restart multipathd

- name: Enable and start multipathd
  ansible.builtin.systemd:
    name: multipathd
    enabled: true
    state: started
  become: true
</file>

<file path="roles/iscsi/tasks/linux_host_mount.yml">
# roles/iscsi/tasks/linux_host_mount.yml
---
# ── 1Password credential resolution ─────────────────────────────────────────
- name: Read 1Password service account token
  ansible.builtin.slurp:
    src: "{{ iscsi_op_token_file }}"
  register: _iscsi_op_token
  become: true
  no_log: true
  failed_when: false
  when: iscsi_op_item | length > 0

- name: Fetch iSCSI storage address from 1Password
  ansible.builtin.command:
    argv:
      - op
      - read
      - "op://Dev/{{ iscsi_op_item }}/storageAddress"
  environment:
    OP_SERVICE_ACCOUNT_TOKEN: "{{ _iscsi_op_token.content | b64decode | trim }}"
  register: _iscsi_op_portal
  changed_when: false
  no_log: true
  when:
    - iscsi_op_item | length > 0
    - _iscsi_op_token.content is defined

- name: Fetch iSCSI target IQN from 1Password
  ansible.builtin.command:
    argv:
      - op
      - read
      - "op://Dev/{{ iscsi_op_item }}/iqn"
  environment:
    OP_SERVICE_ACCOUNT_TOKEN: "{{ _iscsi_op_token.content | b64decode | trim }}"
  register: _iscsi_op_iqn
  changed_when: false
  no_log: true
  when:
    - iscsi_op_item | length > 0
    - _iscsi_op_token.content is defined

- name: Fetch iSCSI CHAP username from 1Password
  ansible.builtin.command:
    argv:
      - op
      - read
      - "op://Dev/{{ iscsi_op_item }}/chapInitiatorUsername"
  environment:
    OP_SERVICE_ACCOUNT_TOKEN: "{{ _iscsi_op_token.content | b64decode | trim }}"
  register: _iscsi_op_chap_user
  changed_when: false
  no_log: true
  when:
    - iscsi_op_item | length > 0
    - _iscsi_op_token.content is defined

- name: Fetch iSCSI CHAP password from 1Password
  ansible.builtin.command:
    argv:
      - op
      - read
      - "op://Dev/{{ iscsi_op_item }}/chapInitiatorPassword"
  environment:
    OP_SERVICE_ACCOUNT_TOKEN: "{{ _iscsi_op_token.content | b64decode | trim }}"
  register: _iscsi_op_chap_password
  changed_when: false
  no_log: true
  when:
    - iscsi_op_item | length > 0
    - _iscsi_op_token.content is defined

- name: Override iSCSI vars from 1Password values
  ansible.builtin.set_fact:
    iscsi_portal: "{{ _iscsi_op_portal.stdout | trim }}"
    iscsi_target_iqn: "{{ _iscsi_op_iqn.stdout | trim }}"
    iscsi_chap_user: "{{ _iscsi_op_chap_user.stdout | trim }}"
    iscsi_chap_password: "{{ _iscsi_op_chap_password.stdout | trim }}"
  no_log: true
  when:
    - iscsi_op_item | length > 0
    - _iscsi_op_token.content is defined

# ── Existing tasks follow ────────────────────────────────────────────────────
- name: Set deterministic iSCSI initiator name
  ansible.builtin.copy:
    content: "InitiatorName=iqn.2004-04.net.olympus:{{ ansible_facts['hostname'] }}\n"
    dest: /etc/iscsi/initiatorname.iscsi
    mode: "0600"
  become: true
  notify: Restart iscsid

- name: Install open-iscsi
  ansible.builtin.apt:
    name: open-iscsi
    state: present
    update_cache: true
  become: true

- name: Enable and start iscsid
  ansible.builtin.systemd:
    name: iscsid
    enabled: true
    state: started
  become: true

- name: Discover iSCSI targets
  ansible.builtin.command: >
    iscsiadm -m discovery -t sendtargets
    -p {{ iscsi_portal }}:{{ iscsi_port }}
  become: true
  register: _discovery
  changed_when: false

- name: Configure CHAP — auth method
  ansible.builtin.command: >
    iscsiadm -m node -T {{ iscsi_target_iqn }}
    --op update -n node.session.auth.authmethod -v CHAP
  become: true
  changed_when: true

- name: Configure CHAP — username
  ansible.builtin.command: >
    iscsiadm -m node -T {{ iscsi_target_iqn }}
    --op update -n node.session.auth.username -v {{ iscsi_chap_user }}
  become: true
  changed_when: true
  no_log: true

- name: Configure CHAP — password
  ansible.builtin.command: >
    iscsiadm -m node -T {{ iscsi_target_iqn }}
    --op update -n node.session.auth.password -v {{ iscsi_chap_password }}
  become: true
  changed_when: true
  no_log: true

- name: Login to iSCSI target
  ansible.builtin.command: >
    iscsiadm -m node -T {{ iscsi_target_iqn }} --login
  become: true
  register: _login
  changed_when: _login.rc == 0
  failed_when:
    - _login.rc != 0
    - "'already exists' not in (_login.stderr | default(''))"
    - "'already present' not in (_login.stderr | default(''))"

- name: Wait for block device to appear
  ansible.builtin.shell: |
    for i in $(seq 1 30); do
      RAW=$(lsblk -d -n -o NAME,TRAN | awk '$2=="iscsi"{print $1}' | head -1)
      if [ -n "$RAW" ]; then
        # Prefer the multipath holder if multipathd has claimed the device.
        # Resolve the DM alias from sysfs (e.g. dm-1 → /dev/mapper/mpatha).
        HOLDER=$(ls /sys/block/${RAW}/holders/ 2>/dev/null | head -1)
        if [ -n "$HOLDER" ]; then
          DM_NAME=$(cat /sys/block/${HOLDER}/dm/name 2>/dev/null)
          if [ -n "$DM_NAME" ]; then
            echo "/dev/mapper/${DM_NAME}" && exit 0
          fi
        fi
        echo "/dev/${RAW}" && exit 0
      fi
      sleep 1
    done
    exit 1
  register: _iscsi_dev
  changed_when: false
  become: true

- name: Check if filesystem exists on device
  ansible.builtin.command: blkid {{ _iscsi_dev.stdout | trim }}
  register: _blkid
  changed_when: false
  failed_when: false
  become: true

- name: Format device with ext4 (first run only)
  ansible.builtin.command: mkfs.ext4 {{ _iscsi_dev.stdout | trim }}
  become: true
  when: _blkid.rc != 0
  register: _mkfs
  changed_when: _mkfs.rc == 0

- name: Create mount point
  ansible.builtin.file:
    path: "{{ iscsi_mount_path }}"
    state: directory
    mode: "0755"
  become: true

- name: Mount device
  ansible.posix.mount:
    path: "{{ iscsi_mount_path }}"
    src: "{{ _iscsi_dev.stdout | trim }}"
    fstype: "{{ iscsi_filesystem }}"
    opts: _netdev
    state: mounted
  become: true
</file>

<file path="roles/iscsi/tasks/linux_initiator_only.yml">
# roles/iscsi/tasks/linux_initiator_only.yml
---
# Sets up iSCSI initiator and logs into the target but does NOT
# format or mount the block device. Intended for compute-hub nodes
# where Longhorn manages the block device as additional disk capacity.

- name: Set deterministic iSCSI initiator name
  ansible.builtin.copy:
    content: "InitiatorName=iqn.2004-04.net.olympus:{{ ansible_facts['hostname'] }}\n"
    dest: /etc/iscsi/initiatorname.iscsi
    mode: "0600"
  become: true
  notify: Restart iscsid

- name: Install open-iscsi
  ansible.builtin.apt:
    name: open-iscsi
    state: present
    update_cache: true
  become: true

- name: Enable and start iscsid
  ansible.builtin.systemd:
    name: iscsid
    enabled: true
    state: started
  become: true

- name: Discover iSCSI targets
  ansible.builtin.command: >
    iscsiadm -m discovery -t sendtargets
    -p {{ iscsi_portal }}:{{ iscsi_port }}
  become: true
  changed_when: false

- name: Configure CHAP — auth method
  ansible.builtin.command: >
    iscsiadm -m node -T {{ iscsi_target_iqn }}
    --op update -n node.session.auth.authmethod -v CHAP
  become: true
  changed_when: true

- name: Configure CHAP — username
  ansible.builtin.command: >
    iscsiadm -m node -T {{ iscsi_target_iqn }}
    --op update -n node.session.auth.username -v {{ iscsi_chap_user }}
  become: true
  changed_when: true
  no_log: true

- name: Configure CHAP — password
  ansible.builtin.command: >
    iscsiadm -m node -T {{ iscsi_target_iqn }}
    --op update -n node.session.auth.password -v {{ iscsi_chap_password }}
  become: true
  changed_when: true
  no_log: true

- name: Login to iSCSI target
  ansible.builtin.command: >
    iscsiadm -m node -T {{ iscsi_target_iqn }} --login
  become: true
  register: _login
  changed_when: _login.rc == 0
  failed_when:
    - _login.rc != 0
    - "'already exists' not in (_login.stderr | default(''))"

- name: Enable automatic login at boot
  ansible.builtin.command: >
    iscsiadm -m node -T {{ iscsi_target_iqn }}
    --op update -n node.startup -v automatic
  become: true
  changed_when: true

- name: Confirm block device is visible (informational)
  ansible.builtin.shell: |
    lsblk -d -n -o NAME,TRAN | grep iscsi | awk '{print "/dev/" $1}'
  register: _iscsi_dev
  changed_when: false
  become: true

- name: Show iSCSI block device (for Longhorn configuration)
  ansible.builtin.debug:
    msg: "iSCSI block device available at: {{ _iscsi_dev.stdout | trim }} — add this path to Longhorn disk configuration"
</file>

<file path="roles/iscsi/tasks/macos.yml">
---
# macOS: no native iSCSI initiator. Uses NFSv4 mount from QNAP instead.
# Requires NFS share to be exported to 192.168.253.0/27 on the NAS.

- name: Resolve NFS export path
  ansible.builtin.set_fact:
    _nfs_export: "{{ iscsi_nfs_export if iscsi_nfs_export != '' else '/' + iscsi_mount_path.split('/')[-1] }}"

- name: Check if NFS already mounted
  ansible.builtin.shell: mount | grep -q "{{ iscsi_mount_path }}"
  register: _already_mounted
  changed_when: false
  failed_when: false

- name: Create mount point (only if not already mounted)
  ansible.builtin.file:
    path: "{{ iscsi_mount_path }}"
    state: directory
    mode: "0755"
  become: true
  when: _already_mounted.rc != 0

- name: Mount NFS share (NFSv4, macOS 26+)
  ansible.builtin.command: >
    mount -t nfs -o nfsvers=4,resvport
    {{ iscsi_portal }}:{{ _nfs_export }}
    {{ iscsi_mount_path }}
  become: true
  register: _mount
  changed_when: _mount.rc == 0
  failed_when:
    - _mount.rc != 0
    - "'already mounted' not in (_mount.stderr | default(''))"
    - "'already mounted' not in (_mount.stdout | default(''))"
  when: _already_mounted.rc != 0

- name: Install LaunchDaemon for NFS mount at boot
  ansible.builtin.template:
    src: macos_launchdaemon.plist.j2
    dest: "/Library/LaunchDaemons/com.olympus.nfs.{{ iscsi_mount_path | replace('/', '_') }}.plist"
    mode: "0644"
    owner: root
    group: wheel
  become: true
  register: _plist

- name: Load LaunchDaemon
  ansible.builtin.command: >
    launchctl load
    /Library/LaunchDaemons/com.olympus.nfs.{{ iscsi_mount_path | replace('/', '_') }}.plist
  become: true
  when: _plist.changed
</file>

