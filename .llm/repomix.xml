<file path="roles/data-services/tasks/macos-dirs.yml">
---
- name: Create /opt/olympus directory tree
  vars:
    olympus_dirs:
      - {path: "{{ data_services_nvme_root }}/data/postgres", owner: _postgres}
      - {path: "{{ data_services_nvme_root }}/data/redis", owner: _redis}
      - {path: "{{ data_services_nvme_root }}/data/clickhouse", owner: _clickhouse}
      - {path: "{{ data_services_nvme_root }}/data/redpanda", owner: _redpanda}
      - {path: "{{ data_services_nvme_root }}/data/ollama", owner: _ollama}
      - {path: "{{ data_services_nvme_root }}/config/postgres", owner: _postgres}
      - {path: "{{ data_services_nvme_root }}/config/redis", owner: _redis}
      - {path: "{{ data_services_nvme_root }}/config/clickhouse", owner: _clickhouse}
      - {path: "{{ data_services_nvme_root }}/config/redpanda", owner: _redpanda}
      - {path: "{{ data_services_nvme_root }}/logs/postgres", owner: _postgres}
      - {path: "{{ data_services_nvme_root }}/logs/redis", owner: _redis}
      - {path: "{{ data_services_nvme_root }}/logs/clickhouse", owner: _clickhouse}
      - {path: "{{ data_services_nvme_root }}/logs/redpanda", owner: _redpanda}
      - {path: "{{ data_services_nvme_root }}/logs/ollama", owner: _ollama}
  ansible.builtin.file:
    path: "{{ item.path }}"
    state: directory
    owner: "{{ item.owner }}"
    group: staff
    mode: "0750"
  become: true
  loop: "{{ olympus_dirs }}"
  loop_control:
    label: "{{ item.path }}"

- name: Ensure NFS WAL archive directory exists
  # NFS root_squash prevents chown; directory is world-writable so _postgres can write.
  # ignore_errors handles the chown failure gracefully on subsequent runs.
  ansible.builtin.file:
    path: "{{ data_services_nfs_archive }}/wal-archive"
    state: directory
    mode: "0777"
  become: true
  ignore_errors: true
</file>

<file path="roles/data-services/tasks/macos-ollama.yml">
