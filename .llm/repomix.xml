<file path="roles/ddclient/defaults/main.yml">
---
ddclient_state: present
ddclient_zone: "nwlnexus.net"
ddclient_subdomain: "edge"          # public record: <hostname>.<subdomain>.<zone>
ddclient_ttl: 120
ddclient_daemon_interval: 300
# 1Password reference for Cloudflare DNS-only API token (for pull-mode via op read)
ddclient_cf_token_op_ref: "op://Dev/dns-only-cf-token/credential"
# Cloudflare API token override (for push-mode via vault; takes precedence over op_ref)
ddclient_cf_api_token: ""
# Optional extra FQDNs that also point to this host's internal IP.
# e.g. role-based names like management-hub.nwlnexus.net alongside naraka-01.nwlnexus.net
ddclient_extra_fqdns: []
# Extra internal FQDNs tracked using the host's primary interface IP.
# Zone is inferred automatically from the FQDN (last two labels), so
# media-int.nwlnexus.io lands in the nwlnexus.io zone regardless of
# ddclient_zone. No cross-zone configuration needed.
# Extra public A records in potentially different zones.
# Each entry: { fqdn: "media.nwlnexus.io", zone: "nwlnexus.io" }
# Seeded via Cloudflare API; tracked by ddclient daemon.
ddclient_extra_public_records: []
</file>

<file path="roles/ddclient/handlers/main.yml">
---
- name: Restart ddclient (Linux)
  ansible.builtin.systemd:
    name: ddclient
    state: restarted
  become: true
  when: ansible_facts['os_family'] != 'Darwin'
  listen: restart ddclient

- name: Restart ddclient (macOS)
  ansible.builtin.command: brew services restart ddclient
  become: true
  environment:
    HOMEBREW_NO_AUTO_UPDATE: "1"
    HOMEBREW_NO_ANALYTICS: "1"
  changed_when: true
  when: ansible_facts['os_family'] == 'Darwin'
  listen: restart ddclient
</file>

<file path="roles/ddclient/tasks/main.yml">
---
- name: Set ddclient state
  ansible.builtin.set_fact:
    _ddclient_state: "{{ ddclient_state | default('present') }}"

- name: Set platform-specific config path
  ansible.builtin.set_fact:
    _ddclient_conf_path: "{{ '/opt/homebrew/etc/ddclient.conf' if ansible_facts['os_family'] == 'Darwin' else '/etc/ddclient.conf' }}"

# --- ABSENT ---
- name: Remove ddclient (Linux)
  ansible.builtin.apt:
    name: ddclient
    state: absent
    purge: true
  become: true
  when:
    - _ddclient_state == 'absent'
    - ansible_facts['os_family'] != 'Darwin'

- name: Remove ddclient (macOS)
  community.general.homebrew:
    name: ddclient
    state: absent
  when:
    - _ddclient_state == 'absent'
    - ansible_facts['os_family'] == 'Darwin'

- name: Remove ddclient config
  ansible.builtin.file:
    path: "{{ _ddclient_conf_path }}"
    state: absent
  become: "{{ ansible_facts['os_family'] != 'Darwin' }}"
  when: _ddclient_state == 'absent'

# --- PRESENT ---

# Resolve CF token: vault var takes precedence over op read (for push-mode compat)
- name: Use vault-provided Cloudflare token
  ansible.builtin.set_fact:
    _ddclient_cf_token: "{{ ddclient_cf_api_token }}"
  no_log: true
  when:
    - _ddclient_state == 'present'
    - ddclient_cf_api_token != ""

- name: Read Cloudflare token from 1Password (pull-mode)
  ansible.builtin.shell: |
    set -o pipefail
    OP_SERVICE_ACCOUNT_TOKEN=$(cat /etc/olympus/op-service-account-token 2>/dev/null || echo "")
    if [ -n "$OP_SERVICE_ACCOUNT_TOKEN" ]; then
      export OP_SERVICE_ACCOUNT_TOKEN
      op read "{{ ddclient_cf_token_op_ref }}"
    else
      echo ""
    fi
  args:
    executable: /bin/bash
  register: _op_token_read
  no_log: true
  changed_when: false
  failed_when: false
  when:
    - _ddclient_state == 'present'
    - ddclient_cf_api_token == ""

- name: Set token fact from 1Password read
  ansible.builtin.set_fact:
    _ddclient_cf_token: "{{ _op_token_read.stdout | trim }}"
  no_log: true
  when:
    - _ddclient_state == 'present'
    - ddclient_cf_api_token == ""
    - _op_token_read.stdout | default('') | trim != ''

- name: Skip ddclient setup — no Cloudflare token available
  ansible.builtin.debug:
    msg: "ddclient skipped: no CF token (set ddclient_cf_api_token or configure op service account)"
  when:
    - _ddclient_state == 'present'
    - _ddclient_cf_token | default('') == ''

- name: End play for this host if no token
  ansible.builtin.meta: end_host
  when:
    - _ddclient_state == 'present'
    - _ddclient_cf_token | default('') == ''

- name: Gather network facts
  ansible.builtin.setup:
    gather_subset: [network]
  when: _ddclient_state == 'present'

- name: Install ddclient (Linux)
  ansible.builtin.apt:
    name: ddclient
    state: present
    update_cache: true
  become: true
  when:
    - _ddclient_state == 'present'
    - ansible_facts['os_family'] != 'Darwin'

- name: Install ddclient (macOS)
  community.general.homebrew:
    name: ddclient
    state: present
  when:
    - _ddclient_state == 'present'
    - ansible_facts['os_family'] == 'Darwin'

# Look up zone ID once for all record operations
- name: Look up Cloudflare zone ID
  ansible.builtin.uri:
    url: "https://api.cloudflare.com/client/v4/zones?name={{ ddclient_zone }}"
    method: GET
    headers:
      Authorization: "Bearer {{ _ddclient_cf_token }}"
    status_code: 200
  register: _ddclient_zone_resp
  no_log: true
  when: _ddclient_state == 'present'

- name: Set zone ID fact
  ansible.builtin.set_fact:
    _ddclient_zone_id: "{{ _ddclient_zone_resp.json.result[0].id }}"
  when:
    - _ddclient_state == 'present'
    - (_ddclient_zone_resp.json.result | default([]) | length) > 0

# Compute the unique zones required by ddclient_extra_fqdns (inferred from
# the FQDN itself — last two labels). Zones already covered by ddclient_zone
# share the existing zone ID; only additional zones need a separate lookup.
- name: Compute extra FQDN zones
  ansible.builtin.set_fact:
    _ddclient_extra_fqdn_zones: >-
      {{ ddclient_extra_fqdns |
         map('regex_replace', '^.*?([^.]+\.[^.]+)$', '\1') |
         unique | reject('equalto', ddclient_zone) | list }}
  when: _ddclient_state == 'present'

- name: Look up zone IDs for extra FQDN zones
  ansible.builtin.uri:
    url: "https://api.cloudflare.com/client/v4/zones?name={{ item }}"
    method: GET
    headers:
      Authorization: "Bearer {{ _ddclient_cf_token }}"
    status_code: 200
  register: _ddclient_extra_fqdn_zone_resps
  no_log: true
  loop: "{{ _ddclient_extra_fqdn_zones }}"
  when:
    - _ddclient_state == 'present'
    - _ddclient_extra_fqdn_zones | length > 0

# Zone ID map: { zone_name: zone_id }. Starts with the hostname zone then
# merges in any additional zones required by extra_fqdns.
- name: Initialise zone ID map with hostname zone
  ansible.builtin.set_fact:
    _ddclient_zone_id_map: "{{ {ddclient_zone: _ddclient_zone_id} }}"
  when: _ddclient_state == 'present'

- name: Add extra FQDN zone IDs to map
  ansible.builtin.set_fact:
    _ddclient_zone_id_map: >-
      {{ _ddclient_zone_id_map | combine({
           item.item: (item.json.result | default([{}]) | first).id | default('')
         }) }}
  loop: "{{ _ddclient_extra_fqdn_zone_resps.results | default([]) }}"
  no_log: true
  when:
    - _ddclient_state == 'present'
    - _ddclient_extra_fqdn_zones | length > 0

# Build the list of internal FQDNs in ddclient_zone for the conf template.
- name: Build internal FQDN list for hostname zone
  ansible.builtin.set_fact:
    _ddclient_internal_fqdns: >-
      {{ [ansible_facts['hostname'] + '.' + ddclient_zone] +
         (ddclient_extra_fqdns |
          select('match', '.*\\.' + ddclient_zone + '$') | list) }}
  when: _ddclient_state == 'present'

# --- Seed A records (idempotent: create if absent, skip if present) ---

- name: Check existing public A record
  ansible.builtin.uri:
    url: >-
      https://api.cloudflare.com/client/v4/zones/{{ _ddclient_zone_id
      }}/dns_records?type=A&name={{ ansible_facts['hostname']
      }}.{{ ddclient_subdomain }}.{{ ddclient_zone }}
    method: GET
    headers:
      Authorization: "Bearer {{ _ddclient_cf_token }}"
    status_code: 200
  register: _ddclient_public_check
  no_log: true
  when: _ddclient_state == 'present'

- name: Create public A record
  ansible.builtin.uri:
    url: "https://api.cloudflare.com/client/v4/zones/{{ _ddclient_zone_id }}/dns_records"
    method: POST
    headers:
      Authorization: "Bearer {{ _ddclient_cf_token }}"
      Content-Type: "application/json"
    body_format: json
    body:
      type: A
      name: "{{ ansible_facts['hostname'] }}.{{ ddclient_subdomain }}.{{ ddclient_zone }}"
      content: "{{ ansible_facts['default_ipv4']['address'] }}"
      ttl: "{{ ddclient_ttl }}"
      proxied: false
    status_code: 200
  no_log: true
  when:
    - _ddclient_state == 'present'
    - (_ddclient_public_check.json.result | default([]) | length) == 0

- name: Check existing hostname-zone internal A records
  ansible.builtin.uri:
    url: >-
      https://api.cloudflare.com/client/v4/zones/{{ _ddclient_zone_id }}/dns_records?type=A&name={{ item }}
    method: GET
    headers:
      Authorization: "Bearer {{ _ddclient_cf_token }}"
    status_code: 200
  register: _ddclient_internal_checks
  no_log: true
  loop: "{{ _ddclient_internal_fqdns }}"
  when: _ddclient_state == 'present'

- name: Create missing hostname-zone internal A records
  ansible.builtin.uri:
    url: "https://api.cloudflare.com/client/v4/zones/{{ _ddclient_zone_id }}/dns_records"
    method: POST
    headers:
      Authorization: "Bearer {{ _ddclient_cf_token }}"
      Content-Type: "application/json"
    body_format: json
    body:
      type: A
      name: "{{ item.item }}"
      content: "{{ ansible_facts['default_ipv4']['address'] }}"
      ttl: "{{ ddclient_ttl }}"
      proxied: false
    status_code: 200
  no_log: true
  loop: "{{ _ddclient_internal_checks.results | default([]) }}"
  when:
    - _ddclient_state == 'present'
    - (item.json.result | default([]) | length) == 0

# Seed extra FQDNs that live in zones OTHER than ddclient_zone.
- name: Check existing cross-zone extra FQDN A records
  ansible.builtin.uri:
    url: >-
      https://api.cloudflare.com/client/v4/zones/{{
        _ddclient_zone_id_map[item | regex_replace('^.*?([^.]+\.[^.]+)$', '\1')] | default('')
      }}/dns_records?type=A&name={{ item }}
    method: GET
    headers:
      Authorization: "Bearer {{ _ddclient_cf_token }}"
    status_code: 200
  register: _ddclient_cross_zone_checks
  no_log: true
  loop: >-
    {{ ddclient_extra_fqdns |
       reject('match', '.*\.' + ddclient_zone + '$') | list }}
  when:
    - _ddclient_state == 'present'
    - _ddclient_extra_fqdn_zones | length > 0

- name: Create missing cross-zone extra FQDN A records
  ansible.builtin.uri:
    url: >-
      https://api.cloudflare.com/client/v4/zones/{{
        _ddclient_zone_id_map[item.item | regex_replace('^.*?([^.]+\.[^.]+)$', '\1')] | default('')
      }}/dns_records
    method: POST
    headers:
      Authorization: "Bearer {{ _ddclient_cf_token }}"
      Content-Type: "application/json"
    body_format: json
    body:
      type: A
      name: "{{ item.item }}"
      content: "{{ ansible_facts['default_ipv4']['address'] }}"
      ttl: "{{ ddclient_ttl }}"
      proxied: false
    status_code: 200
  no_log: true
  loop: "{{ _ddclient_cross_zone_checks.results | default([]) }}"
  when:
    - _ddclient_state == 'present'
    - _ddclient_extra_fqdn_zones | length > 0
    - (item.json.result | default([]) | length) == 0

# --- Extra public records (cross-zone) ---

- name: Look up Cloudflare zone IDs for extra public records
  ansible.builtin.uri:
    url: "https://api.cloudflare.com/client/v4/zones?name={{ item }}"
    method: GET
    headers:
      Authorization: "Bearer {{ _ddclient_cf_token }}"
    status_code: 200
  register: _ddclient_extra_zone_resps
  no_log: true
  loop: "{{ ddclient_extra_public_records | map(attribute='zone') | unique | list }}"
  when:
    - _ddclient_state == 'present'
    - ddclient_extra_public_records | length > 0

- name: Check existing extra public A records
  ansible.builtin.uri:
    url: "https://api.cloudflare.com/client/v4/zones/{{ _extra_zone_id }}/dns_records?type=A&name={{ item.fqdn }}"
    method: GET
    headers:
      Authorization: "Bearer {{ _ddclient_cf_token }}"
    status_code: 200
  vars:
    _extra_zone_id: >-
      {{ ((_ddclient_extra_zone_resps.results
           | selectattr('item', 'equalto', item.zone)
           | list | first).json.result | default([]) | first | default({})).id | default('') }}
  register: _ddclient_extra_checks
  no_log: true
  loop: "{{ ddclient_extra_public_records }}"
  when:
    - _ddclient_state == 'present'
    - ddclient_extra_public_records | length > 0

- name: Create missing extra public A records
  ansible.builtin.uri:
    url: "https://api.cloudflare.com/client/v4/zones/{{ _extra_zone_id }}/dns_records"
    method: POST
    headers:
      Authorization: "Bearer {{ _ddclient_cf_token }}"
      Content-Type: "application/json"
    body_format: json
    body:
      type: A
      name: "{{ item.item.fqdn }}"
      content: "{{ ansible_facts['default_ipv4']['address'] }}"
      ttl: "{{ ddclient_ttl }}"
      proxied: false
    status_code: 200
  vars:
    _extra_zone_id: >-
      {{ ((_ddclient_extra_zone_resps.results
           | selectattr('item', 'equalto', item.item.zone)
           | list | first).json.result | default([]) | first | default({})).id | default('') }}
  no_log: true
  loop: "{{ _ddclient_extra_checks.results | default([]) }}"
  when:
    - _ddclient_state == 'present'
    - ddclient_extra_public_records | length > 0
    - (item.json.result | default([]) | length) == 0

# --- ddclient config ---

- name: Render ddclient.conf (Linux)
  ansible.builtin.template:
    src: ddclient.conf.j2
    dest: "{{ _ddclient_conf_path }}"
    owner: root
    group: root
    mode: '0600'
  become: true
  notify: restart ddclient
  when:
    - _ddclient_state == 'present'
    - ansible_facts['os_family'] != 'Darwin'

- name: Render ddclient.conf (macOS)
  ansible.builtin.template:
    src: ddclient.conf.j2
    dest: "{{ _ddclient_conf_path }}"
    owner: "{{ ansible_facts['user_id'] }}"
    group: "{{ ansible_facts['user_gid'] }}"
    mode: '0600'
  notify: restart ddclient
  when:
    - _ddclient_state == 'present'
    - ansible_facts['os_family'] == 'Darwin'

- name: Enable and start ddclient (Linux)
  ansible.builtin.systemd:
    name: ddclient
    enabled: true
    state: started
  become: true
  when:
    - _ddclient_state == 'present'
    - ansible_facts['os_family'] != 'Darwin'

- name: Check ddclient service status (macOS)
  ansible.builtin.shell: brew services list | grep "^ddclient" || true
  register: _ddclient_svc_status
  changed_when: false
  failed_when: false
  when:
    - _ddclient_state == 'present'
    - ansible_facts['os_family'] == 'Darwin'

- name: Enable and start ddclient (macOS)
  ansible.builtin.shell: |
    sudo -n /opt/homebrew/bin/brew services start ddclient
  environment:
    HOMEBREW_NO_AUTO_UPDATE: "1"
    HOMEBREW_NO_ANALYTICS: "1"
  register: _ddclient_brew_start
  changed_when: "'Successfully started' in _ddclient_brew_start.stdout or 'started' in _ddclient_brew_start.stdout"
  failed_when: false
  when:
    - _ddclient_state == 'present'
    - ansible_facts['os_family'] == 'Darwin'
    - "'started' not in (_ddclient_svc_status.stdout | default(''))"
</file>

<file path="roles/ddclient/templates/ddclient.conf.j2">
# ddclient configuration — managed by Ansible, do not edit manually
#
# Hostname records ({{ ddclient_zone }}):
#   {{ ansible_facts['hostname'] }}.{{ ddclient_subdomain }}.{{ ddclient_zone }}  -> public IP (ipify)
#   {{ ansible_facts['hostname'] }}.{{ ddclient_zone }}                            -> internal IP
{% for fqdn in ddclient_extra_fqdns %}
{% if fqdn | regex_replace('^.*?([^.]+\.[^.]+)$', '\1') == ddclient_zone %}
#   {{ fqdn }}                                                            -> internal IP
{% endif %}
{% endfor %}
{% set _extra_zones = ddclient_extra_fqdns | map('regex_replace', '^.*?([^.]+\.[^.]+)$', '\1') | unique | reject('equalto', ddclient_zone) | list %}
{% for zone in _extra_zones %}
#
# Extra records ({{ zone }}):
{% for fqdn in ddclient_extra_fqdns %}
{% if fqdn | regex_replace('^.*?([^.]+\.[^.]+)$', '\1') == zone %}
#   {{ fqdn }}                                                            -> internal IP
{% endif %}
{% endfor %}
{% endfor %}

daemon={{ ddclient_daemon_interval }}
ssl=yes
verbose=no
quiet=no

# --- Hostname zone: {{ ddclient_zone }} ---
protocol=cloudflare
zone={{ ddclient_zone }}
ttl={{ ddclient_ttl }}
login=token
password='{{ _ddclient_cf_token }}'

# Public IP record — detected via external web service
use=web, web=https://api.ipify.org/
{{ ansible_facts['hostname'] }}.{{ ddclient_subdomain }}.{{ ddclient_zone }}

# Internal IP records — detected from primary network interface
use=if, if={{ ansible_facts['default_ipv4']['interface'] }}
{{ ansible_facts['hostname'] }}.{{ ddclient_zone }}
{% for fqdn in ddclient_extra_fqdns %}
{% if fqdn | regex_replace('^.*?([^.]+\.[^.]+)$', '\1') == ddclient_zone %}
{{ fqdn }}
{% endif %}
{% endfor %}

{% for zone in _extra_zones %}
# --- Extra zone: {{ zone }} ---
protocol=cloudflare
zone={{ zone }}
ttl={{ ddclient_ttl }}
login=token
password='{{ _ddclient_cf_token }}'

use=if, if={{ ansible_facts['default_ipv4']['interface'] }}
{% for fqdn in ddclient_extra_fqdns %}
{% if fqdn | regex_replace('^.*?([^.]+\.[^.]+)$', '\1') == zone %}
{{ fqdn }}
{% endif %}
{% endfor %}

{% endfor %}
{% for zone_group in ddclient_extra_public_records | default([]) | groupby('zone') %}
# Extra public records — zone {{ zone_group.0 }}
protocol=cloudflare
zone={{ zone_group.0 }}
ttl={{ ddclient_ttl }}
login=token
password='{{ _ddclient_cf_token }}'
use=web, web=https://api.ipify.org/
{% for record in zone_group.1 %}
{{ record.fqdn }}
{% endfor %}

{% endfor %}
</file>

