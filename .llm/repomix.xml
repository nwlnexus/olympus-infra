    service_users:
      - {name: _postgres, uid: "{{ data_services_postgres_uid }}", comment: "PostgreSQL Data Service"}
      - {name: _redis, uid: "{{ data_services_redis_uid }}", comment: "Redis Data Service"}
      - {name: _clickhouse, uid: "{{ data_services_clickhouse_uid }}", comment: "ClickHouse Data Service"}
      - {name: _redpanda, uid: "{{ data_services_redpanda_uid }}", comment: "Redpanda Data Service"}
      - {name: _ollama, uid: "{{ data_services_ollama_uid }}", comment: "Ollama AI Service"}
  block:
    - name: "Create system user {{ item.name }}"
      ansible.builtin.command:
        cmd: dscl . -create /Users/{{ item.name }}
      become: true
      ignore_errors: true
      changed_when: false
      loop: "{{ service_users }}"
      loop_control:
        label: "{{ item.name }}"

    - name: "Set UID for {{ item.name }}"
      ansible.builtin.command:
        cmd: dscl . -create /Users/{{ item.name }} UniqueID {{ item.uid }}
      become: true
      ignore_errors: true
      changed_when: false
      loop: "{{ service_users }}"
      loop_control:
        label: "{{ item.name }}"

    - name: "Set GID (staff=20) for {{ item.name }}"
      ansible.builtin.command:
        cmd: dscl . -create /Users/{{ item.name }} PrimaryGroupID 20
      become: true
      ignore_errors: true
      changed_when: false
      loop: "{{ service_users }}"
      loop_control:
        label: "{{ item.name }}"

    - name: "Set shell to /usr/bin/false for {{ item.name }}"
      ansible.builtin.command:
        cmd: dscl . -create /Users/{{ item.name }} UserShell /usr/bin/false
      become: true
      ignore_errors: true
      changed_when: false
      loop: "{{ service_users }}"
      loop_control:
        label: "{{ item.name }}"

    - name: "Set comment for {{ item.name }}"
      ansible.builtin.command:
        cmd: dscl . -create /Users/{{ item.name }} RealName "{{ item.comment }}"
      become: true
      ignore_errors: true
      changed_when: false
      loop: "{{ service_users }}"
      loop_control:
        label: "{{ item.name }}"

    - name: "Set home to /var/empty for {{ item.name }}"
      ansible.builtin.command:
        cmd: dscl . -create /Users/{{ item.name }} NFSHomeDirectory /var/empty
      become: true
      ignore_errors: true
      changed_when: false
      loop: "{{ service_users }}"
      loop_control:
        label: "{{ item.name }}"
</file>

