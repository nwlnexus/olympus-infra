<file path="playbooks/pull/management-hub.yml">
---
# Pull-mode playbook for management-hub.
# Runs daily at 02:00 via crontab as the `ansible` user.
# Re-applies idempotent Ansible-managed foundation roles to correct drift.
#
# NOTE: cert-manager, external-secrets, traefik-config, external-dns, and
# cloudflared Deployment are managed by Flux (GitOps). Do NOT add them here.
# (argocd role removed — replaced by Flux at the platform level.)

- name: Management Hub — Drift Correction
  hosts: management-hub
  gather_facts: true

  pre_tasks:
    - name: Fetch olympus inventory from Hermes
      ansible.builtin.import_tasks: "{{ playbook_dir }}/../../roles/baseline/tasks/olympus-inventory.yml"
      tags: [always, olympus-inventory]

  roles:
    - role: baseline
      tags: [baseline]

    - role: iscsi
      tags: [iscsi]
      when: iscsi_state is defined

    - role: atlas
      tags: [atlas]
      when: atlas_state is defined

    - role: ddclient
      tags: [ddclient]
      when: ddclient_state is defined

    - role: 1password-connect
      tags: [1password-connect]

    # ── Hermes ENC (must be LAST — appends roles, never displaces) ───────────
    - role: hermes-classify-include
      tags: [hermes-classify]
</file>

<file path="playbooks/pull/olympus.yml">
---
# Unified pull playbook — all nodes, all platforms.
# Roles self-manage OS/arch differences internally.
# Opt-in roles fire when the controlling _state var is defined in host/group vars.
# Hermes dynamic inventory will set/unset _state vars per node without playbook changes.
#
# Intentionally excluded:
#   k3s         — cluster restarts require coordinated push with human oversight
#   bootstrap-user — service-user mutation is push-only
#
# Run by the ansible service user via:
#   Linux:  systemd timer → /opt/ansible-pull/ansible-pull-run
#   macOS:  LaunchDaemon → /opt/ansible-pull/ansible-pull-run

- name: Olympus Pull
  hosts: all
  gather_facts: true

  pre_tasks:
    - name: Assert OP service account token is readable
      ansible.builtin.stat:
        path: /etc/olympus/op-service-account-token
      register: _op_token_stat
      failed_when: not _op_token_stat.stat.exists
      tags: [always]

    - name: Assert Hermes token present or explicitly disabled
      ansible.builtin.stat:
        path: "{{ item }}"
      register: _hermes_stat
      loop:
        - /etc/olympus/hermes-token
        - /etc/olympus/hermes-disabled
      tags: [always]

    - name: Fail if neither Hermes token nor disabled flag is present
      ansible.builtin.fail:
        msg: "Neither /etc/olympus/hermes-token nor /etc/olympus/hermes-disabled exists. Place one before pull runs."
      when: not (_hermes_stat.results[0].stat.exists or _hermes_stat.results[1].stat.exists)
      tags: [always]

  roles:
    # ── Always run — roles handle OS/arch internally ──────────────────────────
    - role: common
      tags: [common]
      when: ansible_facts['os_family'] != 'Darwin'

    - role: baseline
      tags: [baseline]

    - role: ansible-pull
      tags: [ansible-pull]

    # ── Opt-in via _state vars set in host/group vars ─────────────────────────
    - role: iscsi
      tags: [iscsi]
      when: iscsi_state is defined

    - role: atlas
      tags: [atlas]
      when: atlas_state is defined

    - role: 1password-connect
      tags: [1password-connect]
      when:
        - onepassword_connect_state is defined
        - k3s_primary | default(true)

    - role: eso-bootstrap
      tags: [eso-bootstrap]
      when:
        - eso_bootstrap_state is defined
        - k3s_primary | default(true)

    # QNAP CSI (Trident) — cluster-wide storage provisioner. Install once per
    # cluster on the primary. Idempotent (sentinel /opt/qnap-csi-plugin/.installed).
    - role: qnap-csi-bootstrap
      tags: [qnap-csi-bootstrap]
      when:
        - qnap_csi_state is defined
        - k3s_primary | default(false)

    - role: tailscale
      tags: [tailscale]
      when: tailscale_state is defined

    - role: colima
      tags: [colima]
      when: colima_state is defined

    - role: cloudflared
      tags: [cloudflared]
      when: cloudflared_state is defined

    - role: cloudflared-k8s
      tags: [cloudflared-k8s]
      when: >
        cloudflared_k8s_state is defined and
        k3s_primary | default(false)

    - role: ollama
      tags: [ollama]
      when: ollama_state is defined

    # ddclient last in opt-in block: role uses meta:end_host when CF token unavailable;
    # placing it last ensures ansible-pull and other critical roles always complete.
    - role: ddclient
      tags: [ddclient]

    # ── Always last — Hermes-injected dynamic roles ───────────────────────────
    - role: hermes-classify-include
      tags: [hermes-classify]
</file>

<file path="playbooks/pull/styx.yml">
