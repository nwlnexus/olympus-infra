<file path="roles/pxe/templates/pi/config.txt.j2">
# Raspberry Pi 4 / CM4 network boot config
# Generated by Ansible pxe role — do not edit manually
#
# Boot flow:
#   Pi EEPROM → TFTP (this config.txt) → loads netboot.xyz-arm64.efi as kernel
#   → iPXE starts → re-DHCPs with option 175 → dnsmasq serves our custom menu
#   → Ubuntu 24.04 arm64 autoinstall
#
# Requires Pi 4 EEPROM 2020-09-03 or later.
# Enable network boot: raspi-config → Advanced → Boot Order → Network Boot

# 64-bit mode required for EFI application boot
arm_64bit=1

# netboot.xyz ARM64 EFI binary — bootstraps iPXE for the two-stage chainload flow
kernel=netboot.xyz-arm64.efi

# Enable UART serial console (headless debug)
enable_uart=1

# Disable rainbow splash on boot
disable_splash=1
</file>

<file path="roles/pxe/templates/dnsmasq-pxe.conf.j2">
# dnsmasq — PXE proxyDHCP for {{ pxe_dhcp_network }}
# Acts alongside UniFi DHCP; injects arch-aware PXE boot options only.
# Does NOT allocate IP addresses.
#
# Two-stage chainloading:
#   Stage 1 — native PXE client: serve netboot.xyz binary from TFTP by arch
#   Stage 2 — iPXE already running (option 175 set): serve our custom menu URL
#
# This means ALL arches (x86_64, arm64, Raspberry Pi) converge on the same
# custom iPXE menu once netboot.xyz bootstraps iPXE on the client.

port=0                          # Disable DNS (PXE proxy only)
log-dhcp

# ProxyDHCP: respond to PXE requests on this subnet without allocating IPs
dhcp-range={{ pxe_dhcp_network.split('/')[0] }},proxy

# Stage 2 detection: iPXE sends DHCP option 175 when already running
dhcp-match=set:ipxe,175

# Stage 1 arch detection via DHCP option 93 (client system architecture)
dhcp-match=set:bios,option:client-arch,0
dhcp-match=set:efi-x86_64,option:client-arch,7
dhcp-match=set:efi-x86_64,option:client-arch,9
dhcp-match=set:efi-arm64,option:client-arch,11

# Stage 2: iPXE is running — serve our custom menu (all arches)
dhcp-boot=tag:ipxe,http://{{ pxe_server_ip }}:{{ pxe_http_port }}/menu/boot.ipxe

# Stage 1: native PXE client — serve netboot.xyz binary by arch (tag:!ipxe = not yet iPXE)
dhcp-boot=tag:!ipxe,tag:bios,netboot.xyz-undionly.kpxe,,{{ pxe_server_ip }}
dhcp-boot=tag:!ipxe,tag:efi-x86_64,netboot.xyz.efi,,{{ pxe_server_ip }}
dhcp-boot=tag:!ipxe,tag:efi-arm64,netboot.xyz-arm64.efi,,{{ pxe_server_ip }}
</file>

<file path="roles/pxe/templates/ipxe-menu.ipxe.j2">
#!ipxe

# Detect CPU architecture for menu labelling
iseq ${buildarch} arm64 && set arch_label ARM64 || set arch_label AMD64

:start
menu Olympus Homelab — Network Boot (${arch_label})
item --gap         --- Ubuntu Autoinstall ---
item ubuntu-amd64  Ubuntu 24.04 LTS (noble) — autoinstall AMD64
item ubuntu-arm64  Ubuntu 24.04 LTS (noble) — autoinstall ARM64
item --gap         --- Utilities ---
item shell         iPXE shell
item reboot        Reboot
choose --timeout 30 --default ubuntu-amd64 target && goto ${target}

:ubuntu-amd64
set base http://{{ pxe_server_ip }}:{{ pxe_http_port }}
kernel ${base}/ubuntu/{{ pxe_ubuntu_codename }}/vmlinuz \
  initrd=initrd \
  autoinstall \
  ds=nocloud-net;seedfrom=${base}/cloud-init/${hostname}/ \
  ip=dhcp \
  quiet splash
initrd ${base}/ubuntu/{{ pxe_ubuntu_codename }}/initrd
boot

:ubuntu-arm64
set base http://{{ pxe_server_ip }}:{{ pxe_http_port }}
kernel ${base}/ubuntu/{{ pxe_ubuntu_codename }}-arm64/vmlinuz \
  initrd=initrd \
  autoinstall \
  ds=nocloud-net;seedfrom=${base}/cloud-init/${hostname}/ \
  ip=dhcp \
  quiet splash
initrd ${base}/ubuntu/{{ pxe_ubuntu_codename }}-arm64/initrd
boot

:shell
shell

:reboot
reboot
</file>

