<file path="roles/baseline/tasks/main.yml">
---
# Linux-only — macOS hosts get a separate baseline later.
- name: baseline — skip on non-Linux
  ansible.builtin.meta: end_host
  when: ansible_facts['os_family'] == "Darwin"

# Credential directory traverse — ansible user must be able to read files
# inside /etc/olympus (token files, etc.) without becoming root.
- name: Ensure ansible user can traverse /etc/olympus
  ansible.builtin.file:
    path: /etc/olympus
    state: directory
    owner: root
    group: ansible
    mode: '0750'
  become: true
  when: baseline_state == "present"
  tags: [baseline, baseline-credentials]

# op CLI next — SSH key fetch depends on it.
- name: baseline — install 1Password CLI
  ansible.builtin.include_tasks: op-cli.yml
  tags: [baseline, baseline-op-cli]

# Order matters: SSH first (avoid lockout when UFW comes up later),
# then hardening pieces, then UFW last (so any extra-ports config from
# later tasks/host_vars is already in place before deny-by-default).
- name: baseline — SSH hardening
  ansible.builtin.include_tasks: ssh.yml
  tags: [baseline, baseline-ssh]

- name: baseline — unattended upgrades
  ansible.builtin.include_tasks: unattended.yml
  tags: [baseline, baseline-unattended]

- name: baseline — fail2ban
  ansible.builtin.include_tasks: fail2ban.yml
  tags: [baseline, baseline-fail2ban]

- name: baseline — time sync
  ansible.builtin.include_tasks: timesync.yml
  tags: [baseline, baseline-timesync]

- name: baseline — logrotate for ansible-pull
  ansible.builtin.include_tasks: logrotate.yml
  tags: [baseline, baseline-logrotate]

- name: baseline — optional hostname enforcement
  ansible.builtin.include_tasks: hostname.yml
  tags: [baseline, baseline-hostname]

- name: baseline — firewall (UFW)
  ansible.builtin.include_tasks: firewall.yml
  tags: [baseline, baseline-firewall]
</file>

<file path="roles/baseline/tasks/olympus-inventory.yml">
---
# Fetch olympus inventory vars from Hermes via CF Access service token.
# Writes resolved vars to /etc/ansible/facts.d/olympus_inventory.json
# so they are available as ansible_local.olympus_inventory.* throughout the play.
#
# Safe fallback behaviour:
#   - Hermes reachable + host registered  → cache updated, vars available
#   - Hermes reachable + not registered   → empty vars (unassigned defaults apply)
#   - Hermes unreachable + cache exists   → stale cache used, no changes
#   - Hermes unreachable + no cache       → ansible_local.olympus_inventory undefined;
#                                           playbooks use `| default({})` guards

- name: Ensure facts.d directory exists
  ansible.builtin.file:
    path: /etc/ansible/facts.d
    state: directory
    owner: root
    group: ansible
    mode: '0755'
  become: true

# Slurp the OP service account token from the host (present in both push and pull mode).
# The token is then passed explicitly to the lookup plugin via service_account_token=
# so it works without interactive signin (community.general.onepassword >= 6.x).
- name: Read OP service account token for inventory lookup
  ansible.builtin.slurp:
    src: /etc/olympus/op-service-account-token
  register: _inv_op_token_file
  become: true
  no_log: true
  failed_when: false

- name: Load CF Access inventory credentials from 1Password
  ansible.builtin.set_fact:
    _inv_client_id: "{{ lookup('community.general.onepassword',
        'hermes-secrets', field='cf-access-inventory-client-id', vault='Dev',
        service_account_token=_inv_op_token_file.content | b64decode | trim) }}"
    _inv_client_secret: "{{ lookup('community.general.onepassword',
        'hermes-secrets', field='cf-access-inventory-client-secret', vault='Dev',
        service_account_token=_inv_op_token_file.content | b64decode | trim) }}"
  no_log: true
  when: _inv_op_token_file.content is defined

- name: Resolve inventory vars from Hermes
  ansible.builtin.uri:
    url: "https://api.nwlnexus.io/api/v1/inventory/resolve/{{ inventory_hostname }}"
    headers:
      CF-Access-Client-Id: "{{ _inv_client_id | default('') }}"
      CF-Access-Client-Secret: "{{ _inv_client_secret | default('') }}"
    timeout: 10
    return_content: true
  register: _hermes_inv
  failed_when: false
  ignore_errors: true

- name: Cache inventory facts locally
  ansible.builtin.copy:
    content: "{{ _hermes_inv.json | to_json }}"
    dest: /etc/ansible/facts.d/olympus_inventory.json
    owner: root
    group: ansible
    mode: '0644'
  become: true
  when:
    - _hermes_inv.status is defined
    - _hermes_inv.status == 200

- name: Reload local facts after cache update
  ansible.builtin.setup:
    filter: ansible_local
  when:
    - _hermes_inv.status is defined
    - _hermes_inv.status == 200

- name: Log inventory fetch result
  ansible.builtin.debug:
    msg: >-
      Olympus inventory:
      {{ ansible_local.olympus_inventory.groups | default([]) | join(', ') or 'no groups' }},
      {{ ansible_local.olympus_inventory.variables | default({}) | length }} vars
  when: ansible_local.olympus_inventory is defined
</file>

<file path="roles/baseline/tasks/op-cli.yml">
---
# Install the 1Password CLI (op) from the official apt repository.
# Must run before any task that uses the onepassword lookup or op read.

- name: Download 1Password apt signing key
  ansible.builtin.get_url:
    url: https://downloads.1password.com/linux/keys/1password.asc
    dest: /usr/share/keyrings/1password-archive-keyring.asc
    mode: '0644'
  become: true
  when: baseline_state == "present"

- name: Add 1Password apt repository
  ansible.builtin.apt_repository:
    repo: >-
      deb [arch={{ baseline_op_cli_arch }} signed-by=/usr/share/keyrings/1password-archive-keyring.asc]
      https://downloads.1password.com/linux/debian/{{ baseline_op_cli_arch }} stable main
    state: present
    filename: 1password
  become: true
  when: baseline_state == "present"

- name: Install 1password-cli
  ansible.builtin.apt:
    name: 1password-cli
    state: present
    update_cache: true
  become: true
  when: baseline_state == "present"

- name: Remove 1Password apt repository (state=absent)
  ansible.builtin.apt_repository:
    repo: >-
      deb [arch={{ baseline_op_cli_arch }} signed-by=/usr/share/keyrings/1password-archive-keyring.asc]
      https://downloads.1password.com/linux/debian/{{ baseline_op_cli_arch }} stable main
    state: absent
    filename: 1password
  become: true
  when: baseline_state == "absent"
</file>

<file path="roles/baseline/tasks/ssh.yml">
---
- name: SSH hardening drop-in
  ansible.builtin.template:
    src: sshd_hardening.conf.j2
    dest: /etc/ssh/sshd_config.d/99-baseline.conf
    owner: root
    group: root
    mode: '0644'
  become: true
  notify: restart sshd
  when: baseline_state == "present"

- name: Remove SSH hardening drop-in (state=absent)
  ansible.builtin.file:
    path: /etc/ssh/sshd_config.d/99-baseline.conf
    state: absent
  become: true
  notify: restart sshd
  when: baseline_state == "absent"

# Ensure privilege separation dir exists — sshd -t requires it even though
# systemd normally creates it at sshd start via RuntimeDirectory=sshd.
- name: Ensure sshd privilege separation directory exists
  ansible.builtin.file:
    path: /run/sshd
    state: directory
    owner: root
    group: root
    mode: '0755'
  become: true
  when: baseline_state == "present"

# Validate AFTER writing — sshd -t reads main config + all drop-ins.
# If invalid, the handler will fail and the running sshd is untouched
# (drop-ins only affect new connections after restart, so existing
# SSH sessions stay alive; you can fix and re-run).
- name: Validate sshd config
  ansible.builtin.command: sshd -t
  changed_when: false
  become: true
  when: baseline_state == "present"

- name: Ensure ansible user .local/bin exists
  ansible.builtin.file:
    path: /home/ansible/.local/bin
    state: directory
    owner: ansible
    group: ansible
    mode: '0755'
  become: true
  when: baseline_state == "present"

- name: Read OP service account token
  ansible.builtin.slurp:
    src: "{{ baseline_op_token_file }}"
  register: _baseline_op_sat
  no_log: true
  failed_when: false
  when:
    - baseline_state == "present"
    - baseline_op_ssh_pubkey_item != ""

# argv passes "label=public key" as a single argument — no shell quoting
# or %20 encoding needed for the space in the field name.
- name: Fetch ansible SSH public key from 1Password
  ansible.builtin.command:
    argv:
      - op
      - item
      - get
      - "{{ baseline_op_ssh_pubkey_item }}"
      - "--fields"
      - "label={{ baseline_op_ssh_pubkey_field }}"
      - "--vault"
      - "{{ baseline_op_ssh_pubkey_vault }}"
  environment:
    OP_SERVICE_ACCOUNT_TOKEN: "{{ _baseline_op_sat.content | b64decode | trim }}"
  register: _baseline_ssh_pubkey
  changed_when: false
  no_log: true
  when:
    - baseline_state == "present"
    - baseline_op_ssh_pubkey_item != ""
    - _baseline_op_sat.content is defined

- name: Provision ansible user SSH public key
  ansible.posix.authorized_key:
    user: ansible
    key: "{{ _baseline_ssh_pubkey.stdout | trim }}"
    state: present
  become: true
  when:
    - baseline_state == "present"
    - _baseline_ssh_pubkey.stdout is defined
    - _baseline_ssh_pubkey.stdout | trim | length > 0
  tags: [baseline, baseline-ssh]
</file>

<file path="roles/baseline/tasks/timesync.yml">
---
- name: Ensure /etc/systemd/timesyncd.conf.d exists
  ansible.builtin.file:
    path: /etc/systemd/timesyncd.conf.d
    state: directory
    owner: root
    group: root
    mode: '0755'
  become: true
  when: baseline_state == "present"

- name: Configure systemd-timesyncd NTP servers
  ansible.builtin.copy:
    dest: /etc/systemd/timesyncd.conf.d/99-baseline.conf
    owner: root
    group: root
    mode: '0644'
    content: |
      # Managed by Ansible (baseline role)
      [Time]
      NTP={{ baseline_ntp_servers | join(' ') }}
      FallbackNTP=pool.ntp.org
  become: true
  notify: restart timesyncd
  when: baseline_state == "present"

- name: Enable and start systemd-timesyncd
  ansible.builtin.service:
    name: systemd-timesyncd
    enabled: true
    state: started
  become: true
  when: baseline_state == "present"

- name: Remove time sync override (state=absent)
  ansible.builtin.file:
    path: /etc/systemd/timesyncd.conf.d/99-baseline.conf
    state: absent
  become: true
  notify: restart timesyncd
  when: baseline_state == "absent"
</file>

<file path="roles/baseline/tasks/unattended.yml">
---
- name: Install unattended-upgrades
  ansible.builtin.apt:
    name: unattended-upgrades
    state: present
    update_cache: false
  become: true
  when: baseline_state == "present"

- name: Configure unattended-upgrades policy
  ansible.builtin.template:
    src: 50unattended-upgrades.j2
    dest: /etc/apt/apt.conf.d/50unattended-upgrades
    owner: root
    group: root
    mode: '0644'
  become: true
  when: baseline_state == "present"

- name: Enable unattended-upgrades periodic timer
  ansible.builtin.template:
    src: 20auto-upgrades.j2
    dest: /etc/apt/apt.conf.d/20auto-upgrades
    owner: root
    group: root
    mode: '0644'
  become: true
  when: baseline_state == "present"

# Removal: drop our config files only. We do NOT uninstall unattended-upgrades
# (operators may rely on it for other reasons) and we do NOT disable the
# apt-daily-upgrade.timer (it harmlessly no-ops without config files present).
- name: Remove unattended-upgrades config (state=absent)
  ansible.builtin.file:
    path: "{{ item }}"
    state: absent
  loop:
    - /etc/apt/apt.conf.d/50unattended-upgrades
    - /etc/apt/apt.conf.d/20auto-upgrades
  become: true
  when: baseline_state == "absent"
</file>

<file path="roles/baseline/templates/20auto-upgrades.j2">
// Managed by Ansible (baseline role) — do not edit manually.
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
APT::Periodic::AutocleanInterval "7";
</file>

<file path="roles/baseline/templates/50unattended-upgrades.j2">
// Managed by Ansible (baseline role) — do not edit manually.
Unattended-Upgrade::Allowed-Origins {
    "${distro_id}:${distro_codename}-security";
    "${distro_id}ESMApps:${distro_codename}-apps-security";
    "${distro_id}ESM:${distro_codename}-infra-security";
};

Unattended-Upgrade::Package-Blacklist {
};

Unattended-Upgrade::DevRelease "auto";
Unattended-Upgrade::AutoFixInterruptedDpkg "true";
Unattended-Upgrade::MinimalSteps "true";
Unattended-Upgrade::InstallOnShutdown "false";
Unattended-Upgrade::Remove-Unused-Kernel-Packages "true";
Unattended-Upgrade::Remove-New-Unused-Dependencies "true";
Unattended-Upgrade::Remove-Unused-Dependencies "true";
{% if baseline_unattended_auto_reboot %}
Unattended-Upgrade::Automatic-Reboot "true";
Unattended-Upgrade::Automatic-Reboot-WithUsers "true";
Unattended-Upgrade::Automatic-Reboot-Time "{{ baseline_unattended_auto_reboot_time }}";
{% else %}
Unattended-Upgrade::Automatic-Reboot "false";
{% endif %}
</file>

<file path="roles/baseline/templates/ansible-pull.logrotate.j2">
# Managed by Ansible (baseline role)
/var/log/ansible-pull/*.log {
    weekly
    rotate 4
    compress
    delaycompress
    missingok
    notifempty
    # `create` owner is ansible_pull_user, defined in the `ansible-pull` role's
    # defaults. Falls back to 'ansible' if baseline is applied standalone.
    create 0644 {{ ansible_pull_user | default('ansible') }} root
}
</file>

