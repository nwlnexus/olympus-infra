<file path="roles/k3s/templates/k3s-cni-bridge-fixer.service.j2">
# Managed by Ansible — do not edit manually.
# Workaround for k3s embedded CNI skipping cni0 bridge attachment.
[Unit]
Description=k3s CNI bridge fixer — attaches pod veths to cni0
After=k3s.service
BindsTo=k3s.service

[Service]
Type=simple
ExecStart=/usr/local/bin/k3s-cni-bridge-fixer.sh
Restart=always
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=k3s-cni-fixer

[Install]
WantedBy=multi-user.target
</file>

<file path="roles/k3s/templates/k3s-cni-bridge-fixer.sh.j2">
#!/usr/bin/env bash
# k3s-cni-bridge-fixer — workaround for k3s embedded CNI not attaching
# pod veth pairs to the cni0 bridge.
#
# Managed by Ansible — do not edit manually.
#
# k3s creates veth pairs for pods but (in affected versions) skips the
# bridge attachment step. This service detects veths with no master and
# attaches them to cni0, restoring pod-to-service-network routing.

set -euo pipefail

BRIDGE="{{ k3s_cni_bridge | default('cni0') }}"
INTERVAL="{{ k3s_cni_fixer_interval | default(3) }}"

while true; do
    for veth in $(ip link show type veth 2>/dev/null | \
                  awk '/^[0-9]+:/{sub(/@.*$/, "", $2); print $2}'); do
        master=$(ip link show "$veth" 2>/dev/null | awk '/master/{print $NF; exit}')
        if [[ -z "$master" ]]; then
            if ip link set "$veth" master "$BRIDGE" 2>/dev/null; then
                echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ') attached $veth to $BRIDGE"
            fi
        fi
    done
    sleep "$INTERVAL"
done
</file>

<file path="roles/k3s/templates/kube-vip.yaml.j2">
---
# kube-vip static pod manifest — deployed to all k3s server nodes
# Manages a floating VIP (ARP mode) across control-plane nodes.
# Written by Ansible before k3s starts so it's available on first boot.
# Reference: https://kube-vip.io/docs/installation/static/
apiVersion: v1
kind: Pod
metadata:
  name: kube-vip
  namespace: kube-system
spec:
  containers:
    - name: kube-vip
      image: ghcr.io/kube-vip/kube-vip:v0.8.9
      args:
        - manager
      env:
        - name: vip_arp
          value: "true"
        - name: port
          value: "6443"
        - name: vip_interface
          value: "{{ _k3s_vip_interface | default(k3s_vip_interface) }}"
        - name: vip_cidr
          value: "32"
        - name: cp_enable
          value: "true"
        - name: cp_namespace
          value: kube-system
        - name: vip_leaderelection
          value: "true"
        - name: vip_leaseduration
          value: "5"
        - name: vip_renewdeadline
          value: "3"
        - name: vip_retryperiod
          value: "1"
        - name: address
          value: "{{ k3s_vip }}"
        - name: prometheus_server
          value: ":2112"
      volumeMounts:
        - mountPath: /etc/kubernetes/admin.conf
          name: kubeconfig
      resources:
        requests:
          cpu: 10m
          memory: 32Mi
      securityContext:
        capabilities:
          add:
            - NET_ADMIN
            - NET_RAW
            - SYS_TIME
  hostAliases:
    - hostnames:
        - kubernetes
      ip: 127.0.0.1
  hostNetwork: true
  priorityClassName: system-node-critical
  volumes:
    - name: kubeconfig
      hostPath:
        path: /etc/rancher/k3s/k3s.yaml
        type: FileOrCreate
</file>

<file path="roles/k3s/README.md">
# k3s role

| Mode | Vars |
|---|---|
| HA server (control-plane) | `k3s_ha: true`, `k3s_primary: true/false`, `k3s_init` (one node), `k3s_vip`, `k3s_token_op_ref`, optional `k3s_node_labels`, `k3s_etcd_snapshot_dir` |
| Agent (worker) | `k3s_agent: true`, `k3s_server_url: https://<vip>:6443`, `k3s_token_op_ref`, `k3s_node_labels`, `k3s_node_taints` |
| Single-node (legacy) | neither `k3s_ha` nor `k3s_agent` |

Labels apply at first join (config.yaml) and are reconciled on servers via kubectl.
etcd snapshots go to `k3s_etcd_snapshot_dir` (mount it first, e.g. QNAP NFS).
</file>

