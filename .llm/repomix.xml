- name: restart sshd
  ansible.builtin.service:
    name: "{{ 'ssh' if ansible_facts['os_family'] == 'Debian' else 'sshd' }}"
    state: restarted
  become: true

- name: restart fail2ban
  ansible.builtin.service:
    name: fail2ban
    state: restarted
  become: true

- name: restart timesyncd
  ansible.builtin.service:
    name: systemd-timesyncd
    state: restarted
  become: true
</file>

<file path="roles/baseline/meta/main.yml">
---
galaxy_info:
  author: Olympus Infrastructure Team
  description: Security baseline for Linux hosts under ansible-pull management
  company: Olympus Organization
  license: MIT
  min_ansible_version: "2.12"
  platforms:
    - name: Ubuntu
      versions:
        - jammy
