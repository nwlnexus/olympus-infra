<file path="roles/bootstrap-user/defaults/main.yml">
---
bootstrap_user_state: present
bootstrap_user_name: ansible
bootstrap_user_home_linux: /home/ansible
bootstrap_user_home_macos: /var/ansible
bootstrap_user_shell: /bin/bash

# Source directory on the connecting user's account (nwilliams-lucas)
# Files here are copied to /etc/olympus/ after the ansible user is created
bootstrap_creds_src: "~/olympus-creds"

# Destination on the remote host
bootstrap_creds_dest: /etc/olympus

# Credential files to copy from bootstrap_creds_src → bootstrap_creds_dest
# Note: cloudflare-api-token and 1password-credentials.json come from vault vars now;
# add any extra files here only if they don't have a vault var equivalent
bootstrap_cred_files: []

# 1Password Connect credentials JSON (set via vault var onepassword_credentials_json)
# If non-empty, written to bootstrap_creds_dest/1password-credentials.json
onepassword_credentials_json: ""

# Hermes per-host token (issued via Atlas; stored in 1Password).
# Empty by default — host opts in by setting hermes_token_op_item in host_vars,
# e.g. "op://Dev/{{ inventory_hostname }}-hermes-token/credential".
# When empty, the fetch task is a no-op so unconfigured hosts skip cleanly.
hermes_token_op_item: ""
hermes_token_dest: "/etc/olympus/hermes-token"
hermes_token_mode: "0640"
hermes_token_owner: "root"
hermes_token_group: "ansible"
</file>

<file path="roles/bootstrap-user/tasks/linux.yml">
---
- name: Create ansible user (Linux)
  ansible.builtin.user:
    name: "{{ bootstrap_user_name }}"
    home: "{{ bootstrap_user_home_linux }}"
    shell: "{{ bootstrap_user_shell }}"
    groups: sudo
    append: true
    create_home: true
    state: "{{ bootstrap_user_state }}"
  become: true

- name: Grant ansible user passwordless sudo (Linux)
  ansible.builtin.copy:
    content: "{{ bootstrap_user_name }} ALL=(ALL) NOPASSWD:ALL\n"
    dest: "/etc/sudoers.d/{{ bootstrap_user_name }}"
    owner: root
    group: root
    mode: "0440"
    validate: /usr/sbin/visudo -cf %s
  become: true
  when: bootstrap_user_state == "present"

- name: Remove ansible sudoers file (Linux)
  ansible.builtin.file:
    path: "/etc/sudoers.d/{{ bootstrap_user_name }}"
    state: absent
  become: true
  when: bootstrap_user_state == "absent"

- name: Ensure ansible .ssh directory exists (Linux)
  ansible.builtin.file:
    path: "{{ bootstrap_user_home_linux }}/.ssh"
    state: directory
    owner: "{{ bootstrap_user_name }}"
    group: "{{ bootstrap_user_name }}"
    mode: "0700"
  become: true
  when: bootstrap_user_state == "present"

- name: Ensure ansible .local/bin directory exists (Linux)
  ansible.builtin.file:
    path: "{{ bootstrap_user_home_linux }}/.local/bin"
    state: directory
    owner: "{{ bootstrap_user_name }}"
    group: "{{ bootstrap_user_name }}"
    mode: "0755"
  become: true
  when: bootstrap_user_state == "present"

# `/var/log/ansible-pull/` is owned by the `ansible-pull` role
# (group: sudo). Duplicating here with a different group breaks idempotency.

- name: Create /etc/olympus credential directory
  ansible.builtin.file:
    path: "{{ bootstrap_creds_dest }}"
    state: directory
    owner: root
    group: "{{ bootstrap_user_name }}"
    mode: "0750"
  become: true
  when: bootstrap_user_state == "present"

- name: Stat each credential file on the controller
  ansible.builtin.stat:
    path: "{{ bootstrap_creds_src }}/{{ item }}"
  register: cred_stat
  loop: "{{ bootstrap_cred_files }}"
  delegate_to: localhost
  become: false
  when: bootstrap_user_state == "present"

- name: Copy credential files to /etc/olympus
  ansible.builtin.copy:
    src: "{{ bootstrap_creds_src }}/{{ item.item }}"
    dest: "{{ bootstrap_creds_dest }}/{{ item.item }}"
    owner: "{{ bootstrap_user_name }}"
    group: "{{ bootstrap_user_name }}"
    mode: "0600"
  loop: "{{ cred_stat.results }}"
  loop_control:
    label: "{{ item.item }}"
  when:
    - bootstrap_user_state == "present"
    - item.stat.exists
    - item.stat.size > 0
  become: true

- name: Warn about missing credential files
  ansible.builtin.debug:
    msg: "WARNING: {{ item.item }} not found at {{ bootstrap_creds_src }}/ — skipping"
  loop: "{{ cred_stat.results }}"
  loop_control:
    label: "{{ item.item }}"
  when:
    - bootstrap_user_state == "present"
    - not item.stat.exists

- name: Write 1Password credentials JSON from vault var
  ansible.builtin.copy:
    content: "{{ onepassword_credentials_json }}"
    dest: "{{ bootstrap_creds_dest }}/1password-credentials.json"
    owner: "{{ bootstrap_user_name }}"
    group: "{{ bootstrap_user_name }}"
    mode: "0600"
  become: true
  no_log: true
  when:
    - bootstrap_user_state == "present"
    - onepassword_credentials_json != ""

- name: Write 1Password service account token from vault var
  ansible.builtin.copy:
    content: "{{ op_service_account_token }}"
    dest: "{{ bootstrap_creds_dest }}/op-service-account-token"
    owner: "{{ bootstrap_user_name }}"
    group: "{{ bootstrap_user_name }}"
    mode: "0600"
  become: true
  no_log: true
  when:
    - bootstrap_user_state == "present"
    - op_service_account_token | default('') != ''

# ── Hermes per-host token (SP2) ───────────────────────────────────────────
# Fetched from 1Password using the local `op` CLI on the controller. Each
# host opts in by setting hermes_token_op_item in host_vars; default is
# empty so unconfigured hosts skip cleanly.
- name: Fetch Hermes token from 1Password
  ansible.builtin.command:
    cmd: "op read {{ hermes_token_op_item }}"
  environment:
    OP_SERVICE_ACCOUNT_TOKEN: "{{ op_service_account_token | default('') }}"
  delegate_to: localhost
  become: false
  register: _hermes_token_op
  no_log: true
  changed_when: false
  when:
    - bootstrap_user_state == 'present'
    - hermes_token_op_item != ''

- name: Write Hermes token file
  ansible.builtin.copy:
    content: "{{ _hermes_token_op.stdout }}"
    dest: "{{ hermes_token_dest }}"
    owner: "{{ hermes_token_owner }}"
    group: "{{ hermes_token_group }}"
    mode: "{{ hermes_token_mode }}"
  become: true
  no_log: true
  when:
    - bootstrap_user_state == 'present'
    - hermes_token_op_item != ''
    - _hermes_token_op.stdout | default('') != ''
</file>

<file path="roles/bootstrap-user/tasks/macos.yml">
---
- name: Check if ansible user exists (macOS)
  ansible.builtin.command: id {{ bootstrap_user_name }}
  register: ansible_user_check
  failed_when: false
  changed_when: false

- name: Create ansible user via sysadminctl (macOS)
  ansible.builtin.command: >
    sysadminctl
    -addUser {{ bootstrap_user_name }}
    -fullName "Ansible Automation"
    -home {{ bootstrap_user_home_macos }}
    -shell {{ bootstrap_user_shell }}
    -admin
  become: true
  when:
    - bootstrap_user_state == "present"
    - ansible_user_check.rc != 0

- name: Hide ansible user from login window (macOS)
  ansible.builtin.command: dscl . -create /Users/{{ bootstrap_user_name }} IsHidden 1
  become: true
  when:
    - bootstrap_user_state == "present"
    - ansible_user_check.rc != 0

- name: Set ansible user shell (macOS)
  ansible.builtin.command: dscl . -create /Users/{{ bootstrap_user_name }} UserShell {{ bootstrap_user_shell }}
  become: true
  when:
    - bootstrap_user_state == "present"
    - ansible_user_check.rc != 0

- name: Ensure ansible user home directory exists (macOS)
  ansible.builtin.file:
    path: "{{ bootstrap_user_home_macos }}"
    state: directory
    owner: "{{ bootstrap_user_name }}"
    group: admin
    mode: "0755"
  become: true
  when: bootstrap_user_state == "present"

- name: Ensure ansible .ssh directory exists (macOS)
  ansible.builtin.file:
    path: "{{ bootstrap_user_home_macos }}/.ssh"
    state: directory
    owner: "{{ bootstrap_user_name }}"
    group: admin
    mode: "0700"
  become: true
  when: bootstrap_user_state == "present"

- name: Grant ansible user passwordless sudo (macOS)
  ansible.builtin.copy:
    content: "{{ bootstrap_user_name }} ALL=(ALL) NOPASSWD:ALL\n"
    dest: "/etc/sudoers.d/{{ bootstrap_user_name }}"
    owner: root
    group: wheel
    mode: "0440"
    validate: /usr/sbin/visudo -cf %s
  become: true
  when: bootstrap_user_state == "present"

# `/var/log/ansible-pull/` is owned by the `ansible-pull` role
# (group: admin on Darwin). Duplicating here breaks idempotency.

- name: Remove ansible user (macOS)
  ansible.builtin.command: sysadminctl -deleteUser {{ bootstrap_user_name }}
  become: true
  when:
    - bootstrap_user_state == "absent"
    - ansible_user_check.rc == 0

- name: Remove ansible sudoers file (macOS)
  ansible.builtin.file:
    path: "/etc/sudoers.d/{{ bootstrap_user_name }}"
    state: absent
  become: true
  when: bootstrap_user_state == "absent"
</file>

<file path="roles/bootstrap-user/tasks/main.yml">
---
- name: Bootstrap user — Linux
  ansible.builtin.include_tasks: linux.yml
  when: ansible_facts['os_family'] != "Darwin"

- name: Bootstrap user — macOS
  ansible.builtin.include_tasks: macos.yml
  when: ansible_facts['os_family'] == "Darwin"
</file>

<file path="roles/cert-manager/defaults/main.yml">
---
cert_manager_state: present
cert_manager_namespace: cert-manager
cert_manager_chart_version: "v1.16.2"
cert_manager_email: ""                  # Let's Encrypt registration email
cert_manager_cloudflare_api_token: ""  # Cloudflare API token for DNS-01 challenge
cert_manager_domain: ""                # base domain for wildcard cert (e.g. nwlnexus.net)
cert_manager_cluster_issuer_name: letsencrypt-prod
k3s_kubeconfig_path: /etc/rancher/k3s/k3s.yaml
</file>

<file path="roles/cert-manager/tasks/main.yml">
---
- name: Set cert-manager state
  ansible.builtin.set_fact:
    _cert_manager_state: "{{ cert_manager_state | default('present') }}"

# --- PRESENT ---

- name: Add Jetstack Helm repo
  ansible.builtin.command: helm repo add jetstack https://charts.jetstack.io
  register: repo_add
  changed_when: "'already exists' not in repo_add.stderr"
  become: true
  when: _cert_manager_state == 'present'

- name: Update Helm repos
  ansible.builtin.command: helm repo update
  become: true
  changed_when: false
  when: _cert_manager_state == 'present'

- name: Create cert-manager namespace
  ansible.builtin.command: kubectl create namespace {{ cert_manager_namespace }}
  register: ns_create
  failed_when:
    - ns_create.rc != 0
    - "'already exists' not in ns_create.stderr"
  changed_when: ns_create.rc == 0
  become: true
  environment:
    KUBECONFIG: "{{ k3s_kubeconfig_path }}"
  when: _cert_manager_state == 'present'

- name: Install cert-manager via Helm
  ansible.builtin.command: >
    helm upgrade --install cert-manager jetstack/cert-manager
    --namespace {{ cert_manager_namespace }}
    --version {{ cert_manager_chart_version }}
    --set crds.enabled=true
    --wait
  become: true
  environment:
    KUBECONFIG: "{{ k3s_kubeconfig_path }}"
  changed_when: true
  when: _cert_manager_state == 'present'

- name: Wait for cert-manager webhook rollout
  ansible.builtin.command: >
    kubectl rollout status deployment/cert-manager-webhook
    -n {{ cert_manager_namespace }}
    --timeout=120s
  become: true
  environment:
    KUBECONFIG: "{{ k3s_kubeconfig_path }}"
  changed_when: false
  when: _cert_manager_state == 'present'

- name: Create Cloudflare API token secret
  ansible.builtin.shell: >
    kubectl create secret generic cloudflare-api-token
    --namespace {{ cert_manager_namespace }}
    --from-literal=api-token={{ cert_manager_cloudflare_api_token }}
    --dry-run=client -o yaml | kubectl apply -f -
  become: true
  environment:
    KUBECONFIG: "{{ k3s_kubeconfig_path }}"
  changed_when: true
  no_log: true
  when:
    - _cert_manager_state == 'present'
    - cert_manager_cloudflare_api_token != ""

- name: Render ClusterIssuer manifest
  ansible.builtin.template:
    src: cluster-issuer.yaml.j2
    dest: /tmp/cert-manager-cluster-issuer.yaml
    mode: "0600"
  when:
    - _cert_manager_state == 'present'
    - cert_manager_email != ""
    - cert_manager_domain != ""

- name: Apply ClusterIssuer manifest
  ansible.builtin.command: kubectl apply -f /tmp/cert-manager-cluster-issuer.yaml
  become: true
  environment:
    KUBECONFIG: "{{ k3s_kubeconfig_path }}"
  changed_when: true
  when:
    - _cert_manager_state == 'present'
    - cert_manager_email != ""
    - cert_manager_domain != ""

- name: Render wildcard Certificate manifest
  ansible.builtin.template:
    src: wildcard-certificate.yaml.j2
    dest: /tmp/cert-manager-wildcard-certificate.yaml
    mode: "0600"
  when:
    - _cert_manager_state == 'present'
    - cert_manager_email != ""
    - cert_manager_domain != ""

- name: Apply wildcard Certificate manifest
  ansible.builtin.command: kubectl apply -f /tmp/cert-manager-wildcard-certificate.yaml
  become: true
  environment:
    KUBECONFIG: "{{ k3s_kubeconfig_path }}"
  changed_when: true
  when:
    - _cert_manager_state == 'present'
    - cert_manager_email != ""
    - cert_manager_domain != ""

# --- ABSENT ---

- name: Uninstall cert-manager
  ansible.builtin.command: helm uninstall cert-manager -n {{ cert_manager_namespace }}
  become: true
  environment:
    KUBECONFIG: "{{ k3s_kubeconfig_path }}"
  failed_when: false
  changed_when: true
  when: _cert_manager_state == 'absent'
</file>

<file path="roles/cert-manager/templates/cluster-issuer.yaml.j2">
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: {{ cert_manager_cluster_issuer_name }}
spec:
  acme:
    server: https://acme-v02.api.letsencrypt.org/directory
    email: {{ cert_manager_email }}
    privateKeySecretRef:
      name: {{ cert_manager_cluster_issuer_name }}-key
    solvers:
      - dns01:
          cloudflare:
            apiTokenSecretRef:
              name: cloudflare-api-token
              key: api-token
</file>

<file path="roles/cert-manager/templates/wildcard-certificate.yaml.j2">
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: wildcard-{{ cert_manager_domain | replace('.', '-') }}
  namespace: kube-system
spec:
  secretName: wildcard-tls
  issuerRef:
    name: {{ cert_manager_cluster_issuer_name }}
    kind: ClusterIssuer
  dnsNames:
    - "*.{{ cert_manager_domain }}"
    - "{{ cert_manager_domain }}"
</file>

<file path="roles/cloudflared/defaults/main.yml">
---
cloudflared_state: present
# Users whose ~/Library/LaunchAgents/com.cloudflare.cloudflared.plist should be
# removed during migration to the system LaunchDaemon. Set per-host in host_vars.
cloudflared_legacy_users: []
# Tunnel UUID — set per-host in host_vars
cloudflared_tunnel_id: ""
# 1Password item holding the credentials JSON content
# Field: cloudflared-tunnel-credentials (raw JSON string)
cloudflared_credentials_op_item: "ai-hub-secrets"
cloudflared_credentials_op_field: "cloudflared-tunnel-credentials"
cloudflared_credentials_op_vault: "Dev"
</file>

<file path="roles/cloudflared/tasks/main.yml">
---
- name: Install cloudflared via Homebrew
  community.general.homebrew:
    name: cloudflared
    state: "{{ 'present' if cloudflared_state == 'present' else 'absent' }}"

# ── macOS: LaunchDaemon + /etc/cloudflared credentials ───────────────────────
- name: Create /etc/cloudflared directory (macOS)
  ansible.builtin.file:
    path: /etc/cloudflared
    state: directory
    owner: root
    group: wheel
    mode: "0755"
  become: true
  when:
    - cloudflared_state == "present"
    - ansible_facts['os_family'] == "Darwin"
    - cloudflared_tunnel_id != ""

- name: Write tunnel credentials to /etc/cloudflared (macOS)
  ansible.builtin.copy:
    content: "{{ lookup('community.general.onepassword', cloudflared_credentials_op_item, field=cloudflared_credentials_op_field, vault=cloudflared_credentials_op_vault) }}"
    dest: "/etc/cloudflared/{{ cloudflared_tunnel_id }}.json"
    owner: root
    group: wheel
    mode: "0640"
  become: true
  no_log: true
  when:
    - cloudflared_state == "present"
    - ansible_facts['os_family'] == "Darwin"
    - cloudflared_tunnel_id != ""

- name: Deploy /etc/cloudflared/config.yml (macOS)
  ansible.builtin.template:
    src: config.yml.j2
    dest: /etc/cloudflared/config.yml
    owner: root
    group: wheel
    mode: "0644"
  become: true
  when:
    - cloudflared_state == "present"
    - ansible_facts['os_family'] == "Darwin"
    - cloudflared_tunnel_id != ""

- name: Deploy cloudflared LaunchDaemon plist (macOS)
  ansible.builtin.template:
    src: cloudflared-launchdaemon.plist.j2
    dest: /Library/LaunchDaemons/com.cloudflare.cloudflared.plist
    owner: root
    group: wheel
    mode: "0644"
  become: true
  when:
    - cloudflared_state == "present"
    - ansible_facts['os_family'] == "Darwin"
    - cloudflared_tunnel_id != ""
  register: _cloudflared_plist

- name: Remove old user-level LaunchAgent if present (macOS migration)
  ansible.builtin.file:
    path: "/Users/{{ item }}/Library/LaunchAgents/com.cloudflare.cloudflared.plist"
    state: absent
  become: true
  loop: "{{ ([ansible_user] + cloudflared_legacy_users) | unique }}"
  failed_when: false
  when:
    - cloudflared_state == "present"
    - ansible_facts['os_family'] == "Darwin"

- name: Unload old LaunchAgent (macOS migration, errors ok)
  ansible.builtin.command: >
    launchctl bootout user/$(id -u {{ item }}) com.cloudflare.cloudflared
  become: false
  failed_when: false
  changed_when: false
  loop: "{{ ([ansible_user] + cloudflared_legacy_users) | unique }}"
  when:
    - cloudflared_state == "present"
    - ansible_facts['os_family'] == "Darwin"

- name: Load cloudflared LaunchDaemon (macOS)
  ansible.builtin.command: >
    launchctl bootstrap system /Library/LaunchDaemons/com.cloudflare.cloudflared.plist
  become: true
  changed_when: true
  failed_when: false
  when:
    - cloudflared_state == "present"
    - ansible_facts['os_family'] == "Darwin"
    - cloudflared_tunnel_id != ""
    - _cloudflared_plist.changed

# ── non-macOS: binary-only, tunnel service runs in k3s ────────────────────────
- name: cloudflared binary only — service runs in k3s
  ansible.builtin.debug:
    msg: >
      cloudflared binary installed. The tunnel service runs as a Kubernetes Deployment
      managed by Flux. See clusters/ in olympus-gitops.
  when:
    - cloudflared_state == "present"
    - ansible_facts['os_family'] != "Darwin"
</file>

<file path="roles/cloudflared/templates/cloudflared-launchdaemon.plist.j2">
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cloudflare.cloudflared</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/cloudflared</string>
    <string>tunnel</string>
    <string>--config</string>
    <string>/etc/cloudflared/config.yml</string>
    <string>run</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/var/log/cloudflared.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/cloudflared.log</string>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>5</integer>
</dict>
</plist>
</file>

<file path="roles/cloudflared/templates/config.yml.j2">
{% if ansible_facts['os_family'] == 'Darwin' %}
tunnel: {{ cloudflared_tunnel_id }}
credentials-file: /etc/cloudflared/{{ cloudflared_tunnel_id }}.json
{% else %}
tunnel: {{ cloudflared_tunnel_id }}
credentials-file: /Users/{{ ansible_user }}/.cloudflared/{{ cloudflared_tunnel_id }}.json

ingress:
  - hostname: {{ cloudflared_hostname }}
    service: http://{{ cloudflared_service_host }}:{{ cloudflared_service_port }}
  - service: http_status:404
{% endif %}
</file>

<file path="roles/cloudflared-k8s/defaults/main.yml">
---
cloudflared_k8s_state: present
cloudflared_namespace: cloudflared
# Kubeconfig path and context — override for non-k3s clusters (e.g. OrbStack on macOS)
cloudflared_kubeconfig_path: "{{ k3s_kubeconfig_path | default('/etc/rancher/k3s/k3s.yaml') }}"
cloudflared_kubectl_context: ""       # empty = use default context in kubeconfig
cloudflared_kubectl_become: "{{ ansible_facts['system'] != 'Darwin' }}"  # false on macOS
cloudflared_tunnel_name: ""
# --- Cloudflare API token resolution ---
# Explicit override wins; otherwise read from 1Password via the
# community.general.onepassword lookup (the pull wrapper exports
# OP_SERVICE_ACCOUNT_TOKEN + puts `op` on PATH, so no extra plumbing). The
# token must be a Bearer API token with Tunnel + DNS edit scope.
cloudflared_api_token: ""
cloudflared_cf_token_op_item: "cloudflare-account"
cloudflared_cf_token_op_field: "api_token"
cloudflared_account_id: ""   # set in group_vars
cloudflared_image: "cloudflare/cloudflared:latest"
cloudflared_replicas: 1

# --- Route configuration ---
# Base domain for tunnel public hostnames (e.g. "example.com")
cloudflared_domain: ""
# Cloudflare zone ID — looked up dynamically from cloudflared_domain if empty
cloudflared_zone_id: ""
# Services to expose through the tunnel.
# Each entry maps a public subdomain to a k8s cluster service.
# The full public hostname will be: {{ subdomain }}.{{ cloudflared_domain }}
cloudflared_services:
  - subdomain: argocd
    k8s_service: "http://argocd-server.argocd:80"
  - subdomain: connect
    k8s_service: "http://connect-1password-connect.1password:8080"
  - subdomain: traefik
    k8s_service: "http://traefik-dashboard.traefik:9000"

# --- Bootstrap-only mode ---
# When true: create tunnel + seed k8s secret + configure catch-all ingress rule.
# Skip Deployment creation (ArgoCD handles that via GitOps).
cloudflared_bootstrap_only: false
# The ingress hostname for this cluster (e.g. ing.mgmt.nwlnexus.net).
# When set, Ansible creates the CNAME: <ingress_hostname> → <tunnel-uuid>.cfargotunnel.com
# and configures the tunnel catch-all rule to forward to cloudflared_catch_all_service.
cloudflared_ingress_hostname: ""
# The backend service cloudflared forwards all traffic to (catch-all rule).
# management-hub: https://traefik.kube-system:443
# ai-hub:         https://traefik.traefik:443
cloudflared_catch_all_service: "https://traefik.kube-system:443"

# --- GitOps mode (push credentials to 1Password instead of k8s Secret) ---
# Use with cloudflared_bootstrap_only: true to fully delegate steady-state to
# Flux + ExternalSecret. The role still owns tunnel existence + ingress CNAME,
# but the K8s Secret is created by ESO from the 1Password item below instead of
# by Ansible. Pairs with cloudflared_skip_k8s_secret (defaults to the same).
#
# The tunnel item is written via the `op` CLI using the same service-account
# token used for the CF token read — no Connect token (or any extra secret)
# on disk.
cloudflared_op_enabled: false
# 1Password vault name (must match the vault ESO is configured to read).
cloudflared_op_vault: "Dev"
# 1Password item title. Default: <tunnel_name>-cloudflared.
cloudflared_op_item_title: "{{ cloudflared_tunnel_name }}-cloudflared"
# When true, skip Ansible's direct K8s Secret write (ESO handles it).
cloudflared_skip_k8s_secret: "{{ cloudflared_op_enabled }}"
</file>

<file path="roles/cloudflared-k8s/tasks/main.yml">
---
- name: Set cloudflared-k8s state
  ansible.builtin.set_fact:
    _cf_k8s_state: "{{ cloudflared_k8s_state | default('present') }}"

# Build kubectl base command (with optional --context)
- name: Set kubectl base command
  ansible.builtin.set_fact:
    _kubectl: >-
      kubectl
      {%- if cloudflared_kubectl_context != '' %} --context {{ cloudflared_kubectl_context }}{% endif %}

# --- CF API TOKEN RESOLUTION ---
# Prefer an explicit override (push runs / CI); otherwise read from 1Password
# with the community.general.onepassword lookup. During ansible-pull the
# wrapper exports OP_SERVICE_ACCOUNT_TOKEN and puts `op` on PATH (see
# roles/ansible-pull/templates/ansible-pull-run.j2), so the lookup needs no
# extra plumbing — same pattern as roles/cloudflared and the tailscale lookups.
- name: Resolve Cloudflare API token
  ansible.builtin.set_fact:
    cf_token: >-
      {{ cloudflared_api_token if cloudflared_api_token != ''
         else lookup('community.general.onepassword',
                     cloudflared_cf_token_op_item,
                     field=cloudflared_cf_token_op_field,
                     vault=cloudflared_op_vault) }}
  no_log: true
  when: _cf_k8s_state == 'present'

- name: Skip if no Cloudflare API token could be resolved
  ansible.builtin.meta: end_play
  when:
    - _cf_k8s_state == 'present'
    - cf_token | default('') == ''

# Look up by name FIRST (CF returns 400 on duplicate-name POST, not 409, so
# create-then-recover-with-GET fails the play. Reverse the order.)
- name: Look up existing tunnel by name
  ansible.builtin.uri:
    url: "https://api.cloudflare.com/client/v4/accounts/{{ cloudflared_account_id }}/cfd_tunnel?name={{ cloudflared_tunnel_name }}&is_deleted=false"
    method: GET
    headers:
      Authorization: "Bearer {{ cf_token }}"
    status_code: 200
  register: tunnel_list
  no_log: true
  when:
    - _cf_k8s_state == 'present'
    - cloudflared_tunnel_name != ""

- name: Create tunnel via Cloudflare API (only if missing)
  ansible.builtin.uri:
    url: "https://api.cloudflare.com/client/v4/accounts/{{ cloudflared_account_id }}/cfd_tunnel"
    method: POST
    headers:
      Authorization: "Bearer {{ cf_token }}"
      Content-Type: "application/json"
    body_format: json
    body:
      name: "{{ cloudflared_tunnel_name }}"
      config_src: cloudflare
    status_code: 200
  register: tunnel_create
  no_log: true
  when:
    - _cf_k8s_state == 'present'
    - cloudflared_tunnel_name != ""
    - (tunnel_list.json.result | default([]) | length) == 0

- name: Re-list tunnel after creation
  ansible.builtin.uri:
    url: "https://api.cloudflare.com/client/v4/accounts/{{ cloudflared_account_id }}/cfd_tunnel?name={{ cloudflared_tunnel_name }}&is_deleted=false"
    method: GET
    headers:
      Authorization: "Bearer {{ cf_token }}"
    status_code: 200
  register: tunnel_list
  no_log: true
  when:
    - _cf_k8s_state == 'present'
    - cloudflared_tunnel_name != ""
    - tunnel_create is defined
    - tunnel_create is not skipped

- name: Fail if tunnel not found
  ansible.builtin.fail:
    msg: "Tunnel '{{ cloudflared_tunnel_name }}' not found via Cloudflare API"
  when:
    - _cf_k8s_state == 'present'
    - cloudflared_tunnel_name != ""
    - tunnel_list.json.result | length == 0

- name: Set tunnel ID
  ansible.builtin.set_fact:
    cloudflared_tunnel_id: "{{ tunnel_list.json.result[0].id }}"
  when:
    - _cf_k8s_state == 'present'
    - tunnel_list.json.result | length > 0

- name: Create cloudflared namespace
  ansible.builtin.command: "{{ _kubectl }} create namespace {{ cloudflared_namespace }}"
  register: cf_ns_create
  failed_when:
    - cf_ns_create.rc != 0
    - "'already exists' not in cf_ns_create.stderr"
  changed_when: cf_ns_create.rc == 0
  become: "{{ cloudflared_kubectl_become }}"
  environment:
    KUBECONFIG: "{{ cloudflared_kubeconfig_path }}"
  when: _cf_k8s_state == 'present'

- name: Get tunnel token
  ansible.builtin.uri:
    url: "https://api.cloudflare.com/client/v4/accounts/{{ cloudflared_account_id }}/cfd_tunnel/{{ cloudflared_tunnel_id }}/token"
    method: GET
    headers:
      Authorization: "Bearer {{ cf_token }}"
    status_code: 200
  register: tunnel_token_resp
  no_log: true
  when: _cf_k8s_state == 'present'

- name: Create cloudflared tunnel secret
  ansible.builtin.shell: |
    set -o pipefail
    {{ _kubectl }} create secret generic cloudflared-creds \
      --from-literal=tunnel-token={{ tunnel_token_resp.json.result }} \
      -n {{ cloudflared_namespace }} \
      --dry-run=client -o yaml | {{ _kubectl }} apply -f -
  args:
    executable: /bin/bash
  become: "{{ cloudflared_kubectl_become }}"
  environment:
    KUBECONFIG: "{{ cloudflared_kubeconfig_path }}"
  no_log: true
  changed_when: true
  when:
    - _cf_k8s_state == 'present'
    - not (cloudflared_skip_k8s_secret | bool)

# GitOps mode: push credentials to 1Password so ESO can hydrate the in-cluster
# Secret. Item create/edit has no lookup-plugin equivalent, so this uses the
# `op` CLI (on PATH + OP_SERVICE_ACCOUNT_TOKEN exported by the pull wrapper).
- name: Push tunnel credentials to 1Password
  ansible.builtin.include_tasks: onepassword.yml
  when:
    - _cf_k8s_state == 'present'
    - cloudflared_op_enabled | bool

# --- BOOTSTRAP-ONLY: configure catch-all rule + ingress CNAME, then stop ---
# When cloudflared_bootstrap_only: true, ArgoCD deploys the Deployment.
# Ansible only: creates tunnel, seeds token secret, configures catch-all ingress.

# --- IDEMPOTENT catch-all: GET current config, only PUT if catch-all is missing or wrong ---
# Preserves any hostname-specific routes added via the Cloudflare dashboard.

- name: Get current tunnel ingress configuration
  ansible.builtin.uri:
    url: "https://api.cloudflare.com/client/v4/accounts/{{ cloudflared_account_id }}/cfd_tunnel/{{ cloudflared_tunnel_id }}/configurations"
    method: GET
    headers:
      Authorization: "Bearer {{ cf_token }}"
    status_code: 200
  register: _cf_current_config
  no_log: true
  when:
    - _cf_k8s_state == 'present'
    - cloudflared_bootstrap_only | bool
    - cloudflared_catch_all_service != ""

- name: Extract current catch-all and hostname rules
  ansible.builtin.set_fact:
    _cf_current_catchall: >-
      {{ (_cf_current_config.json.result.config.ingress | default([]))
         | rejectattr('hostname', 'defined') | list | first | default({}) }}
    _cf_hostname_rules: >-
      {{ (_cf_current_config.json.result.config.ingress | default([]))
         | selectattr('hostname', 'defined') | list }}
  no_log: true
  when:
    - _cf_k8s_state == 'present'
    - cloudflared_bootstrap_only | bool
    - cloudflared_catch_all_service != ""

- name: Set expected catch-all rule
  ansible.builtin.set_fact:
    _cf_expected_catchall:
      service: "{{ cloudflared_catch_all_service }}"
      originRequest:
        http2Origin: true
        noTLSVerify: true
  when:
    - _cf_k8s_state == 'present'
    - cloudflared_bootstrap_only | bool
    - cloudflared_catch_all_service != ""

- name: Update tunnel catch-all (missing or changed — preserves all hostname routes)
  ansible.builtin.uri:
    url: "https://api.cloudflare.com/client/v4/accounts/{{ cloudflared_account_id }}/cfd_tunnel/{{ cloudflared_tunnel_id }}/configurations"
    method: PUT
    headers:
      Authorization: "Bearer {{ cf_token }}"
      Content-Type: "application/json"
    body_format: json
    body:
      config:
        ingress: "{{ _cf_hostname_rules + [_cf_expected_catchall] }}"
    status_code: 200
  no_log: true
  when:
    - _cf_k8s_state == 'present'
    - cloudflared_bootstrap_only | bool
    - cloudflared_catch_all_service != ""
    - _cf_current_catchall != _cf_expected_catchall

- name: Look up zone ID for ingress CNAME (bootstrap-only mode)
  ansible.builtin.uri:
    url: "https://api.cloudflare.com/client/v4/zones?name={{ cloudflared_domain }}"
    method: GET
    headers:
      Authorization: "Bearer {{ cf_token }}"
    status_code: 200
  register: _bootstrap_zone
  no_log: true
  when:
    - _cf_k8s_state == 'present'
    - cloudflared_bootstrap_only | bool
    - cloudflared_ingress_hostname != ""
    - cloudflared_domain != ""

- name: Check existing CNAME for ingress hostname (bootstrap-only mode)
  ansible.builtin.uri:
    url: >-
      https://api.cloudflare.com/client/v4/zones/{{ _bootstrap_zone.json.result[0].id }}/dns_records?type=CNAME&name={{ cloudflared_ingress_hostname }}
    method: GET
    headers:
      Authorization: "Bearer {{ cf_token }}"
    status_code: 200
  register: _bootstrap_cname_check
  no_log: true
  when:
    - _cf_k8s_state == 'present'
    - cloudflared_bootstrap_only | bool
    - cloudflared_ingress_hostname != ""
    - _bootstrap_zone is defined
    - (_bootstrap_zone.json.result | default([]) | length) > 0

- name: Create ingress CNAME (bootstrap-only mode, new record)
  ansible.builtin.uri:
    url: "https://api.cloudflare.com/client/v4/zones/{{ _bootstrap_zone.json.result[0].id }}/dns_records"
    method: POST
    headers:
      Authorization: "Bearer {{ cf_token }}"
      Content-Type: "application/json"
    body_format: json
    body:
      type: CNAME
      name: "{{ cloudflared_ingress_hostname }}"
      content: "{{ cloudflared_tunnel_id }}.cfargotunnel.com"
      proxied: true
      ttl: 1
    status_code: 200
  no_log: true
  when:
    - _cf_k8s_state == 'present'
    - cloudflared_bootstrap_only | bool
    - cloudflared_ingress_hostname != ""
    - _bootstrap_cname_check is defined
    - (_bootstrap_cname_check.json.result | default([]) | length) == 0

- name: Update ingress CNAME if tunnel target changed (bootstrap-only mode)
  ansible.builtin.uri:
    url: >-
      https://api.cloudflare.com/client/v4/zones/{{ _bootstrap_zone.json.result[0].id }}/dns_records/{{ _bootstrap_cname_check.json.result[0].id }}
    method: PATCH
    headers:
      Authorization: "Bearer {{ cf_token }}"
      Content-Type: "application/json"
    body_format: json
    body:
      content: "{{ cloudflared_tunnel_id }}.cfargotunnel.com"
      proxied: true
    status_code: 200
  no_log: true
  when:
    - _cf_k8s_state == 'present'
    - cloudflared_bootstrap_only | bool
    - cloudflared_ingress_hostname != ""
    - _bootstrap_cname_check is defined
    - (_bootstrap_cname_check.json.result | default([]) | length) > 0
    - _bootstrap_cname_check.json.result[0].content != cloudflared_tunnel_id + '.cfargotunnel.com'

# --- FULL MODE: deploy Deployment to cluster (skipped in bootstrap-only mode) ---
- name: Render cloudflared Deployment
  ansible.builtin.template:
    src: deployment.yaml.j2
    dest: /tmp/cloudflared-deployment.yaml
    mode: '0600'
  when:
    - _cf_k8s_state == 'present'
    - not (cloudflared_bootstrap_only | bool)

- name: Apply cloudflared Deployment to cluster
  ansible.builtin.command: "{{ _kubectl }} apply -f /tmp/cloudflared-deployment.yaml"
  become: "{{ cloudflared_kubectl_become }}"
  environment:
    KUBECONFIG: "{{ cloudflared_kubeconfig_path }}"
  changed_when: true
  when:
    - _cf_k8s_state == 'present'
    - not (cloudflared_bootstrap_only | bool)

- name: Wait for cloudflared rollout to complete
  ansible.builtin.command: >
    {{ _kubectl }} rollout status deployment/cloudflared
    -n {{ cloudflared_namespace }}
    --timeout=120s
  become: "{{ cloudflared_kubectl_become }}"
  environment:
    KUBECONFIG: "{{ cloudflared_kubeconfig_path }}"
  changed_when: false
  when:
    - _cf_k8s_state == 'present'
    - not (cloudflared_bootstrap_only | bool)

# --- ROUTE CONFIGURATION (full mode only, skipped if cloudflared_domain is empty) ---
- name: Wait for tunnel to show active connections
  ansible.builtin.uri:
    url: "https://api.cloudflare.com/client/v4/accounts/{{ cloudflared_account_id }}/cfd_tunnel/{{ cloudflared_tunnel_id }}/connections"
    method: GET
    headers:
      Authorization: "Bearer {{ cf_token }}"
    status_code: 200
  register: _cf_connections
  no_log: true
  until: (_cf_connections.json.result | default([]) | length) > 0
  retries: 18
  delay: 10
  when:
    - _cf_k8s_state == 'present'
    - not (cloudflared_bootstrap_only | bool)
    - cloudflared_domain != ""

- name: Look up Cloudflare zone ID for domain
  ansible.builtin.uri:
    url: "https://api.cloudflare.com/client/v4/zones?name={{ cloudflared_domain }}"
    method: GET
    headers:
      Authorization: "Bearer {{ cf_token }}"
    status_code: 200
  register: _cf_zone
  no_log: true
  when:
    - _cf_k8s_state == 'present'
    - not (cloudflared_bootstrap_only | bool)
    - cloudflared_domain != ""
    - cloudflared_zone_id == ""

- name: Fail if zone not found for domain
  ansible.builtin.fail:
    msg: "No Cloudflare zone found for domain '{{ cloudflared_domain }}'"
  when:
    - _cf_k8s_state == 'present'
    - not (cloudflared_bootstrap_only | bool)
    - cloudflared_domain != ""
    - cloudflared_zone_id == ""
    - (_cf_zone.json.result | default([]) | length) == 0

- name: Set resolved zone ID fact
  ansible.builtin.set_fact:
    _cf_zone_id: >-
      {{ cloudflared_zone_id if cloudflared_zone_id != ''
         else _cf_zone.json.result[0].id }}
  when:
    - _cf_k8s_state == 'present'
    - not (cloudflared_bootstrap_only | bool)
    - cloudflared_domain != ""

- name: Build ingress list from cloudflared_services
  ansible.builtin.set_fact:
    _cf_ingress_routes: >-
      {{ _cf_ingress_routes | default([])
         + [{'hostname': item.subdomain + '.' + cloudflared_domain,
             'service': item.k8s_service}
            | combine({'originRequest': item.origin_request} if item.origin_request is defined else {})] }}
  loop: "{{ cloudflared_services }}"
  when:
    - _cf_k8s_state == 'present'
    - not (cloudflared_bootstrap_only | bool)
    - cloudflared_domain != ""

- name: Configure tunnel ingress routes (managed config PUT)
  ansible.builtin.uri:
    url: "https://api.cloudflare.com/client/v4/accounts/{{ cloudflared_account_id }}/cfd_tunnel/{{ cloudflared_tunnel_id }}/configurations"
    method: PUT
    headers:
      Authorization: "Bearer {{ cf_token }}"
      Content-Type: "application/json"
    body_format: json
    body:
      config:
        ingress: "{{ _cf_ingress_routes + [{'service': 'http_status:404'}] }}"
    status_code: 200
  no_log: true
  when:
    - _cf_k8s_state == 'present'
    - not (cloudflared_bootstrap_only | bool)
    - cloudflared_domain != ""
    - _cf_ingress_routes | default([]) | length > 0

- name: Check existing CNAME DNS records for each service
  ansible.builtin.uri:
    url: "https://api.cloudflare.com/client/v4/zones/{{ _cf_zone_id }}/dns_records?type=CNAME&name={{ item.subdomain }}.{{ cloudflared_domain }}"
    method: GET
    headers:
      Authorization: "Bearer {{ cf_token }}"
    status_code: 200
  register: _cf_dns_check
  no_log: true
  loop: "{{ cloudflared_services }}"
  when:
    - _cf_k8s_state == 'present'
    - not (cloudflared_bootstrap_only | bool)
    - cloudflared_domain != ""

- name: Create CNAME DNS records for new services
  ansible.builtin.uri:
    url: "https://api.cloudflare.com/client/v4/zones/{{ _cf_zone_id }}/dns_records"
    method: POST
    headers:
      Authorization: "Bearer {{ cf_token }}"
      Content-Type: "application/json"
    body_format: json
    body:
      type: CNAME
      name: "{{ item.item.subdomain }}.{{ cloudflared_domain }}"
      content: "{{ cloudflared_tunnel_id }}.cfargotunnel.com"
      proxied: true
      ttl: 1
    status_code: 200
  no_log: true
  loop: "{{ _cf_dns_check.results }}"
  when:
    - _cf_k8s_state == 'present'
    - not (cloudflared_bootstrap_only | bool)
    - cloudflared_domain != ""
    - item.json.result | length == 0

- name: Update CNAME DNS records where tunnel target changed
  ansible.builtin.uri:
    url: "https://api.cloudflare.com/client/v4/zones/{{ _cf_zone_id }}/dns_records/{{ item.json.result[0].id }}"
    method: PATCH
    headers:
      Authorization: "Bearer {{ cf_token }}"
      Content-Type: "application/json"
    body_format: json
    body:
      content: "{{ cloudflared_tunnel_id }}.cfargotunnel.com"
      proxied: true
    status_code: 200
  no_log: true
  loop: "{{ _cf_dns_check.results }}"
  when:
    - _cf_k8s_state == 'present'
    - not (cloudflared_bootstrap_only | bool)
    - cloudflared_domain != ""
    - item.json.result | length > 0
    - item.json.result[0].content != cloudflared_tunnel_id + '.cfargotunnel.com'

# --- ABSENT ---
- name: Tear down cloudflared k8s resources
  ansible.builtin.command: "{{ _kubectl }} delete namespace {{ cloudflared_namespace }}"
  become: "{{ cloudflared_kubectl_become }}"
  environment:
    KUBECONFIG: "{{ cloudflared_kubeconfig_path }}"
  failed_when: false
  changed_when: true
  when: _cf_k8s_state == 'absent'
</file>

<file path="roles/cloudflared-k8s/tasks/onepassword.yml">
---
# Upsert the tunnel credentials into a 1Password item that ESO reads.
#
# There is no lookup-plugin/module to WRITE a 1Password item, so this uses the
# `op` CLI. During ansible-pull the wrapper already exports
# OP_SERVICE_ACCOUNT_TOKEN and puts `op` on PATH, so no token plumbing is
# needed here. For push-mode runs, ensure OP_SERVICE_ACCOUNT_TOKEN is exported
# in the environment ansible runs in.
#
# Item fields: tunnel-id, account-tag (text); tunnel-secret, tunnel-token,
# credentials-json (concealed). ESO pulls `credentials-json` into a k8s Secret
# with key `credentials.json`.

- name: Decode tunnel token
  ansible.builtin.set_fact:
    _cf_token_obj: "{{ tunnel_token_resp.json.result | b64decode | from_json }}"
  no_log: true

- name: Assemble credentials.json blob
  ansible.builtin.set_fact:
    _cf_credentials_json: "{{ {'AccountTag': _cf_token_obj.a, 'TunnelID': _cf_token_obj.t, 'TunnelSecret': _cf_token_obj.s} | to_json }}"
  no_log: true

- name: Field assignments (op `field[type]=value` syntax)
  ansible.builtin.set_fact:
    _op_fields:
      - "tunnel-id[text]={{ _cf_token_obj.t }}"
      - "account-tag[text]={{ _cf_token_obj.a }}"
      - "tunnel-secret[password]={{ _cf_token_obj.s }}"
      - "tunnel-token[password]={{ tunnel_token_resp.json.result }}"
      - "credentials-json[password]={{ _cf_credentials_json }}"
  no_log: true

# Idempotency: does the item already exist? (op exits non-zero if absent)
- name: Look up existing 1Password item
  ansible.builtin.command:
    argv:
      - op
      - item
      - get
      - "{{ cloudflared_op_item_title }}"
      - "--vault={{ cloudflared_op_vault }}"
      - "--format=json"
  register: _op_item_get
  changed_when: false
  failed_when: false
  no_log: true

- name: Create 1Password tunnel item
  ansible.builtin.command:
    argv: >-
      {{ ['op', 'item', 'create',
          '--category=password',
          '--title=' ~ cloudflared_op_item_title,
          '--vault=' ~ cloudflared_op_vault] + _op_fields }}
  register: _op_item_create
  changed_when: true
  no_log: true
  when: _op_item_get.rc != 0

- name: Update 1Password tunnel item
  ansible.builtin.command:
    argv: >-
      {{ ['op', 'item', 'edit',
          cloudflared_op_item_title,
          '--vault=' ~ cloudflared_op_vault] + _op_fields }}
  register: _op_item_edit
  changed_when: true
  no_log: true
  when: _op_item_get.rc == 0
</file>

<file path="roles/cloudflared-k8s/templates/configmap.yaml.j2">
apiVersion: v1
kind: ConfigMap
metadata:
  name: cloudflared-config
  namespace: {{ cloudflared_namespace }}
data:
  config.yaml: |
    tunnel: {{ cloudflared_tunnel_id }}
    credentials-file: /etc/cloudflared/creds/credentials.json
    ingress:
      - hostname: {{ cloudflared_hostname }}
        service: http://{{ cloudflared_upstream_service }}:{{ cloudflared_upstream_port }}
      - service: http_status:404
</file>

<file path="roles/cloudflared-k8s/templates/deployment.yaml.j2">
apiVersion: apps/v1
kind: Deployment
metadata:
  name: cloudflared
  namespace: {{ cloudflared_namespace }}
spec:
  replicas: {{ cloudflared_replicas }}
  selector:
    matchLabels:
      app: cloudflared
  template:
    metadata:
      labels:
        app: cloudflared
    spec:
      containers:
        - name: cloudflared
          image: {{ cloudflared_image }}
          args:
            - tunnel
            - --no-autoupdate
            - run
          env:
            - name: TUNNEL_TOKEN
              valueFrom:
                secretKeyRef:
                  name: cloudflared-creds
                  key: tunnel-token
</file>

<file path="roles/colima/defaults/main.yml">
---
colima_state: present
colima_cpu: 2
colima_memory: 4
colima_disk: 60
colima_runtime: "docker"        # "docker" or "containerd"
colima_kubernetes: false        # true = start with --kubernetes (k3s alongside Docker)
# The user who owns the Colima VM (LaunchDaemon runs as this user).
# For headless operation use the ansible service user.
colima_deployer_user: "{{ ansible_user }}"
# Packages to install in the Lima VM at first boot (kubernetes mode only).
# Runs as a root provision script on VM initialization.
colima_provision_packages:
  - open-iscsi
  - lsscsi
  - sg3-utils
  - multipath-tools
  - scsitools
  - nfs-common
  - jq
# Pin k3s version when using --kubernetes. Must match a k3s release.
# Leave empty to use Colima's default (latest). Set to ensure CSI driver compatibility.
colima_kubernetes_version: ""
</file>

<file path="roles/colima/handlers/main.yml">
---
- name: Restart Colima
  ansible.builtin.command: /opt/homebrew/bin/brew services restart colima
  become: false
  changed_when: true
</file>

<file path="roles/colima/tasks/main.yml">
---
- name: Install Colima and Docker tooling via Homebrew
  community.general.homebrew:
    name: "{{ item }}"
    state: "{{ 'present' if colima_state == 'present' else 'absent' }}"
  loop:
    - colima
    - docker
    - docker-compose
    - bash
    - gnu-sed
  become: false

- name: Ensure PyYAML is available for Ansible's Python (required by flux kubeconfig patcher)
  ansible.builtin.pip:
    name: pyyaml
    state: present
    extra_args: "--break-system-packages"
  become: false
  failed_when: false
  when: colima_state == "present"

- name: Ensure ~/.docker/cli-plugins directory exists
  ansible.builtin.file:
    path: "/Users/{{ ansible_user }}/.docker/cli-plugins"
    state: directory
    mode: "0755"
  become: false
  when:
    - colima_state == "present"
    - colima_runtime == "docker"

- name: Set up Docker Compose v2 as Docker CLI plugin
  ansible.builtin.file:
    src: /opt/homebrew/opt/docker-compose/bin/docker-compose
    dest: "/Users/{{ ansible_user }}/.docker/cli-plugins/docker-compose"
    state: link
  become: false
  when:
    - colima_state == "present"
    - colima_runtime == "docker"

# ── k3s runtime: write Lima config before first start ────────────────────────
- name: Ensure Colima default profile config directory exists (k3s runtime)
  ansible.builtin.file:
    path: "/var/{{ colima_deployer_user }}/.colima/default"
    state: directory
    owner: "{{ colima_deployer_user }}"
    group: admin
    mode: "0755"
  become: true
  when:
    - colima_state == "present"
    - colima_kubernetes | default(false)

- name: Write Colima Lima config with provision block (k3s runtime, first run only)
  ansible.builtin.template:
    src: colima-config.yaml.j2
    dest: "/var/{{ colima_deployer_user }}/.colima/default/colima.yaml"
    owner: "{{ colima_deployer_user }}"
    group: admin
    mode: "0644"
  become: true
  when:
    - colima_state == "present"
    - colima_kubernetes | default(false)

# ── Initialize the Colima VM ─────────────────────────────────────────────────
- name: Initialize Colima VM with configured resources (docker runtime, first run only)
  ansible.builtin.command: >
    /opt/homebrew/bin/colima start
    --cpu {{ colima_cpu }}
    --memory {{ colima_memory }}
    --disk {{ colima_disk }}
    --foreground=false
  register: _colima_init
  changed_when: "'already running' not in (_colima_init.stderr | default('')) and _colima_init.rc == 0"
  failed_when:
    - _colima_init.rc != 0
    - "'already running' not in (_colima_init.stderr | default(''))"
  become: false
  when:
    - colima_state == "present"
    - colima_runtime == "docker"
    - not (colima_kubernetes | default(false))

- name: Initialize Colima VM with Kubernetes (--kubernetes flag, first run, downloads VM image)
  ansible.builtin.command: >
    /opt/homebrew/bin/colima start
    --kubernetes
    {% if colima_kubernetes_version | default('') != '' %}--kubernetes-version {{ colima_kubernetes_version }}{% endif %}
    --cpu {{ colima_cpu }}
    --memory {{ colima_memory }}
    --disk {{ colima_disk }}
    --foreground=false
  register: _colima_k3s_init
  changed_when: "'already running' not in (_colima_k3s_init.stderr | default('')) and _colima_k3s_init.rc == 0"
  failed_when:
    - _colima_k3s_init.rc != 0
    - "'already running' not in (_colima_k3s_init.stderr | default(''))"
  become: true
  become_user: "{{ colima_deployer_user }}"
  environment:
    HOME: "/var/{{ colima_deployer_user }}"
    PATH: "/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin"
  when:
    - colima_state == "present"
    - colima_kubernetes | default(false)

# ── Legacy docker runtime: user LaunchAgent (brew services) ──────────────────
- name: Start Colima as user LaunchAgent (docker runtime only)
  ansible.builtin.command: >
    /opt/homebrew/bin/brew services start colima
  register: _colima_start
  changed_when: "'Successfully started' in _colima_start.stdout"
  failed_when:
    - _colima_start.rc != 0
    - "'already started' not in (_colima_start.stderr | default(''))"
    - "'Bootstrap failed' not in (_colima_start.stderr | default(''))"
  become: false
  when:
    - colima_state == "present"
    - colima_runtime == "docker"
    - not (colima_kubernetes | default(false))

# ── Kubernetes mode: system LaunchDaemon (headless, persists without login) ──
- name: Deploy Colima system LaunchDaemon plist (k3s runtime)
  ansible.builtin.template:
    src: colima-launchdaemon.plist.j2
    dest: /Library/LaunchDaemons/com.olympus.colima.plist
    owner: root
    group: wheel
    mode: "0644"
  become: true
  register: _colima_daemon_plist
  when:
    - colima_state == "present"
    - colima_kubernetes | default(false)

- name: Reload Colima LaunchDaemon after plist change (k3s runtime)
  ansible.builtin.shell: |
    launchctl bootout system /Library/LaunchDaemons/com.olympus.colima.plist 2>/dev/null || true
    launchctl bootstrap system /Library/LaunchDaemons/com.olympus.colima.plist
  become: true
  changed_when: true
  when:
    - colima_state == "present"
    - colima_kubernetes | default(false)
    - _colima_daemon_plist.changed

# ── Absent path ───────────────────────────────────────────────────────────────
- name: Stop Colima (docker runtime)
  ansible.builtin.command: /opt/homebrew/bin/brew services stop colima
  register: _colima_stop
  failed_when: false
  changed_when: "'Successfully stopped' in _colima_stop.stdout"
  become: false
  when:
    - colima_state == "absent"
    - colima_runtime == "docker"

- name: Unload and remove Colima LaunchDaemon (k3s runtime)
  ansible.builtin.shell: |
    launchctl bootout system /Library/LaunchDaemons/com.olympus.colima.plist 2>/dev/null || true
    rm -f /Library/LaunchDaemons/com.olympus.colima.plist
  become: true
  failed_when: false
  changed_when: true
  when:
    - colima_state == "absent"
    - colima_kubernetes | default(false)

# ── docker.sock symlink (docker runtime only) ─────────────────────────────────
- name: Create /var/run/docker.sock symlink pointing at Colima socket (macOS, docker runtime)
  ansible.builtin.file:
    src: "/var/{{ colima_deployer_user }}/.colima/default/docker.sock"
    dest: /var/run/docker.sock
    state: link
    force: true
  become: true
  when:
    - colima_state == "present"
    - ansible_facts['os_family'] == "Darwin"
    - colima_runtime == "docker"
</file>

<file path="roles/colima/templates/colima-config.yaml.j2">
cpu: {{ colima_cpu }}
memory: {{ colima_memory }}
disk: {{ colima_disk }}
runtime: {{ colima_runtime }}
{% if colima_kubernetes | default(false) %}
kubernetes:
  enabled: true
provision:
  - mode: system
    script: |
      #!/bin/bash
      set -euo pipefail
      export DEBIAN_FRONTEND=noninteractive
      apt-get update -q
      apt-get install -y {{ colima_provision_packages | join(' ') }}
      modprobe iscsi_tcp || true
      modprobe dm-multipath || true
      printf 'fs.inotify.max_user_instances=8192\nfs.inotify.max_user_watches=1048576\nfs.file-max=2097152\nvm.max_map_count=262144\nnet.ipv4.ip_forward=1\n' > /etc/sysctl.d/99-olympus.conf
      sysctl -p /etc/sysctl.d/99-olympus.conf
      printf '* soft nofile 1048576\n* hard nofile 1048576\nroot soft nofile 1048576\nroot hard nofile 1048576\n' >> /etc/security/limits.conf
      printf 'tls-san:\n  - ai-hub.nwlnexus.net\nwrite-kubeconfig-mode: "0644"\n' > /etc/rancher/k3s/config.yaml
{% endif %}
</file>

