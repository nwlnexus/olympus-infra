</file>

<file path="roles/node-prereqs/tasks/main.yml">
---
# node-prereqs role — installs packages, kernel modules, and basic hardening
# required for k3s HA nodes with Longhorn + democratic-csi (iSCSI) storage.

- name: Install prerequisite packages
  ansible.builtin.apt:
    name: "{{ _node_prereqs_packages + (node_prereqs_extra_packages | default([])) }}"
    state: "{{ 'present' if node_prereqs_state == 'present' else 'absent' }}"
    update_cache: true
  become: true
  vars:
    _node_prereqs_packages:
      # iSCSI — required by Longhorn (thin provisioning) and democratic-csi (QNAP SAN)
      - open-iscsi
      # NFS client — required by Longhorn RWX (NFS-backed ReadWriteMany volumes)
      - nfs-common
      # LVM — required for device management by Longhorn / Rook
      - lvm2
      # iSCSI multipath — for QNAP iSCSI multi-path I/O
      - multipath-tools
      # Kernel modules for iSCSI (module names vary; package covers the running kernel)
      - "linux-modules-extra-{{ ansible_facts['kernel'] }}"
      # Basic tooling
      - curl
      - wget
      - git
      - jq
      - htop
      - tmux
      - rsync
      # Security
      - fail2ban

- name: Enable and start iscsid
  ansible.builtin.systemd:
    name: iscsid
    enabled: true
    state: started
  become: true
  when: node_prereqs_state == 'present'

- name: Enable and start multipathd
  ansible.builtin.systemd:
    name: multipathd
    enabled: true
    state: started
  become: true
  when: node_prereqs_state == 'present'
  failed_when: false   # may not be present on all kernels

# ── Kernel modules ────────────────────────────────────────────────────────────

- name: Load iSCSI kernel module
  community.general.modprobe:
    name: iscsi_tcp
    state: present
  become: true
  when: node_prereqs_state == 'present'

- name: Load dm_multipath kernel module
  community.general.modprobe:
    name: dm_multipath
    state: present
  become: true
  when: node_prereqs_state == 'present'
  failed_when: false

- name: Persist kernel modules across reboots
  ansible.builtin.copy:
    dest: /etc/modules-load.d/olympus.conf
    content: |
      # Loaded by Ansible (node-prereqs role) — do not edit manually
      iscsi_tcp
      dm_multipath
    owner: root
    group: root
    mode: "0644"
  become: true
  when: node_prereqs_state == 'present'

# ── Security hardening ────────────────────────────────────────────────────────

# UFW is intentionally left disabled — Tailscale enforces network policy.
# Enabling UFW would require explicit rules for k3s inter-node traffic.
- name: Disable UFW (Tailscale handles network policy)
  ansible.builtin.command: ufw disable
  become: true
  changed_when: false
  failed_when: false
  when: node_prereqs_state == 'present'

- name: Enable and start fail2ban
  ansible.builtin.systemd:
    name: fail2ban
    enabled: true
    state: started
  become: true
  when:
    - node_prereqs_state == 'present'
    - node_prereqs_fail2ban
</file>

<file path="roles/ollama/defaults/main.yml">
---
ollama_state: present
# Homebrew package state: `latest` keeps ollama current (upgrades on each run);
# `present` installs-but-never-upgrades. ai-hub tracks `latest` so the MLX/GGUF
# runners stay patched (0.20.2 shipped an MLX prefix-cache crash that broke
# multi-turn agentic runs — verified fixed on 0.30.11, the version ai-hub now runs).
ollama_pkg_state: latest
ollama_models: []
ollama_service_port: 11434
# Residency/throughput tuning. 24h keeps the mem0 write path warm: nomic (embed) +
# llama3.2:3b (categorize) + qwen2.5:7b-instruct (extraction). MAX_LOADED_MODELS=3
# holds those three co-resident (~0.4G + 2G + 5G). The coding model qwen3.6:27b-mlx
# (~19G) is NOT warmed — it loads on demand when a coding job dispatches, evicting an
# idle model. So at any moment either the mem0 trio or (mem0 + coding) is resident.
ollama_keep_alive: "24h"
ollama_max_loaded_models: 3
# NUM_PARALLEL=1. Two distinct workloads on this box: (1) mem0 fact-extraction —
# qwen2.5:7b-instruct, fast + NON-thinking (see below), and (2) agentic coding —
# qwen3.6:27b-mlx (thinking, 262K ctx). Kept split because qwen3.6-mlx's mandatory
# thinking makes extraction ~28s+/call, which blocks OpenMemory's single uvicorn
# worker past its ~180s liveness probe → pod SIGKILL. qwen2.5:7b extracts in seconds.
# At 1 there's no per-slot KV balloon; the coding model gets full context.
ollama_num_parallel: 1
# Models warmed after a (re)start so the first real request is hot. Must be a subset
# of ollama_models. Warm the mem0 path only; the ~19G coding model loads on demand.
ollama_generate_warmup_models:
  - "llama3.2:3b"
  - "qwen2.5:7b-instruct"
ollama_embed_warmup_models:
  - "nomic-embed-text"
</file>

<file path="roles/ollama/tasks/main.yml">
---
- name: Install/upgrade Ollama via Homebrew
  community.general.homebrew:
    name: ollama
    # ollama_pkg_state (default `latest`) drives whether present installs stay
    # pinned or track upstream. Absent when the role is disabled.
    state: "{{ ollama_pkg_state if ollama_state == 'present' else 'absent' }}"
  register: ollama_pkg

# Legacy duplicate: an earlier data-services role installed a second LaunchDaemon
# (com.olympus.ollama) that loops failing to bind :11434 (homebrew.mxcl.ollama,
# this role, owns it). Bootout + remove it so only this role manages Ollama.
- name: Bootout stray com.olympus.ollama LaunchDaemon (legacy duplicate)
  ansible.builtin.command: launchctl bootout system/com.olympus.ollama
  become: true
  failed_when: false
  changed_when: false
  when: ollama_state == "present"

- name: Remove stray com.olympus.ollama plist (superseded by homebrew.mxcl.ollama)
  ansible.builtin.file:
    path: /Library/LaunchDaemons/com.olympus.ollama.plist
    state: absent
  become: true
  when: ollama_state == "present"

- name: Deploy Ollama wrapper script
  ansible.builtin.template:
    src: ollama-serve.j2
    dest: /usr/local/bin/ollama-serve
    owner: root
    group: wheel
    mode: "0755"
  become: true
  when: ollama_state == "present"
  register: ollama_wrapper

- name: Deploy Ollama LaunchDaemon plist
  ansible.builtin.template:
    src: ollama.plist.j2
    dest: /Library/LaunchDaemons/homebrew.mxcl.ollama.plist
    owner: root
    group: wheel
    mode: "0644"
  become: true
  when: ollama_state == "present"
  register: ollama_plist

# `launchctl bootout` is asynchronous: it returns before teardown finishes, so a
# bootstrap fired immediately after races the still-unloading service and fails with
# "Bootstrap failed: 5: Input/output error". Bundle bootout+bootstrap into one block
# and retry until the bootstrap actually takes (rc 0), which it does once teardown
# settles. `bootout || true` tolerates the service not being loaded on the first pass.
- name: Reload Ollama LaunchDaemon (bootout is async — retry bootstrap until it takes)
  ansible.builtin.shell: |
    launchctl bootout system/homebrew.mxcl.ollama 2>/dev/null || true
    launchctl bootstrap system /Library/LaunchDaemons/homebrew.mxcl.ollama.plist
  become: true
  register: ollama_reload
  changed_when: true
  retries: 5
  delay: 3
  until: ollama_reload.rc == 0
  when:
    - ollama_state == "present"
    - ollama_plist is changed or ollama_wrapper is changed or ollama_pkg is changed

# Unchanged run: normally just kickstart the loaded daemon. But if a prior run left it
# down (e.g. a bootstrap that failed the race before this fix), bootstrap it instead of
# kickstarting a service that isn't loaded — otherwise the readiness poll below times out.
- name: Ensure Ollama LaunchDaemon is running (bootstrap if absent, else kickstart)
  ansible.builtin.shell: |
    if launchctl print system/homebrew.mxcl.ollama >/dev/null 2>&1; then
      launchctl kickstart system/homebrew.mxcl.ollama
    else
      launchctl bootstrap system /Library/LaunchDaemons/homebrew.mxcl.ollama.plist
    fi
  become: true
  changed_when: false
  when:
    - ollama_state == "present"
    - ollama_plist is not changed and ollama_wrapper is not changed and ollama_pkg is not changed

- name: Remove Ollama LaunchDaemon
  ansible.builtin.command: launchctl bootout system /Library/LaunchDaemons/homebrew.mxcl.ollama.plist
  become: true
  failed_when: false
  changed_when: true
  when: ollama_state == "absent"

- name: Remove Ollama LaunchDaemon plist and wrapper
  ansible.builtin.file:
    path: "{{ item }}"
    state: absent
  become: true
  loop:
    - /Library/LaunchDaemons/homebrew.mxcl.ollama.plist
    - /usr/local/bin/ollama-serve
  when: ollama_state == "absent"

- name: Wait for Ollama to be ready
  ansible.builtin.uri:
    url: "http://localhost:{{ ollama_service_port }}/api/tags"
    method: GET
  register: ollama_ready
  until: ollama_ready.status == 200
  retries: 24
  delay: 5
  when: ollama_state == "present"

- name: Get list of already-pulled models
  ansible.builtin.uri:
    url: "http://localhost:{{ ollama_service_port }}/api/tags"
    method: GET
    return_content: true
  register: ollama_models_response
  when: ollama_state == "present"

- name: Set pulled model names
  ansible.builtin.set_fact:
    ollama_pulled_models: >-
      {{ ollama_models_response.json.models | map(attribute='name') | list }}
  when: ollama_state == "present"

- name: Pull Ollama models
  ansible.builtin.shell: |
    /opt/homebrew/bin/ollama pull {{ item }} \
      > ~/.ollama/pull-{{ item | replace(':', '-') | replace('/', '-') }}.log 2>&1
  loop: "{{ ollama_models }}"
  when:
    - ollama_state == "present"
    - item not in ollama_pulled_models
  changed_when: true
  timeout: 7200

# Warm models so the first interactive add doesn't pay a cold load. Runs after
# the readiness poll and model pull above, so Ollama is up and models exist.
- name: Warm up Ollama generation models
  ansible.builtin.uri:
    url: "http://localhost:{{ ollama_service_port }}/api/generate"
    method: POST
    body_format: json
    body:
      model: "{{ item }}"
      prompt: "ok"
      stream: false
      keep_alive: "{{ ollama_keep_alive }}"
    status_code: [200]
    timeout: 300
  loop: "{{ ollama_generate_warmup_models }}"
  changed_when: false
  when: ollama_state == "present"

- name: Warm up Ollama embedding models
  ansible.builtin.uri:
    url: "http://localhost:{{ ollama_service_port }}/api/embeddings"
    method: POST
    body_format: json
    body:
      model: "{{ item }}"
      prompt: "ok"
      keep_alive: "{{ ollama_keep_alive }}"
    status_code: [200]
    timeout: 300
  loop: "{{ ollama_embed_warmup_models }}"
  changed_when: false
  when: ollama_state == "present"
</file>

<file path="roles/ollama/templates/ollama-serve.j2">
#!/bin/bash
# Wrapper to run Ollama as {{ ansible_user }} from a root LaunchDaemon.
# OLLAMA_HOST=0.0.0.0 binds all interfaces so the tailnet (and k3s pods via the
# ai-hub tailnet route) can reach the API — required by the mem0/OpenMemory platform.
exec sudo -Hu {{ ansible_user }} /usr/bin/env \
  OLLAMA_HOST=0.0.0.0:{{ ollama_service_port }} \
  OLLAMA_KEEP_ALIVE={{ ollama_keep_alive }} \
  OLLAMA_MAX_LOADED_MODELS={{ ollama_max_loaded_models }} \
  OLLAMA_NUM_PARALLEL={{ ollama_num_parallel }} \
  /opt/homebrew/bin/ollama serve
</file>

