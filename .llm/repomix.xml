<file path="roles/argocd/defaults/main.yml">
---
argocd_state: present
# Kubeconfig used when installing/uninstalling ArgoCD itself (management-hub k3s)
k3s_kubeconfig_path: "/etc/rancher/k3s/k3s.yaml"
argocd_namespace: argocd
argocd_chart_version: "7.7.0"   # Helm chart version for ArgoCD 2.13.x
argocd_server: ""               # external hostname (set in group_vars)
argocd_nodeport: 30080          # NodePort for argocd-server HTTP (Tailscale-accessible)
# Run ArgoCD server in insecure mode (HTTP, no TLS). Set false for pass-2 TLS bootstrap.
argocd_insecure: true
# URL used for argocd CLI login during cluster registration.
# Defaults to management Tailscale IP + NodePort; override in host_vars if needed.
argocd_login_server: "{{ management_tailscale_ip }}:{{ argocd_nodeport }}"
# Cluster registration (set to true when running on ai-hub)
argocd_register_cluster: false
argocd_cluster_name: ""
argocd_cluster_context: ""
# Hostname of the management device as registered in Tailscale (used for dynamic IP lookup)
argocd_management_hostname: "management-hub"
# management_tailscale_ip is resolved dynamically via Tailscale API during cluster registration
management_tailscale_ip: ""
# GitOps repo for App of Apps (set in host_vars for ai-hub)
argocd_gitops_repo: ""
argocd_gitops_revision: main
# List of ArgoCD Applications to create (remote cluster registration OR local cluster).
# Each: { name, path, dest_namespace, sync_wave }
argocd_apps: []
# Create ArgoCD Applications on the LOCAL cluster (management-hub, where ArgoCD is installed).
# When true: installs argocd CLI and creates apps with dest-server=kubernetes.default.svc.
argocd_create_local_apps: false
# Upload kubeconfig to 1Password after ArgoCD install.
# Set to the 1Password item title (e.g. "management-hub-kubeconfig").
# Requires op CLI and OP_CONNECT_HOST / OP_CONNECT_TOKEN in environment.
argocd_kubeconfig_1password_item: ""
argocd_kubeconfig_1password_vault: "Dev"
# Labels applied to all ArgoCD Applications created by this role.
# cluster label identifies which cluster the app targets.
# app label is derived automatically from the path basename.
argocd_cluster_label: ""
# Public hostname for Traefik IngressRoute (set in host_vars to enable)
argocd_hostname: ""
</file>

<file path="roles/argocd/tasks/main.yml">
---
- name: Set argocd state
  ansible.builtin.set_fact:
    _argocd_state: "{{ argocd_state | default('present') }}"

- name: Add ArgoCD Helm repo
  ansible.builtin.command: >
    helm repo add argo https://argoproj.github.io/argo-helm
  register: repo_add
  changed_when: "'already exists' not in repo_add.stderr"
  become: true
  when: _argocd_state == 'present'

- name: Update Helm repos
  ansible.builtin.command: helm repo update
  become: true
  changed_when: false
  when: _argocd_state == 'present'

- name: Create argocd namespace
  ansible.builtin.command: kubectl create namespace {{ argocd_namespace }}
  register: ns_create
  failed_when:
    - ns_create.rc != 0
    - "'already exists' not in ns_create.stderr"
  changed_when: ns_create.rc == 0
  become: true
  environment:
    KUBECONFIG: "{{ k3s_kubeconfig_path }}"
  when: _argocd_state == 'present'

- name: Install ArgoCD via Helm
  ansible.builtin.command: >
    helm upgrade --install argocd argo/argo-cd
    --namespace {{ argocd_namespace }}
    --version {{ argocd_chart_version }}
    --set server.service.type=NodePort
    --set server.service.nodePortHttp={{ argocd_nodeport | default(30080) }}
    {{ '--set configs.params."server\\.insecure"=true' if argocd_insecure | bool else '' }}
    --wait --timeout 5m
  become: true
  environment:
    KUBECONFIG: "{{ k3s_kubeconfig_path }}"
  changed_when: true
  when: _argocd_state == 'present'

- name: Restart ArgoCD server to pick up ConfigMap changes
  ansible.builtin.command: kubectl rollout restart deployment/argocd-server -n {{ argocd_namespace }}
  become: true
  environment:
    KUBECONFIG: "{{ k3s_kubeconfig_path }}"
  changed_when: true
  when: _argocd_state == 'present'

- name: Wait for ArgoCD server rollout
  ansible.builtin.command: kubectl rollout status deployment/argocd-server -n {{ argocd_namespace }} --timeout=120s
  become: true
  environment:
    KUBECONFIG: "{{ k3s_kubeconfig_path }}"
  changed_when: false
  when: _argocd_state == 'present'

- name: Get ArgoCD initial admin password
  ansible.builtin.shell: |
    set -o pipefail
    kubectl -n {{ argocd_namespace }} get secret argocd-initial-admin-secret \
      -o jsonpath="{.data.password}" | base64 -d
  args:
    executable: /bin/bash
  become: true
  environment:
    KUBECONFIG: "{{ k3s_kubeconfig_path }}"
  register: argocd_initial_password
  changed_when: false
  when: _argocd_state == 'present'

- name: Print ArgoCD initial admin password
  ansible.builtin.debug:
    msg: "ArgoCD initial admin password: {{ argocd_initial_password.stdout }}"
  when: _argocd_state == 'present'

- name: Store ArgoCD admin password in 1Password
  ansible.builtin.shell: |
    set -o pipefail
    _item="{{ argocd_1password_item | default('olympus-sdk-argocd') }}"
    _vault="{{ argocd_kubeconfig_1password_vault | default('Dev') }}"
    if /opt/homebrew/bin/op item get "${_item}" --vault="${_vault}" >/dev/null 2>&1; then
      /opt/homebrew/bin/op item edit "{{ argocd_1password_item | default('olympus-sdk-argocd') }}" \
        --vault={{ argocd_kubeconfig_1password_vault | default('Dev') }} \
        "password[password]={{ argocd_initial_password.stdout | trim }}"
    else
      /opt/homebrew/bin/op item create \
        --category=Login \
        --title="{{ argocd_1password_item | default('olympus-sdk-argocd') }}" \
        --vault={{ argocd_kubeconfig_1password_vault | default('Dev') }} \
        "username[username]=admin" \
        "password[password]={{ argocd_initial_password.stdout | trim }}"
    fi
  args:
    executable: /bin/bash
  delegate_to: localhost
  become: false
  no_log: true
  changed_when: true
  ignore_errors: true
  environment:
    OP_SERVICE_ACCOUNT_TOKEN: "{{ op_service_account_token | default('') }}"
  when:
    - _argocd_state == 'present'
    - argocd_initial_password.stdout | default('') != ''

# --- TRAEFIK INGRESSROUTE ---
- name: Render ArgoCD Traefik IngressRoute
  ansible.builtin.template:
    src: traefik-ingressroute.yaml.j2
    dest: /tmp/argocd-ingressroute.yaml
    mode: '0600'
  when:
    - _argocd_state == 'present'
    - argocd_hostname != ""

- name: Apply ArgoCD Traefik IngressRoute
  ansible.builtin.command: kubectl apply -f /tmp/argocd-ingressroute.yaml
  become: true
  environment:
    KUBECONFIG: "{{ k3s_kubeconfig_path }}"
  changed_when: true
  when:
    - _argocd_state == 'present'
    - argocd_hostname != ""

# --- KUBECONFIG UPLOAD TO 1PASSWORD ---
# Runs on localhost (control machine) where op CLI is available.
# Slurps the kubeconfig from the remote host first.
- name: Read kubeconfig from remote host
  ansible.builtin.slurp:
    src: "{{ k3s_kubeconfig_path }}"
  register: _remote_kubeconfig
  become: true
  no_log: true
  when:
    - _argocd_state == 'present'
    - argocd_kubeconfig_1password_item != ""

- name: Patch kubeconfig server URL for external distribution
  ansible.builtin.set_fact:
    _kubeconfig_for_upload: >-
      {{ (_remote_kubeconfig.content | b64decode)
         | regex_replace('server: https://127\.0\.0\.1:6443',
                         'server: https://' + k3s_external_server + ':6443') }}
  no_log: true
  when:
    - _argocd_state == 'present'
    - argocd_kubeconfig_1password_item != ""
    - k3s_external_server | default('') != ''

- name: Use raw kubeconfig if no external server configured
  ansible.builtin.set_fact:
    _kubeconfig_for_upload: "{{ _remote_kubeconfig.content | b64decode }}"
  no_log: true
  when:
    - _argocd_state == 'present'
    - argocd_kubeconfig_1password_item != ""
    - k3s_external_server | default('') == ''

# Store kubeconfig as a 1Password Document (handles multiline content reliably).
# op document create/edit avoids shell-escaping issues with $(cat ...) substitution.

- name: Write kubeconfig to temp file on localhost
  ansible.builtin.copy:
    content: "{{ _kubeconfig_for_upload }}"
    dest: "/tmp/{{ argocd_kubeconfig_1password_item }}.yaml"
    mode: '0600'
  delegate_to: localhost
  become: false
  no_log: true
  when:
    - _argocd_state == 'present'
    - argocd_kubeconfig_1password_item != ""

- name: Check if kubeconfig document already exists in 1Password
  ansible.builtin.command: >
    /opt/homebrew/bin/op document get "{{ argocd_kubeconfig_1password_item }}"
    --vault {{ argocd_kubeconfig_1password_vault }}
  register: _op_kubeconfig_check
  failed_when: false
  changed_when: false
  delegate_to: localhost
  become: false
  environment:
    OP_SERVICE_ACCOUNT_TOKEN: "{{ op_service_account_token | default('') }}"
  when:
    - _argocd_state == 'present'
    - argocd_kubeconfig_1password_item != ""

- name: Create kubeconfig document in 1Password
  ansible.builtin.command: >
    /opt/homebrew/bin/op document create /tmp/{{ argocd_kubeconfig_1password_item }}.yaml
    --title "{{ argocd_kubeconfig_1password_item }}"
    --vault {{ argocd_kubeconfig_1password_vault }}
    --file-name kubeconfig
  delegate_to: localhost
  become: false
  no_log: true
  changed_when: true
  environment:
    OP_SERVICE_ACCOUNT_TOKEN: "{{ op_service_account_token | default('') }}"
  when:
    - _argocd_state == 'present'
    - argocd_kubeconfig_1password_item != ""
    - _op_kubeconfig_check.rc != 0

- name: Update kubeconfig document in 1Password
  ansible.builtin.command: >
    /opt/homebrew/bin/op document edit "{{ argocd_kubeconfig_1password_item }}"
    /tmp/{{ argocd_kubeconfig_1password_item }}.yaml
    --vault {{ argocd_kubeconfig_1password_vault }}
    --file-name kubeconfig
  delegate_to: localhost
  become: false
  no_log: true
  changed_when: true
  environment:
    OP_SERVICE_ACCOUNT_TOKEN: "{{ op_service_account_token | default('') }}"
  when:
    - _argocd_state == 'present'
    - argocd_kubeconfig_1password_item != ""
    - _op_kubeconfig_check.rc == 0

- name: Remove temp kubeconfig file from localhost
  ansible.builtin.file:
    path: "/tmp/{{ argocd_kubeconfig_1password_item }}.yaml"
    state: absent
  delegate_to: localhost
  become: false
  when:
    - _argocd_state == 'present'
    - argocd_kubeconfig_1password_item != ""

# --- TAILNET KUBECONFIG UPLOAD TO 1PASSWORD ---
# Same as above but patches server URL to the Tailscale MagicDNS FQDN.
# Useful for connecting directly over Tailscale without going through public DNS.

- name: Resolve tailnet server (explicit var or dynamic fact from k3s role)
  ansible.builtin.set_fact:
    _resolved_tailnet_server: "{{ argocd_tailnet_server | default(k3s_tailscale_fqdn | default('')) }}"
  when: _argocd_state == 'present'

- name: Patch kubeconfig server URL for tailnet distribution
  ansible.builtin.set_fact:
    _tailnet_kubeconfig_for_upload: >-
      {{ (_remote_kubeconfig.content | b64decode)
         | regex_replace('server: https://127\.0\.0\.1:6443',
                         'server: https://' + _resolved_tailnet_server + ':6443') }}
  no_log: true
  when:
    - _argocd_state == 'present'
    - argocd_tailnet_kubeconfig_1password_item | default('') != ''
    - _resolved_tailnet_server | default('') != ''

- name: Write tailnet kubeconfig to temp file on localhost
  ansible.builtin.copy:
    content: "{{ _tailnet_kubeconfig_for_upload }}"
    dest: "/tmp/{{ argocd_tailnet_kubeconfig_1password_item }}.yaml"
    mode: '0600'
  delegate_to: localhost
  become: false
  no_log: true
  when:
    - _argocd_state == 'present'
    - argocd_tailnet_kubeconfig_1password_item | default('') != ''
    - _resolved_tailnet_server | default('') != ''

- name: Check if tailnet kubeconfig document already exists in 1Password
  ansible.builtin.command: >
    /opt/homebrew/bin/op document get "{{ argocd_tailnet_kubeconfig_1password_item }}"
    --vault {{ argocd_kubeconfig_1password_vault | default('Dev') }}
  register: _op_tailnet_kubeconfig_check
  failed_when: false
  changed_when: false
  delegate_to: localhost
  become: false
  environment:
    OP_SERVICE_ACCOUNT_TOKEN: "{{ op_service_account_token | default('') }}"
  when:
    - _argocd_state == 'present'
    - argocd_tailnet_kubeconfig_1password_item | default('') != ''

- name: Create tailnet kubeconfig document in 1Password
  ansible.builtin.command: >
    /opt/homebrew/bin/op document create /tmp/{{ argocd_tailnet_kubeconfig_1password_item }}.yaml
    --title "{{ argocd_tailnet_kubeconfig_1password_item }}"
    --vault {{ argocd_kubeconfig_1password_vault | default('Dev') }}
    --file-name kubeconfig
  delegate_to: localhost
  become: false
  no_log: true
  changed_when: true
  environment:
    OP_SERVICE_ACCOUNT_TOKEN: "{{ op_service_account_token | default('') }}"
  when:
    - _argocd_state == 'present'
    - argocd_tailnet_kubeconfig_1password_item | default('') != ''
    - _resolved_tailnet_server | default('') != ''
    - _op_tailnet_kubeconfig_check.rc != 0

- name: Update tailnet kubeconfig document in 1Password
  ansible.builtin.command: >
    /opt/homebrew/bin/op document edit "{{ argocd_tailnet_kubeconfig_1password_item }}"
    /tmp/{{ argocd_tailnet_kubeconfig_1password_item }}.yaml
    --vault {{ argocd_kubeconfig_1password_vault | default('Dev') }}
    --file-name kubeconfig
  delegate_to: localhost
  become: false
  no_log: true
  changed_when: true
  environment:
    OP_SERVICE_ACCOUNT_TOKEN: "{{ op_service_account_token | default('') }}"
  when:
    - _argocd_state == 'present'
    - argocd_tailnet_kubeconfig_1password_item | default('') != ''
    - _resolved_tailnet_server | default('') != ''
    - _op_tailnet_kubeconfig_check.rc == 0

- name: Remove temp tailnet kubeconfig file from localhost
  ansible.builtin.file:
    path: "/tmp/{{ argocd_tailnet_kubeconfig_1password_item }}.yaml"
    state: absent
  delegate_to: localhost
  become: false
  when:
    - _argocd_state == 'present'
    - argocd_tailnet_kubeconfig_1password_item | default('') != ''

# --- ARGOCD KUSTOMIZE / HELM / OCI SUPPORT ---
# argocd-cm:   kustomize --enable-helm (render helmCharts entries in kustomization.yaml)
# argocd-cmd-params-cm: helm.enableOci (allow OCI Helm repos as direct chart sources)
- name: Patch ArgoCD ConfigMap — kustomize + Helm + OCI
  ansible.builtin.shell: |
    set -o pipefail
    kubectl -n {{ argocd_namespace }} patch configmap argocd-cm \
      --type merge \
      -p '{"data":{"kustomize.buildOptions":"--enable-helm"}}'
    kubectl -n {{ argocd_namespace }} patch configmap argocd-cmd-params-cm \
      --type merge \
      -p '{"data":{"helm.enabled":"true","helm.enableOci":"true"}}'
  args:
    executable: /bin/bash
  become: true
  environment:
    KUBECONFIG: "{{ k3s_kubeconfig_path }}"
  changed_when: true
  register: _argocd_cm_patch
  when:
    - _argocd_state == 'present'
    - argocd_create_local_apps | bool

- name: Restart ArgoCD repo-server to pick up config changes
  ansible.builtin.command: >
    kubectl rollout restart deployment/argocd-repo-server -n {{ argocd_namespace }}
  become: true
  environment:
    KUBECONFIG: "{{ k3s_kubeconfig_path }}"
  changed_when: true
  when:
    - _argocd_state == 'present'
    - argocd_create_local_apps | bool
    - _argocd_cm_patch.changed

- name: Wait for ArgoCD repo-server restart
  ansible.builtin.command: >
    kubectl rollout status deployment/argocd-repo-server -n {{ argocd_namespace }} --timeout=60s
  become: true
  environment:
    KUBECONFIG: "{{ k3s_kubeconfig_path }}"
  changed_when: false
  when:
    - _argocd_state == 'present'
    - argocd_create_local_apps | bool
    - _argocd_cm_patch.changed

# --- LOCAL CLUSTER APP CREATION ---
# Creates ArgoCD Applications pointing to the local cluster (https://kubernetes.default.svc).
# Used on management-hub to bootstrap foundation services via GitOps.

- name: Install argocd CLI (Linux, for local app creation)
  ansible.builtin.shell: |
    set -o pipefail
    VERSION=$(curl -sL https://api.github.com/repos/argoproj/argo-cd/releases/latest | grep '"tag_name":' | sed -E 's/.*"([^"]+)".*/\1/')
    curl -sL "https://github.com/argoproj/argo-cd/releases/download/${VERSION}/argocd-linux-amd64" \
      -o /usr/local/bin/argocd
    chmod +x /usr/local/bin/argocd
  args:
    executable: /bin/bash
  become: true
  changed_when: true
  when:
    - _argocd_state == 'present'
    - argocd_create_local_apps | bool
    - argocd_apps | length > 0
    - ansible_facts['system'] == 'Linux'

- name: Log in to local ArgoCD (for local app creation)
  ansible.builtin.command: >
    argocd login localhost:{{ argocd_nodeport }}
    --username admin
    --password {{ argocd_initial_password.stdout | trim }}
    --plaintext
    --insecure
  no_log: true
  changed_when: true
  become: true
  environment:
    KUBECONFIG: "{{ k3s_kubeconfig_path }}"
  when:
    - _argocd_state == 'present'
    - argocd_create_local_apps | bool
    - argocd_apps | length > 0

- name: Create local cluster ArgoCD Applications
  ansible.builtin.command: >
    argocd app create {{ item.name }}
    --repo {{ argocd_gitops_repo }}
    --path {{ item.path }}
    --revision {{ argocd_gitops_revision }}
    --dest-server https://kubernetes.default.svc
    --dest-namespace {{ item.dest_namespace }}
    --sync-policy automated
    --auto-prune
    --self-heal
    --sync-option CreateNamespace=true
    --sync-option ServerSideApply=true
    --annotations "argocd.argoproj.io/sync-wave={{ item.sync_wave | default('0') }}"
    {% if argocd_cluster_label != '' %}--label "cluster={{ argocd_cluster_label }}"{% endif %}
    --label "app={{ item.path.split('/')[-1] }}"
    --upsert
  loop: "{{ argocd_apps }}"
  register: _argocd_local_app_create
  changed_when: true
  failed_when:
    - _argocd_local_app_create.rc != 0
    - "'app path does not exist' not in (_argocd_local_app_create.stderr | default(''))"
  become: true
  when:
    - _argocd_state == 'present'
    - argocd_create_local_apps | bool
    - argocd_gitops_repo != ""
    - argocd_apps | length > 0

- name: Warn about missing local GitOps paths
  ansible.builtin.debug:
    msg: "WARNING: {{ item.item.name }} path '{{ item.item.path }}' not yet in gitops repo"
  loop: "{{ _argocd_local_app_create.results | default([]) }}"
  when:
    - argocd_create_local_apps | bool
    - item.rc | default(0) != 0
    - "'app path does not exist' in (item.stderr | default(''))"

# --- CLUSTER REGISTRATION ---
# Runs when argocd_register_cluster: true regardless of argocd_state.
# Use case: ai-hub registers its OrbStack cluster with management-hub ArgoCD
# but does NOT install ArgoCD itself (argocd_state: absent).

- name: Install argocd CLI (macOS)
  community.general.homebrew:
    name: argocd
    state: present
  become: false
  when:
    - argocd_register_cluster | default(false)
    - ansible_facts['system'] == 'Darwin'

# Dynamically resolve management host Tailscale IP via API
- name: Get Tailscale OAuth token (for management IP lookup)
  ansible.builtin.uri:
    url: https://api.tailscale.com/api/v2/oauth/token
    method: POST
    body_format: form-urlencoded
    body:
      grant_type: client_credentials
      client_id: "{{ tailscale_oauth_client_id }}"
      client_secret: "{{ tailscale_oauth_client_secret }}"
    status_code: 200
  register: _ts_mgmt_oauth
  no_log: true
  when:
    - argocd_register_cluster | default(false)
    - tailscale_oauth_client_id | default('') != ''
    - tailscale_oauth_client_secret | default('') != ''

- name: List Tailscale devices
  ansible.builtin.uri:
    url: "https://api.tailscale.com/api/v2/tailnet/-/devices?fields=default"
    method: GET
    headers:
      Authorization: "Bearer {{ _ts_mgmt_oauth.json.access_token }}"
    status_code: 200
  register: _ts_devices
  no_log: true
  when:
    - argocd_register_cluster | default(false)
    - _ts_mgmt_oauth is defined
    - _ts_mgmt_oauth.status | default(0) == 200

- name: Set management_tailscale_ip from Tailscale API
  ansible.builtin.set_fact:
    management_tailscale_ip: >-
      {{ _ts_devices.json.devices
         | selectattr('hostname', 'equalto', argocd_management_hostname)
         | map(attribute='addresses')
         | first
         | select('match', '^[\d.]+$')
         | first }}
  no_log: true
  when:
    - argocd_register_cluster | default(false)
    - _ts_devices is defined
    - _ts_devices.status | default(0) == 200
    - (_ts_devices.json.devices | selectattr('hostname', 'equalto', argocd_management_hostname) | list | length) > 0

- name: Fail if management Tailscale IP could not be resolved
  ansible.builtin.fail:
    msg: >
      Could not resolve Tailscale IP for host '{{ argocd_management_hostname }}'.
      Check that the device is online and that tailscale_oauth_client_id/secret are set.
  when:
    - argocd_register_cluster | default(false)
    - management_tailscale_ip | default('') == ''

- name: Get local Tailscale IP (for cluster API server URL)
  ansible.builtin.command: /opt/homebrew/bin/tailscale ip -4
  register: _local_tailscale_ip
  changed_when: false
  become: false
  when: argocd_register_cluster | default(false)

- name: Create temp kubeconfig with proxy server URL for ArgoCD cluster registration
  ansible.builtin.shell: |
    set -o pipefail
    KUBECONFIG={{ ansible_facts['env']['HOME'] }}/.kube/config \
      kubectl config view --raw --minify --context {{ argocd_cluster_context }} \
        > /tmp/argocd-cluster-reg-kubeconfig.yml
    KUBECONFIG=/tmp/argocd-cluster-reg-kubeconfig.yml \
      kubectl config set-cluster {{ argocd_cluster_context }} \
        --server=https://{{ _local_tailscale_ip.stdout | trim }}:{{ argocd_k8s_proxy_port | default(6443) }} \
        --insecure-skip-tls-verify=true
  args:
    executable: /bin/bash
  changed_when: false
  become: false
  when: argocd_register_cluster | default(false)

- name: Fetch ArgoCD admin password from 1Password Connect
  ansible.builtin.command: /opt/homebrew/bin/op read "op://Dev/olympus-sdk-argocd/password"
  register: _argocd_admin_password
  no_log: true
  changed_when: false
  environment:
    OP_CONNECT_HOST: "{{ onepassword_connect_host }}"
    OP_CONNECT_TOKEN: "{{ vault_onepassword_connect_token }}"
  when: argocd_register_cluster | default(false)

- name: Log in to ArgoCD CLI
  ansible.builtin.command: >
    /opt/homebrew/bin/argocd login {{ argocd_login_server }}
    --username admin
    --password {{ _argocd_admin_password.stdout | trim }}
    --plaintext
  no_log: false
  changed_when: true
  when: argocd_register_cluster | default(false)

- name: Register cluster in ArgoCD
  ansible.builtin.command: >
    /opt/homebrew/bin/argocd cluster add {{ argocd_cluster_context }}
    --name {{ argocd_cluster_name }}
    --kubeconfig /tmp/argocd-cluster-reg-kubeconfig.yml
    --insecure
    --yes
  changed_when: true
  when: argocd_register_cluster | default(false)

- name: Create ArgoCD Applications from gitops repo
  ansible.builtin.command: >
    /opt/homebrew/bin/argocd app create {{ item.name }}
    --repo {{ argocd_gitops_repo }}
    --path {{ item.path }}
    --revision {{ argocd_gitops_revision }}
    --dest-server https://{{ _local_tailscale_ip.stdout | trim }}:{{ argocd_k8s_proxy_port | default(6443) }}
    --dest-namespace {{ item.dest_namespace }}
    --sync-policy automated
    --auto-prune
    --self-heal
    --sync-option CreateNamespace=true
    --annotations "argocd.argoproj.io/sync-wave={{ item.sync_wave | default('0') }}"
    {% if argocd_cluster_label != '' %}--label "cluster={{ argocd_cluster_label }}"{% endif %}
    --label "app={{ item.path.split('/')[-1] }}"
    --upsert
  loop: "{{ argocd_apps }}"
  register: _argocd_app_create
  changed_when: true
  failed_when:
    - _argocd_app_create.rc != 0
    - "'app path does not exist' not in (_argocd_app_create.stderr | default(''))"
  when:
    - argocd_register_cluster | default(false)
    - argocd_gitops_repo != ""
    - argocd_apps | length > 0

- name: Warn about missing GitOps paths
  ansible.builtin.debug:
    msg: "WARNING: {{ item.item.name }} path '{{ item.item.path }}' not yet in gitops repo — create manifests to enable sync"
  loop: "{{ _argocd_app_create.results | default([]) }}"
  when:
    - argocd_register_cluster | default(false)
    - item.rc | default(0) != 0
    - "'app path does not exist' in (item.stderr | default(''))"

# --- UNINSTALL (only when argocd_state: absent AND not a registration-only host) ---
- name: Uninstall ArgoCD
  ansible.builtin.command: helm uninstall argocd -n {{ argocd_namespace }}
  become: true
  environment:
    KUBECONFIG: "{{ k3s_kubeconfig_path }}"
  failed_when: false
  changed_when: true
  when:
    - _argocd_state == 'absent'
    - not (argocd_register_cluster | default(false))
</file>

<file path="roles/argocd/templates/traefik-ingressroute.yaml.j2">
---
# ArgoCD web UI — HTTP/1.1 backend (server.insecure=true, no h2c support).
# gRPC CLI access uses Tailscale NodePort (argocd login <tailscale-ip>:30080 --plaintext).
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: argocd-server
  namespace: {{ argocd_namespace }}
spec:
  entryPoints:
    - web
  routes:
    - match: Host(`{{ argocd_hostname }}`)
      kind: Rule
      services:
        - name: argocd-server
          port: 80
</file>

<file path="roles/atlas/defaults/main.yml">
---
atlas_state: present
atlas_server: https://api.nwlnexus.net
atlas_install_url: https://assets.nwlnexus.net/releases/atlas/install.sh
atlas_op_bootstrap_key_ref: "op://Dev/hermes-secrets/bootstrap-key"
atlas_op_token_file: /etc/olympus/op-service-account-token
