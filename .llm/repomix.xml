<file path="roles/pxe/tasks/pi.yml">
---
- name: Create Pi TFTP firmware directory
  ansible.builtin.file:
    path: "{{ pxe_tftp_root }}/pi"
    state: directory
    owner: root
    group: root
    mode: "0755"
  become: true

- name: Download Raspberry Pi firmware files
  ansible.builtin.get_url:
    url: "{{ pxe_pi_firmware_base_url }}/{{ item }}"
    dest: "{{ pxe_tftp_root }}/pi/{{ item }}"
    mode: "0644"
  become: true
  loop: "{{ pxe_pi_firmware_files }}"

- name: Symlink netboot.xyz-arm64.efi into Pi TFTP subdirectory
  ansible.builtin.file:
    src: "{{ pxe_tftp_root }}/netboot.xyz-arm64.efi"
    dest: "{{ pxe_tftp_root }}/pi/netboot.xyz-arm64.efi"
    state: link
  become: true

- name: Render Pi config.txt
  ansible.builtin.template:
    src: pi/config.txt.j2
    dest: "{{ pxe_tftp_root }}/pi/config.txt"
    owner: root
    group: root
    mode: "0644"
  become: true

# Note: cmdline.txt is not needed — netboot.xyz-arm64.efi is an EFI application,
# not a Linux kernel. It bootstraps iPXE which then loads our custom menu via
# the two-stage dnsmasq chainload (option 175 detection).
</file>

<file path="roles/pxe/tasks/service.yml">
