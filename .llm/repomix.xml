<file path="inventory/group_vars/compute_hub.yml">
---
# Shared vars for all compute-hub nodes (applied to group: compute_hub)
# Secrets are read at runtime from 1Password via `op read` in playbook pre_tasks.
# 1Password service account token (item: olympus-edge-service-account) must be on
# each node at: /etc/olympus/op-service-account-token
# and must have read/write access to the Dev vault.

ansible_user: ansible

# --- k3s HA cluster ---
k3s_state: present
k3s_ha: true
k3s_disable: [traefik]

# QNAP CSI (Trident) — cluster-wide storage provisioner for qnap-iscsi PVCs.
# Runs on the HA primary only (gated in olympus.yml on k3s_primary). iSCSI CHAP
# creds live in the cluster-named 1Password item (not <hostname>-qnap-iscsi).
qnap_csi_state: present
qnap_iscsi_op_item: compute-hub-qnap-iscsi
qnap_csi_kubeconfig: /etc/rancher/k3s/k3s.yaml
k3s_version: "v1.32.4+k3s1"
# Node labels/taints for unified cluster placement
# onodes are the default compute pool (untainted) — all workloads land here unless
# a pod has a nodeSelector for management-hub.
k3s_node_labels:
  - "olympus.io/role=compute-hub"
k3s_node_taints: []
# Virtual IP for kube-vip ARP leader election (within mgmt-hub advertised subnet)
k3s_vip: "192.168.253.2"
# k3s_vip_interface is intentionally not set here — the k3s role detects it
# automatically by finding the interface whose IP is in the same /24 as k3s_vip
# (using ansible_facts['interfaces'] at run time). Override here only if needed.
# 1Password reference for the shared cluster token (create with: openssl rand -hex 32)
k3s_token_op_ref: "op://Dev/compute-hub-k3s-token/password"
# TLS SANs added to k3s API server cert — applied on primary at cluster-init.
# Tailscale IPs/FQDNs are appended dynamically by the k3s role at run time.
k3s_tls_san:
  - "192.168.253.2"
  - "compute-hub.nwlnexus.net"
k3s_kubeconfig_users:
  - ansible
# Export kubeconfig to 1Password so management-hub Headlamp can import it
k3s_kubeconfig_op_item: "compute-hub-kubeconfig"
k3s_kubeconfig_op_vault: "Dev"
# Context/cluster/user names in the exported kubeconfig
k3s_context_name: "compute-hub"
# Patch kubeconfig server URL to VIP for remote kubectl access
k3s_external_server: "compute-hub.nwlnexus.net"

# --- Tailscale ---
tailscale_state: present
tailscale_ephemeral: false
tailscale_accept_routes: false
# Ubuntu 25.04 systemd-resolved conflicts with tailscaled DNS management.
# Symptom: "setLinkDNS: Link tailscale0 is managed" health warning.
tailscale_accept_dns: false
tailscale_tags:
  - "tag:infra-server"
  - "tag:k8s"
# OAuth credentials fetched from 1Password at runtime (see playbook pre_tasks)
tailscale_oauth_client_id: "{{ lookup('community.general.onepassword', 'ansible-tailscale-oauth', field='client-id', vault='Dev') }}"
tailscale_oauth_client_secret: "{{ lookup('community.general.onepassword', 'ansible-tailscale-oauth', field='client-secret', vault='Dev') }}"

# --- ddclient (per-node DNS: onode-XXXXXX.nwlnexus.net) ---
ddclient_state: present
# cloudflare_api_token set at runtime from 1Password

# --- ESO bootstrap (primary node only — playbook guards via k3s_primary) ---
eso_namespace: external-secrets
# ansible-pull runs as root (sudo); override default HOME-based path to use k3s kubeconfig
eso_kubeconfig_path: "{{ k3s_kubeconfig_path }}"

# --- cloudflared-k8s (primary node only) ---
cloudflared_k8s_state: present
cloudflared_tunnel_name: compute-hub
cloudflared_account_id: "1b15dcdab99d4e8d5babb3dc6b1adaec"
cloudflared_domain: "nwlnexus.net"
cloudflared_bootstrap_only: true
cloudflared_ingress_hostname: "ing.compute.nwlnexus.net"
cloudflared_catch_all_service: "https://traefik.kube-system:443"

# GitOps mode — push creds to 1Password via op CLI + service-account token
# (/etc/olympus/op-service-account-token, already on every host).
cloudflared_op_enabled: true
cloudflared_op_vault: "Dev"
cloudflared_op_item_title: "compute-hub-cloudflared"

# --- Flux CD (primary node only) ---
flux_cluster_path: "clusters/olympus"
flux_kubeconfig_path: "/etc/rancher/k3s/k3s.yaml"

# --- ansible-pull (all nodes) ---
# The ansible-pull role installs the cron that replaces the cloud-init systemd timer.
ansible_pull_state: present
ansible_pull_legacy_users:
  - ansible
  - ubuntu
ansible_pull_inventory: inventory/compute-hub.yml
ansible_pull_playbook: playbooks/pull/olympus.yml
ansible_pull_limit: "$(hostname -s)"

# iSCSI host prereqs — QNAP Trident CSI manages login/CHAP; Ansible sets initiator name only
iscsi_state: present
iscsi_mode: csi_node

# Atlas daemon
atlas_state: present

# k3s kubeconfig path (standard bare-metal k3s location; used by 1password-connect + eso-bootstrap)
k3s_kubeconfig_path: /etc/rancher/k3s/k3s.yaml

# 1Password Connect — k3s bare-metal; uses k3s_kubeconfig_path via onepassword_connect_kubeconfig default
onepassword_connect_state: present

# ESO bootstrap
eso_bootstrap_state: present
</file>

