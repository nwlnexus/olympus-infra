<file path="roles/mem0-client/files/mem0-recall-hook.sh">
#!/usr/bin/env bash
# mem0-recall-hook.sh — SessionStart auto-recall hook for OpenMemory/Mem0.
#
# Reads the Claude Code hook stdin (JSON with session metadata), extracts the
# working directory as the search query, POSTs to the Mem0 /filter endpoint,
# and emits a SessionStart additionalContext JSON blob with the top-k hits.
#
# FAIL OPEN: any error (timeout, non-200, bad JSON, missing tool) results in
# {"continue":true} and exit 0 — this hook MUST NEVER block session start.
#
# Overridable via env:
#   MEM0_URL        — base URL of the OpenMemory API
#   MEM0_USER_ID    — Mem0 user_id (shared persona)
#   MEM0_TOP_K      — number of memories to retrieve
#
# The hook stdin JSON shape is {"session_id":"...","cwd":"...","...":...}.

set -euo pipefail

MEM0_URL="${MEM0_URL:-http://openmemory.raptor-mimosa.ts.net:8765}"
MEM0_USER_ID="${MEM0_USER_ID:-mnemosyne}"
MEM0_TOP_K="${MEM0_TOP_K:-5}"
FILTER_ENDPOINT="${MEM0_URL}/api/v1/memories/filter"

# Emit continue-only JSON and exit cleanly — used on any error path.
fail_open() {
    printf '{"continue":true}\n'
    exit 0
}

# Read stdin (may be empty in some invocation modes).
stdin_data=""
if read -t 2 -r line 2>/dev/null; then
    stdin_data="$line"
    # Drain remaining lines without blocking.
    while IFS= read -t 0.1 -r extra 2>/dev/null; do
        stdin_data="${stdin_data}${extra}"
    done
fi

# Extract cwd from stdin JSON as the search query. Fall back to PWD.
search_query=""
if [ -n "$stdin_data" ] && command -v python3 >/dev/null 2>&1; then
    search_query="$(printf '%s' "$stdin_data" | python3 -c "
import sys, json
try:
    d = json.load(sys.stdin)
    cwd = d.get('cwd', '') or d.get('workingDirectory', '') or ''
    print(cwd.strip())
except Exception:
    print('')
" 2>/dev/null || true)"
fi
search_query="${search_query:-${PWD:-}}"

# Nothing to search — bail open.
if [ -z "$search_query" ]; then
    fail_open
fi

# Build POST body. python3 is used to ensure proper JSON escaping.
if ! command -v python3 >/dev/null 2>&1; then
    fail_open
fi

post_body="$(python3 -c "
import json, sys
body = {
    'user_id': sys.argv[1],
    'search_query': sys.argv[2],
    'page': 1,
    'size': int(sys.argv[3]),
}
print(json.dumps(body))
" "$MEM0_USER_ID" "$search_query" "$MEM0_TOP_K" 2>/dev/null)" || fail_open

# POST to the filter endpoint with a hard 2-second wall-clock limit.
response="$(curl \
    --silent \
    --show-error \
    --connect-timeout 1 \
    --max-time 2 \
    --request POST \
    --header "Content-Type: application/json" \
    --data "$post_body" \
    --write-out '\n%{http_code}' \
    "$FILTER_ENDPOINT" 2>/dev/null)" || fail_open

# Split body from HTTP status code (last line).
http_status="$(printf '%s' "$response" | tail -1)"
response_body="$(printf '%s' "$response" | head -n -1)"

if [ "$http_status" != "200" ]; then
    fail_open
fi

# Parse the response and format the top-k memories.
context_text="$(python3 -c "
import json, sys

try:
    data = json.loads(sys.stdin.read())
except Exception:
    sys.exit(1)

items = data.get('items', [])
total = data.get('total', 0)

if not items or total == 0:
    sys.exit(0)

lines = ['## Recalled memories (Mem0 — mnemosyne)']
for i, item in enumerate(items, 1):
    memory = item.get('memory', '') or item.get('text', '') or str(item)
    memory = memory.strip().replace('\n', ' ')
    if memory:
        lines.append(f'{i}. {memory}')

if len(lines) > 1:
    print('\n'.join(lines))
" <<< "$response_body" 2>/dev/null)" || fail_open

# If no memories (empty but valid response), still continue cleanly.
if [ -z "$context_text" ]; then
    printf '{"continue":true}\n'
    exit 0
fi

# Emit the SessionStart additionalContext JSON.
python3 -c "
import json, sys
context = sys.argv[1]
output = {
    'hookSpecificOutput': {
        'hookEventName': 'SessionStart',
        'additionalContext': context,
    }
}
print(json.dumps(output))
" "$context_text" 2>/dev/null || fail_open
</file>

<file path="roles/mem0-client/meta/main.yml">
---
galaxy_info:
  role_name: mem0-client
  author: nwlnexus
  description: Configure Mem0/OpenMemory MCP entry and SessionStart recall hook for Claude Code
  min_ansible_version: "2.14"
dependencies: []
</file>

<file path="roles/mem0-client/tasks/main.yml">
---
# mem0-client role — wire OpenMemory MCP entry + SessionStart recall hook
# into the user's Claude Code configuration.
#
# MCP servers live in ~/.claude.json (confirmed on this machine; gitnexus,
# terraform-registry, cf-docs are all registered there).
# Settings/hooks live in ~/.claude/settings.json.
#
# All tasks are idempotent: safe to apply repeatedly.

- name: Ensure ~/.claude/hooks directory exists
  ansible.builtin.file:
    path: "{{ ansible_facts['env']['HOME'] }}/.claude/hooks"
    state: directory
    mode: "0755"

# ── MCP entry → ~/.claude.json ────────────────────────────────────────────

- name: Check if ~/.claude.json exists
  ansible.builtin.stat:
    path: "{{ ansible_facts['env']['HOME'] }}/.claude.json"
  register: claude_json_stat

- name: Read existing ~/.claude.json
  ansible.builtin.slurp:
    path: "{{ ansible_facts['env']['HOME'] }}/.claude.json"
  register: claude_json_raw
  when: claude_json_stat.stat.exists

- name: Set base claude.json (empty object when file missing)
  ansible.builtin.set_fact:
    claude_json_current: {}
  when: not claude_json_stat.stat.exists

- name: Parse existing ~/.claude.json
  ansible.builtin.set_fact:
    claude_json_current: "{{ claude_json_raw.content | b64decode | from_json }}"
  when: claude_json_stat.stat.exists

- name: Render MCP entry from template
  ansible.builtin.set_fact:
    mem0_mcp_entry: "{{ lookup('template', 'mcp.json.j2') | from_json }}"

- name: Merge mem0 MCP entry into mcpServers (does not clobber other servers)
  ansible.builtin.set_fact:
    claude_json_merged: >-
      {{
        claude_json_current | combine({
          'mcpServers': (claude_json_current.get('mcpServers', {}) | combine(mem0_mcp_entry['mcpServers']))
        }, recursive=False)
      }}

- name: Write merged ~/.claude.json
  ansible.builtin.copy:
    content: "{{ claude_json_merged | to_nice_json }}\n"
    dest: "{{ ansible_facts['env']['HOME'] }}/.claude.json"
    mode: "0600"

# ── Recall hook script → ~/.claude/hooks/ ─────────────────────────────────

- name: Install mem0-recall-hook.sh
  ansible.builtin.copy:
    src: mem0-recall-hook.sh
    dest: "{{ ansible_facts['env']['HOME'] }}/.claude/hooks/mem0-recall-hook.sh"
    mode: "0755"

# ── SessionStart hook → ~/.claude/settings.json ───────────────────────────

- name: Check if ~/.claude/settings.json exists
  ansible.builtin.stat:
    path: "{{ ansible_facts['env']['HOME'] }}/.claude/settings.json"
  register: claude_settings_stat

- name: Read existing ~/.claude/settings.json
  ansible.builtin.slurp:
    path: "{{ ansible_facts['env']['HOME'] }}/.claude/settings.json"
  register: claude_settings_raw
  when: claude_settings_stat.stat.exists

- name: Set base settings (empty object when file missing)
  ansible.builtin.set_fact:
    claude_settings_current: {}
  when: not claude_settings_stat.stat.exists

- name: Parse existing ~/.claude/settings.json
  ansible.builtin.set_fact:
    claude_settings_current: "{{ claude_settings_raw.content | b64decode | from_json }}"
  when: claude_settings_stat.stat.exists

- name: Build desired mem0 SessionStart hook entry
  ansible.builtin.set_fact:
    mem0_hook_entry:
      type: command
      command: "{{ ansible_facts['env']['HOME'] }}/.claude/hooks/mem0-recall-hook.sh"
      timeout: 5

- name: Collect existing SessionStart hook commands (for idempotency check)
  ansible.builtin.set_fact:
    existing_session_start_hooks: >-
      {{
        (claude_settings_current.get('hooks', {}).get('SessionStart', []) | map(attribute='hooks') | flatten) +
        []
      }}

- name: Check if mem0 recall hook is already wired
  ansible.builtin.set_fact:
    mem0_hook_present: >-
      {{
        existing_session_start_hooks
        | selectattr('command', 'defined')
        | selectattr('command', 'search', 'mem0-recall-hook')
        | list | length > 0
      }}

- name: Build updated SessionStart hooks list (append if not already present)
  ansible.builtin.set_fact:
    updated_session_start_hooks: >-
      {{
        claude_settings_current.get('hooks', {}).get('SessionStart', [])
        + ([{'hooks': [mem0_hook_entry]}] if not mem0_hook_present else [])
      }}

- name: Merge updated hooks into settings
  ansible.builtin.set_fact:
    claude_settings_merged: >-
      {{
        claude_settings_current | combine({
          'hooks': (claude_settings_current.get('hooks', {}) | combine({
            'SessionStart': updated_session_start_hooks
          }))
        }, recursive=True)
      }}

- name: Write merged ~/.claude/settings.json
  ansible.builtin.copy:
    content: "{{ claude_settings_merged | to_nice_json }}\n"
    dest: "{{ ansible_facts['env']['HOME'] }}/.claude/settings.json"
    mode: "0600"
</file>

<file path="roles/mem0-client/templates/mcp.json.j2">
