- name: Apply ClusterSecretStore manifest
  ansible.builtin.command: kubectl apply -f /tmp/external-secrets-cluster-secret-store.yaml
  become: true
  environment:
    KUBECONFIG: "{{ k3s_kubeconfig_path }}"
  changed_when: true
  when:
    - _external_secrets_state == 'present'
    - onepassword_connect_token != ""

# --- ABSENT ---

- name: Uninstall external-secrets
  ansible.builtin.command: helm uninstall external-secrets -n {{ external_secrets_namespace }}
  become: true
  environment:
    KUBECONFIG: "{{ k3s_kubeconfig_path }}"
  failed_when: false
  changed_when: true
  when: _external_secrets_state == 'absent'
</file>

<file path="roles/external-secrets/templates/cluster-secret-store.yaml.j2">
apiVersion: external-secrets.io/v1beta1
kind: ClusterSecretStore
metadata:
  name: onepassword-connect
spec:
  provider:
    onepassword:
      connectHost: {{ onepassword_connect_url }}
      vaults:
{% for vault_name, vault_uuid in onepassword_connect_vaults.items() %}
        {{ vault_name }}: {{ vault_uuid }}
{% endfor %}
      auth:
        secretRef:
          connectTokenSecretRef:
            namespace: external-secrets
            name: onepassword-connect-token
            key: token
</file>

<file path="roles/flux/defaults/main.yml">
---
flux_state: present
flux_version: "2.4.0"
# GitHub repo details — nwlnexus/olympus-gitops
flux_github_owner: "nwlnexus"
flux_github_repo: "olympus-gitops"
flux_github_branch: "main"
# Set per-host in host_vars: clusters/management-hub or clusters/ai-hub
flux_cluster_path: ""
# GitHub PAT with repo scope — provided from 1Password via Ansible vault
# Only needed for the initial bootstrap. Flux creates a deploy key and uses that going forward.
flux_github_token: ""
# Kubeconfig path on the remote host
# For k3s (management-hub): /etc/rancher/k3s/k3s.yaml
# For OrbStack (ai-hub): use the home-directory kube config
flux_kubeconfig_path: "/etc/rancher/k3s/k3s.yaml"
# Optional kubeconfig context name — leave empty for default context in the kubeconfig
flux_kubeconfig_context: ""
# Local kubectl context for tasks delegated to localhost (e.g. creating k8s Secrets from the
# control machine). Must match a context in ~/.kube/config on the control machine.
# Example: "management-hub" (the context created by the Headlamp combined kubeconfig setup)
flux_local_kubectl_context: ""

# --- KUBECONFIG EXPORT TO 1PASSWORD ---
# Reads kubeconfig from the remote host, patches the server URL, and uploads as a
# 1Password document. Mirrors what the argocd role does for management-hub.
# Set flux_kubeconfig_1password_item to enable; leave empty to skip.
flux_kubeconfig_1password_item: ""
flux_kubeconfig_1password_vault: "Dev"
# Patch internal server URL (127.0.0.1:*) to this host for remote kubectl access.
# If empty, Tailscale IPv4 is auto-resolved from `tailscale status --json`.
flux_kubeconfig_external_server: ""
# Port to use in the patched kubeconfig.
flux_kubeconfig_external_port: 6443
# Context/cluster/user name written into the exported kubeconfig.
# Defaults to flux_kubeconfig_1password_item when not set.
# Set this to a clean name like "management-hub" or "ai-hub".
flux_kubeconfig_context_name: ""
# Set true for clusters with self-signed certs (e.g. OrbStack) that don't distribute a CA bundle.
# Removes certificate-authority-data and adds insecure-skip-tls-verify: true.
flux_kubeconfig_insecure_tls: false
# Second kubeconfig with Tailscale MagicDNS FQDN as the server.
# Set to a 1Password item name to enable; leave empty to skip.
flux_tailnet_kubeconfig_1password_item: ""
# Tailscale MagicDNS FQDN to use in the tailnet kubeconfig.
# If empty, auto-resolved from `tailscale status --json`.
flux_tailnet_server: ""

# --- HEADLAMP ADMIN TOKEN ---
# Generates a long-lived token for the Headlamp admin ServiceAccount and stores it
# in 1Password so users can authenticate after Cloudflare Access.
# Set flux_headlamp_token_1password_item to enable; leave empty to skip.
flux_headlamp_token_1password_item: ""
flux_headlamp_sa_name: "headlamp-admin"
flux_headlamp_sa_namespace: "headlamp"

# --- HEADLAMP COMBINED KUBECONFIG SECRET ---
# Creates a k8s Secret merging the local cluster kubeconfig (server patched to
# https://kubernetes.default.svc) with a secondary cluster kubeconfig from 1Password.
# Only set on the cluster that runs Headlamp (management-hub).
# Set flux_headlamp_combined_kubeconfig_secret to enable; leave empty to skip.
flux_headlamp_combined_kubeconfig_secret: ""
flux_headlamp_combined_kubeconfig_namespace: "headlamp"
# List of 1Password document names for secondary cluster kubeconfigs.
# Each entry is fetched and merged into the combined kubeconfig.
# Add new clusters here as they are bootstrapped — re-run the role to update the Secret.
# Example:
#   flux_headlamp_secondary_kubeconfig_1password_items:
#     - ai-hub-kubeconfig
#     - node-hub-kubeconfig
flux_headlamp_secondary_kubeconfig_1password_items: []

# Context renames applied to the combined kubeconfig after merging.
# Maps original context name → desired display name in Headlamp.
# k3s defaults to "default"; OrbStack defaults to "orbstack".
# Example:
#   flux_headlamp_context_renames:
#     default: management-hub
#     orbstack: ai-hub
flux_headlamp_context_renames: {}
</file>

<file path="roles/flux/tasks/main.yml">
---
# --- PRESENT ---

- name: Install flux CLI
  ansible.builtin.shell: |
    set -o pipefail
    curl -s https://fluxcd.io/install.sh | FLUX_VERSION={{ flux_version }} bash
  args:
    creates: /usr/local/bin/flux
    executable: /bin/bash
  become: true
  when: flux_state == 'present'

- name: Verify flux CLI version
  ansible.builtin.command: flux version --client
  register: _flux_cli_version
  changed_when: false
  failed_when: _flux_cli_version.rc != 0
  when: flux_state == 'present'

- name: Pre-install Flux components (ensures CRDs exist before bootstrap dry-run)
  ansible.builtin.shell: >
    flux install
    --namespace=flux-system
    --kubeconfig={{ flux_kubeconfig_path }}
    {% if flux_kubeconfig_context != '' %}--context={{ flux_kubeconfig_context }}{% endif %}
  become: true
  changed_when: true
  failed_when: false
  when: flux_state == 'present'

- name: Bootstrap Flux from olympus-gitops
  ansible.builtin.shell: |
    set -o pipefail
    GITHUB_TOKEN="{{ flux_github_token }}" flux bootstrap github \
      --owner={{ flux_github_owner }} \
      --repository={{ flux_github_repo }} \
      --branch={{ flux_github_branch }} \
      --path={{ flux_cluster_path }} \
      --personal \
      --token-auth \
      {% if flux_kubeconfig_context != '' %}--context={{ flux_kubeconfig_context }} \
      {% endif %}--kubeconfig={{ flux_kubeconfig_path }}
  args:
    executable: /bin/bash
  no_log: true
  become: true
  register: _flux_bootstrap
  changed_when: "'no changes' not in (_flux_bootstrap.stdout | default(''))"
  failed_when: _flux_bootstrap.rc != 0
  when:
    - flux_state == 'present'
    - flux_cluster_path != ''
    - flux_github_token != ''

- name: Wait for Flux controllers to be ready
  ansible.builtin.command: >
    flux check --kubeconfig={{ flux_kubeconfig_path }}
    {% if flux_kubeconfig_context != '' %}--context={{ flux_kubeconfig_context }}{% endif %}
  become: true
  register: _flux_check
  until: _flux_check.rc == 0
  retries: 12
  delay: 10
  changed_when: false
  when:
    - flux_state == 'present'
    - flux_cluster_path != ''

# --- KUBECONFIG EXPORT TO 1PASSWORD ---
# Reads the kubeconfig from the remote host, patches the server URL from the
# internal 127.0.0.1 address to the Tailscale IP (and FQDN), then uploads
# both variants to 1Password as documents for remote kubectl access.

- name: Query Tailscale status for kubeconfig server URL
  ansible.builtin.command: tailscale status --json
  register: _flux_ts_status
  failed_when: false
  changed_when: false
  become: false
  when:
    - flux_state == 'present'
    - flux_kubeconfig_1password_item | default('') != ''

- name: Resolve Tailscale IPv4 and MagicDNS FQDN
  ansible.builtin.set_fact:
    _flux_ts_ipv4: >-
      {{ (_flux_ts_status.stdout | from_json).Self.TailscaleIPs
         | select('match', '^[0-9]') | first | default('') }}
    _flux_ts_fqdn: >-
      {{ (_flux_ts_status.stdout | from_json).Self.DNSName
         | regex_replace('\\.+$', '') | default('') }}
  when:
    - flux_state == 'present'
    - flux_kubeconfig_1password_item | default('') != ''
    - _flux_ts_status.rc | default(1) == 0
    - _flux_ts_status.stdout | default('') != ''

- name: Set effective external server (explicit or Tailscale IPv4)
  ansible.builtin.set_fact:
    _flux_external_server: >-
      {{ flux_kubeconfig_external_server
         if (flux_kubeconfig_external_server | default('')) != ''
         else (_flux_ts_ipv4 | default('')) }}
    _flux_tailnet_server: >-
      {{ flux_tailnet_server
         if (flux_tailnet_server | default('')) != ''
         else (_flux_ts_fqdn | default('')) }}
  when:
    - flux_state == 'present'
    - flux_kubeconfig_1password_item | default('') != ''

- name: Read kubeconfig from remote host
  ansible.builtin.slurp:
    src: "{{ flux_kubeconfig_path }}"
  register: _flux_remote_kubeconfig
  become: true
  no_log: true
  when:
    - flux_state == 'present'
    - flux_kubeconfig_1password_item | default('') != ''
    - _flux_external_server | default('') != ''

# Write raw kubeconfig to temp file (avoids heredoc + Jinja2 parse issues)
- name: Write raw kubeconfig to temp file for patching
  ansible.builtin.copy:
    content: "{{ _flux_remote_kubeconfig.content | b64decode }}"
    dest: /tmp/_flux_kubeconfig_raw.yaml
    mode: "0600"
  delegate_to: localhost
  become: false
  no_log: true
  when:
    - flux_state == 'present'
    - flux_kubeconfig_1password_item | default('') != ''
    - _flux_external_server | default('') != ''

- name: Write kubeconfig patch helper script
  ansible.builtin.copy:
    content: |
      import yaml, os
      with open(os.environ['KC_FILE']) as f:
          kc = yaml.safe_load(f.read())
      ctx = os.environ['CTX']
      kc['clusters'][0]['cluster']['server'] = os.environ['SERVER']
      if os.environ.get('INSECURE', 'false') == 'true':
          kc['clusters'][0]['cluster'].pop('certificate-authority-data', None)
          kc['clusters'][0]['cluster']['insecure-skip-tls-verify'] = True
      kc['clusters'][0]['name'] = ctx + '-cluster'
      kc['contexts'][0]['context']['cluster'] = ctx + '-cluster'
      kc['contexts'][0]['context']['user'] = ctx + '-user'
      kc['contexts'][0]['name'] = ctx
      kc['current-context'] = ctx
      kc['users'][0]['name'] = ctx + '-user'
      print(yaml.dump(kc, default_flow_style=False))
    dest: /tmp/_flux_patch_kubeconfig.py
    mode: "0600"
  delegate_to: localhost
  become: false
  when:
    - flux_state == 'present'
    - flux_kubeconfig_1password_item | default('') != ''
    - _flux_external_server | default('') != ''

- name: Patch kubeconfig for primary export (server URL + context/cluster/user rename)
  ansible.builtin.shell: python3 /tmp/_flux_patch_kubeconfig.py
  environment:
    KC_FILE: /tmp/_flux_kubeconfig_raw.yaml
    CTX: "{{ flux_kubeconfig_context_name | default(flux_kubeconfig_1password_item) }}"
    SERVER: "https://{{ _flux_external_server }}:{{ flux_kubeconfig_external_port }}"
    INSECURE: "{{ flux_kubeconfig_insecure_tls | default(false) | string | lower }}"
  register: _flux_kubeconfig_primary_raw
  changed_when: false
  no_log: true
  delegate_to: localhost
  become: false
  when:
    - flux_state == 'present'
    - flux_kubeconfig_1password_item | default('') != ''
    - _flux_external_server | default('') != ''

- name: Set primary kubeconfig fact
  ansible.builtin.set_fact:
    _flux_kubeconfig_primary: "{{ _flux_kubeconfig_primary_raw.stdout }}"
  no_log: true
  when:
    - flux_state == 'present'
    - flux_kubeconfig_1password_item | default('') != ''
    - _flux_external_server | default('') != ''

- name: Write primary kubeconfig to temp file on localhost
  ansible.builtin.copy:
    content: "{{ _flux_kubeconfig_primary }}"
    dest: "/tmp/{{ flux_kubeconfig_1password_item }}.yaml"
    mode: '0600'
  delegate_to: localhost
  become: false
  no_log: true
  when:
    - flux_state == 'present'
    - flux_kubeconfig_1password_item | default('') != ''
    - _flux_external_server | default('') != ''

- name: Check if primary kubeconfig document exists in 1Password
  ansible.builtin.command: >
    /opt/homebrew/bin/op document get "{{ flux_kubeconfig_1password_item }}"
    --vault {{ flux_kubeconfig_1password_vault }}
  register: _op_flux_kubeconfig_check
  failed_when: false
  changed_when: false
  delegate_to: localhost
  become: false
  environment:
    OP_SERVICE_ACCOUNT_TOKEN: "{{ op_service_account_token | default('') }}"
  when:
    - flux_state == 'present'
    - flux_kubeconfig_1password_item | default('') != ''
    - _flux_external_server | default('') != ''

- name: Create primary kubeconfig document in 1Password
  ansible.builtin.command: >
    /opt/homebrew/bin/op document create /tmp/{{ flux_kubeconfig_1password_item }}.yaml
    --title "{{ flux_kubeconfig_1password_item }}"
    --vault {{ flux_kubeconfig_1password_vault }}
    --file-name kubeconfig
  delegate_to: localhost
  become: false
  no_log: true
  changed_when: true
  environment:
    OP_SERVICE_ACCOUNT_TOKEN: "{{ op_service_account_token | default('') }}"
  when:
    - flux_state == 'present'
    - flux_kubeconfig_1password_item | default('') != ''
    - _flux_external_server | default('') != ''
    - _op_flux_kubeconfig_check.rc != 0

- name: Update primary kubeconfig document in 1Password
  ansible.builtin.command: >
    /opt/homebrew/bin/op document edit "{{ flux_kubeconfig_1password_item }}"
    /tmp/{{ flux_kubeconfig_1password_item }}.yaml
    --vault {{ flux_kubeconfig_1password_vault }}
    --file-name kubeconfig
  delegate_to: localhost
  become: false
  no_log: true
  changed_when: true
  environment:
    OP_SERVICE_ACCOUNT_TOKEN: "{{ op_service_account_token | default('') }}"
  when:
    - flux_state == 'present'
    - flux_kubeconfig_1password_item | default('') != ''
    - _flux_external_server | default('') != ''
    - _op_flux_kubeconfig_check.rc == 0

- name: Remove temp primary kubeconfig file
  ansible.builtin.file:
    path: "/tmp/{{ flux_kubeconfig_1password_item }}.yaml"
    state: absent
  delegate_to: localhost
  become: false
  when:
    - flux_state == 'present'
    - flux_kubeconfig_1password_item | default('') != ''

# --- TAILNET KUBECONFIG ---

- name: Write raw kubeconfig to temp file for tailnet patching
  ansible.builtin.copy:
    content: "{{ _flux_remote_kubeconfig.content | b64decode }}"
    dest: /tmp/_flux_kubeconfig_raw.yaml
    mode: "0600"
  delegate_to: localhost
  become: false
  no_log: true
  when:
    - flux_state == 'present'
    - flux_tailnet_kubeconfig_1password_item | default('') != ''
    - _flux_tailnet_server | default('') != ''

- name: Patch kubeconfig for tailnet export (server URL + context/cluster/user rename)
  ansible.builtin.shell: python3 /tmp/_flux_patch_kubeconfig.py
  environment:
    KC_FILE: /tmp/_flux_kubeconfig_raw.yaml
    CTX: "{{ flux_kubeconfig_context_name | default(flux_kubeconfig_1password_item) }}"
    SERVER: "https://{{ _flux_tailnet_server }}:{{ flux_kubeconfig_external_port }}"
    INSECURE: "{{ flux_kubeconfig_insecure_tls | default(false) | string | lower }}"
  register: _flux_kubeconfig_tailnet_raw
  changed_when: false
  no_log: true
  delegate_to: localhost
  become: false
  when:
    - flux_state == 'present'
    - flux_tailnet_kubeconfig_1password_item | default('') != ''
    - _flux_tailnet_server | default('') != ''

- name: Set tailnet kubeconfig fact
  ansible.builtin.set_fact:
    _flux_kubeconfig_tailnet: "{{ _flux_kubeconfig_tailnet_raw.stdout }}"
  no_log: true
  when:
    - flux_state == 'present'
    - flux_tailnet_kubeconfig_1password_item | default('') != ''
    - _flux_tailnet_server | default('') != ''

- name: Write tailnet kubeconfig to temp file on localhost
  ansible.builtin.copy:
    content: "{{ _flux_kubeconfig_tailnet }}"
    dest: "/tmp/{{ flux_tailnet_kubeconfig_1password_item }}.yaml"
    mode: '0600'
  delegate_to: localhost
  become: false
  no_log: true
  when:
    - flux_state == 'present'
    - flux_tailnet_kubeconfig_1password_item | default('') != ''
    - _flux_tailnet_server | default('') != ''

- name: Check if tailnet kubeconfig document exists in 1Password
  ansible.builtin.command: >
    /opt/homebrew/bin/op document get "{{ flux_tailnet_kubeconfig_1password_item }}"
    --vault {{ flux_kubeconfig_1password_vault }}
  register: _op_flux_tailnet_check
  failed_when: false
  changed_when: false
  delegate_to: localhost
  become: false
  environment:
    OP_SERVICE_ACCOUNT_TOKEN: "{{ op_service_account_token | default('') }}"
  when:
    - flux_state == 'present'
    - flux_tailnet_kubeconfig_1password_item | default('') != ''
    - _flux_tailnet_server | default('') != ''

- name: Create tailnet kubeconfig document in 1Password
  ansible.builtin.command: >
    /opt/homebrew/bin/op document create /tmp/{{ flux_tailnet_kubeconfig_1password_item }}.yaml
    --title "{{ flux_tailnet_kubeconfig_1password_item }}"
    --vault {{ flux_kubeconfig_1password_vault }}
    --file-name kubeconfig
  delegate_to: localhost
  become: false
  no_log: true
  changed_when: true
  environment:
    OP_SERVICE_ACCOUNT_TOKEN: "{{ op_service_account_token | default('') }}"
  when:
    - flux_state == 'present'
    - flux_tailnet_kubeconfig_1password_item | default('') != ''
    - _flux_tailnet_server | default('') != ''
    - _op_flux_tailnet_check.rc != 0

- name: Update tailnet kubeconfig document in 1Password
  ansible.builtin.command: >
    /opt/homebrew/bin/op document edit "{{ flux_tailnet_kubeconfig_1password_item }}"
    /tmp/{{ flux_tailnet_kubeconfig_1password_item }}.yaml
    --vault {{ flux_kubeconfig_1password_vault }}
    --file-name kubeconfig
  delegate_to: localhost
  become: false
  no_log: true
  changed_when: true
  environment:
    OP_SERVICE_ACCOUNT_TOKEN: "{{ op_service_account_token | default('') }}"
  when:
    - flux_state == 'present'
    - flux_tailnet_kubeconfig_1password_item | default('') != ''
    - _flux_tailnet_server | default('') != ''
    - _op_flux_tailnet_check.rc == 0

- name: Remove temp tailnet kubeconfig file
  ansible.builtin.file:
    path: "/tmp/{{ flux_tailnet_kubeconfig_1password_item }}.yaml"
    state: absent
  delegate_to: localhost
  become: false
  when:
    - flux_state == 'present'
    - flux_tailnet_kubeconfig_1password_item | default('') != ''

# --- HEADLAMP ADMIN TOKEN ---
# Generates a long-lived service account token for Headlamp and stores it in
# 1Password. Users paste this token into Headlamp's login screen after passing
# Cloudflare Access authentication.

- name: Wait for Headlamp ServiceAccount to exist
  ansible.builtin.command: >
    kubectl get serviceaccount {{ flux_headlamp_sa_name }}
    -n {{ flux_headlamp_sa_namespace }}
    --kubeconfig={{ flux_kubeconfig_path }}
    {% if flux_kubeconfig_context != '' %}--context={{ flux_kubeconfig_context }}{% endif %}
  become: true
  register: _headlamp_sa_check
  until: _headlamp_sa_check.rc == 0
  retries: 18
  delay: 10
  changed_when: false
  failed_when: false
  when:
    - flux_state == 'present'
    - flux_headlamp_token_1password_item | default('') != ''

- name: Generate Headlamp admin token (10-year lifetime)
  ansible.builtin.command: >
    kubectl create token {{ flux_headlamp_sa_name }}
    -n {{ flux_headlamp_sa_namespace }}
    --duration=87600h
    --kubeconfig={{ flux_kubeconfig_path }}
    {% if flux_kubeconfig_context != '' %}--context={{ flux_kubeconfig_context }}{% endif %}
  become: true
  register: _headlamp_token
  changed_when: true
  no_log: true
  when:
    - flux_state == 'present'
    - flux_headlamp_token_1password_item | default('') != ''
    - _headlamp_sa_check.rc | default(1) == 0

- name: Check if Headlamp token document exists in 1Password
  ansible.builtin.command: >
    /opt/homebrew/bin/op document get "{{ flux_headlamp_token_1password_item }}"
    --vault {{ flux_kubeconfig_1password_vault }}
  register: _op_headlamp_token_check
  failed_when: false
  changed_when: false
  delegate_to: localhost
  become: false
  environment:
    OP_SERVICE_ACCOUNT_TOKEN: "{{ op_service_account_token | default('') }}"
  when:
    - flux_state == 'present'
    - flux_headlamp_token_1password_item | default('') != ''
    - _headlamp_sa_check.rc | default(1) == 0

- name: Write Headlamp token to temp file on localhost
  ansible.builtin.copy:
    content: "{{ _headlamp_token.stdout }}"
    dest: "/tmp/{{ flux_headlamp_token_1password_item }}.txt"
    mode: '0600'
  delegate_to: localhost
  become: false
  no_log: true
  when:
    - flux_state == 'present'
    - flux_headlamp_token_1password_item | default('') != ''
    - _headlamp_sa_check.rc | default(1) == 0

- name: Create Headlamp token document in 1Password
  ansible.builtin.command: >
    /opt/homebrew/bin/op document create /tmp/{{ flux_headlamp_token_1password_item }}.txt
    --title "{{ flux_headlamp_token_1password_item }}"
    --vault {{ flux_kubeconfig_1password_vault }}
    --file-name token
  delegate_to: localhost
  become: false
  no_log: true
  changed_when: true
  environment:
    OP_SERVICE_ACCOUNT_TOKEN: "{{ op_service_account_token | default('') }}"
  when:
    - flux_state == 'present'
    - flux_headlamp_token_1password_item | default('') != ''
    - _headlamp_sa_check.rc | default(1) == 0
    - _op_headlamp_token_check.rc != 0

- name: Update Headlamp token document in 1Password
  ansible.builtin.command: >
    /opt/homebrew/bin/op document edit "{{ flux_headlamp_token_1password_item }}"
    /tmp/{{ flux_headlamp_token_1password_item }}.txt
    --vault {{ flux_kubeconfig_1password_vault }}
    --file-name token
  delegate_to: localhost
  become: false
  no_log: true
  changed_when: true
  environment:
    OP_SERVICE_ACCOUNT_TOKEN: "{{ op_service_account_token | default('') }}"
  when:
    - flux_state == 'present'
    - flux_headlamp_token_1password_item | default('') != ''
    - _headlamp_sa_check.rc | default(1) == 0
    - _op_headlamp_token_check.rc == 0

- name: Remove temp Headlamp token file
  ansible.builtin.file:
    path: "/tmp/{{ flux_headlamp_token_1password_item }}.txt"
    state: absent
  delegate_to: localhost
  become: false
  when:
    - flux_state == 'present'
    - flux_headlamp_token_1password_item | default('') != ''

# --- HEADLAMP COMBINED KUBECONFIG SECRET ---
# Creates a k8s Secret containing a merged kubeconfig with the local cluster
# (server patched to https://kubernetes.default.svc) plus any number of secondary
# clusters fetched from 1Password documents (flux_headlamp_secondary_kubeconfig_1password_items list).
# Adding a new cluster: add its kubeconfig 1Password item name to the list and re-run.
# Set flux_headlamp_combined_kubeconfig_secret to enable; leave empty to skip.

- name: Read local kubeconfig for combined Secret
  ansible.builtin.slurp:
    src: "{{ flux_kubeconfig_path }}"
  register: _flux_headlamp_local_kubeconfig
  become: true
  no_log: true
  when:
    - flux_state == 'present'
    - flux_headlamp_combined_kubeconfig_secret | default('') != ''

- name: Patch local kubeconfig server to in-cluster API
  ansible.builtin.set_fact:
    _flux_kubeconfig_incluster: >-
      {{ (_flux_headlamp_local_kubeconfig.content | b64decode)
         | regex_replace('server: https://(?:127\.0\.0\.1|localhost):\d+',
                         'server: https://kubernetes.default.svc') }}
  no_log: true
  when:
    - flux_state == 'present'
    - flux_headlamp_combined_kubeconfig_secret | default('') != ''
    - _flux_headlamp_local_kubeconfig is defined

- name: Write in-cluster kubeconfig to temp file on localhost
  ansible.builtin.copy:
    content: "{{ _flux_kubeconfig_incluster }}"
    dest: "/tmp/headlamp-mgmt-incluster.yaml"
    mode: '0600'
  delegate_to: localhost
  become: false
  no_log: true
  when:
    - flux_state == 'present'
    - flux_headlamp_combined_kubeconfig_secret | default('') != ''
    - _flux_kubeconfig_incluster is defined

- name: Fetch secondary kubeconfigs from 1Password
  ansible.builtin.command: >
    /opt/homebrew/bin/op document get "{{ item }}"
    --vault {{ flux_kubeconfig_1password_vault }}
    --force
    --output /tmp/headlamp-secondary-{{ item }}.yaml
  loop: "{{ flux_headlamp_secondary_kubeconfig_1password_items }}"
  delegate_to: localhost
  become: false
  no_log: true
  changed_when: true
  environment:
    OP_SERVICE_ACCOUNT_TOKEN: "{{ op_service_account_token | default('') }}"
  when:
    - flux_state == 'present'
    - flux_headlamp_combined_kubeconfig_secret | default('') != ''
    - flux_headlamp_secondary_kubeconfig_1password_items | default([]) | length > 0

- name: Merge all kubeconfigs into combined file
  ansible.builtin.shell: |
    set -o pipefail
    secondary_files=$(ls /tmp/headlamp-secondary-*.yaml 2>/dev/null | tr '\n' ':' | sed 's/:$//')
    if [ -n "$secondary_files" ]; then
      KUBECONFIG=/tmp/headlamp-mgmt-incluster.yaml:${secondary_files} \
        kubectl config view --flatten > /tmp/headlamp-combined.yaml
    else
      cp /tmp/headlamp-mgmt-incluster.yaml /tmp/headlamp-combined.yaml
    fi
  args:
    executable: /bin/bash
  delegate_to: localhost
  become: false
  no_log: true
  changed_when: true
  when:
    - flux_state == 'present'
    - flux_headlamp_combined_kubeconfig_secret | default('') != ''
    - _flux_kubeconfig_incluster is defined

- name: Rename contexts in combined kubeconfig
  ansible.builtin.command: >
    kubectl config --kubeconfig=/tmp/headlamp-combined.yaml
    rename-context {{ item.key }} {{ item.value }}
  loop: "{{ flux_headlamp_context_renames | default({}) | dict2items }}"
  delegate_to: localhost
  become: false
  changed_when: true
  failed_when: false
  when:
    - flux_state == 'present'
    - flux_headlamp_combined_kubeconfig_secret | default('') != ''
    - flux_headlamp_context_renames | default({}) | length > 0
    - _flux_kubeconfig_incluster is defined

# Secondary clusters (OrbStack, etc.) are accessed via Tailscale IP.
# OrbStack's server cert is issued for 127.0.0.1 only — the SAN will never
# match a remote IP. Set insecure-skip-tls-verify on every secondary cluster
# so Headlamp can connect without cert errors.
- name: Set insecure-skip-tls-verify on secondary clusters in combined kubeconfig
  ansible.builtin.shell: |
    set -o pipefail
    # Get all cluster names from the combined kubeconfig
    cluster_names=$(kubectl config --kubeconfig=/tmp/headlamp-combined.yaml view -o jsonpath='{.clusters[*].name}')
    for cluster in $cluster_names; do
      server=$(kubectl config --kubeconfig=/tmp/headlamp-combined.yaml view -o jsonpath="{.clusters[?(@.name=='${cluster}')].cluster.server}")
      # Skip the in-cluster management-hub entry — it uses kubernetes.default.svc
      if echo "$server" | grep -q "kubernetes.default.svc"; then
        continue
      fi
      kubectl config set-cluster "$cluster" \
        --insecure-skip-tls-verify=true \
        --kubeconfig=/tmp/headlamp-combined.yaml
      kubectl config unset "clusters.${cluster}.certificate-authority-data" \
        --kubeconfig=/tmp/headlamp-combined.yaml 2>/dev/null || true
    done
  args:
    executable: /bin/bash
  delegate_to: localhost
  become: false
  changed_when: true
  when:
    - flux_state == 'present'
    - flux_headlamp_combined_kubeconfig_secret | default('') != ''
    - flux_headlamp_secondary_kubeconfig_1password_items | default([]) | length > 0
    - _flux_kubeconfig_incluster is defined

- name: Create or update Headlamp combined kubeconfig Secret
  ansible.builtin.shell: |
    set -o pipefail
    kubectl create secret generic {{ flux_headlamp_combined_kubeconfig_secret }} \
      --namespace {{ flux_headlamp_combined_kubeconfig_namespace }} \
      --from-file=kubeconfig=/tmp/headlamp-combined.yaml \
      --dry-run=client -o yaml \
      {% if flux_local_kubectl_context != '' %}--context={{ flux_local_kubectl_context }}{% endif %} | \
    kubectl apply \
      {% if flux_local_kubectl_context != '' %}--context={{ flux_local_kubectl_context }}{% endif %} \
      -f -
  args:
    executable: /bin/bash
  delegate_to: localhost
  become: false
  no_log: true
  changed_when: true
  when:
    - flux_state == 'present'
    - flux_headlamp_combined_kubeconfig_secret | default('') != ''
    - _flux_kubeconfig_incluster is defined

- name: Remove temp combined kubeconfig files
  ansible.builtin.shell: |
    rm -f /tmp/headlamp-mgmt-incluster.yaml /tmp/headlamp-secondary-*.yaml /tmp/headlamp-combined.yaml
  args:
    executable: /bin/bash
  delegate_to: localhost
  become: false
  changed_when: false
  when:
    - flux_state == 'present'
    - flux_headlamp_combined_kubeconfig_secret | default('') != ''

# --- ABSENT ---

- name: Uninstall Flux
  ansible.builtin.shell: |
    set -o pipefail
    flux uninstall \
      --kubeconfig={{ flux_kubeconfig_path }} \
      {% if flux_kubeconfig_context != '' %}--context={{ flux_kubeconfig_context }} \
      {% endif %}--silent
  args:
    executable: /bin/bash
  become: true
  changed_when: true
  failed_when: false
  when: flux_state == 'absent'
</file>

