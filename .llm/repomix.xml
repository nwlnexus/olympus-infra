<file path="playbooks/k3s-disable-traefik.yml">
---
# One-shot playbook: write k3s_disable to /etc/rancher/k3s/config.yaml and restart k3s.
#
# Adds the `disable:` block to the existing config using blockinfile (idempotent).
# Run against one cluster at a time during the maintenance window:
#
#   # management-hub (single node):
#   ansible-playbook -i inventory/management-hub.yml playbooks/k3s-disable-traefik.yml
#
#   # compute-hub (HA — run against primary first, then secondaries):
#   ansible-playbook -i inventory/compute-hub.yml playbooks/k3s-disable-traefik.yml \
#     --limit onode-030c31   # primary node hostname — check inventory/host_vars/
#
# After running: verify with `kubectl get deploy -n kube-system traefik` returning NotFound,
# then trigger Flux reconcile from olympus-gitops.

- name: Disable k3s-bundled Traefik
  hosts: all
  become: true
  gather_facts: false

  tasks:
    - name: Ensure k3s config directory exists
      ansible.builtin.file:
        path: /etc/rancher/k3s
        state: directory
        owner: root
        group: root
        mode: "0755"

    - name: Add disable traefik block to k3s config
      ansible.builtin.blockinfile:
        path: /etc/rancher/k3s/config.yaml
        insertafter: EOF
        block: |
          disable:
            - traefik
        marker: "# {mark} ANSIBLE MANAGED - k3s_disable"
      register: _k3s_config_changed

    - name: Restart k3s if config changed
      ansible.builtin.systemd:
        name: k3s
        state: restarted
      when: _k3s_config_changed.changed

    - name: Wait for k3s API to be available after restart
      ansible.builtin.command: kubectl get nodes
      environment:
        KUBECONFIG: /etc/rancher/k3s/k3s.yaml
      register: _k3s_ready
      until: _k3s_ready.rc == 0
      retries: 18
      delay: 10
      changed_when: false
      when: _k3s_config_changed.changed
</file>

<file path="playbooks/place-connect-token.yml">
---
# One-time / maintenance: distribute the 1Password Connect access token to every
# host at /etc/olympus/op-connect-token (0600). Read ONCE on the controller to
# avoid a rate-limit burst, then copied to all hosts.
#
#   ansible-playbook -i inventory/management-hub.yml playbooks/place-connect-token.yml
#   ansible-playbook -i inventory/compute-hub.yml    playbooks/place-connect-token.yml
#   ansible-playbook -i inventory/styx.yml           playbooks/place-connect-token.yml
#
# Reads op://Dev/olympus-connect-access-token/credential. The control node needs an
# interactive op session or OP_SERVICE_ACCOUNT_TOKEN in env for this one bootstrap
# read (we use the old path once to seed the new Connect path).

- name: Seed Connect token (read once on controller)
  hosts: localhost
  gather_facts: false
  run_once: true
  tasks:
    - name: Read Connect access token from 1Password
      ansible.builtin.command: op read "op://Dev/olympus-connect-access-token/credential"
      register: _op_connect_token
      changed_when: false
      no_log: true

- name: Distribute Connect token to hosts
  hosts: all
  become: true
  gather_facts: false
  tasks:
    - name: Ensure /etc/olympus exists
      ansible.builtin.file:
        path: /etc/olympus
        state: directory
        mode: "0755"

    - name: Write Connect token
      ansible.builtin.copy:
        dest: /etc/olympus/op-connect-token
        content: "{{ hostvars['localhost']._op_connect_token.stdout }}"
        owner: root
        group: root
        mode: "0600"
      no_log: true
</file>

<file path="roles/1password-connect/defaults/main.yml">
---
onepassword_connect_state: present
onepassword_connect_namespace: "1password"
onepassword_connect_chart_version: "1.15.0"
onepassword_connect_credentials_file: "/etc/olympus/1password-credentials.json"
onepassword_connect_token_file: "/etc/olympus/onepassword-connect-token"
onepassword_connect_port: 8080
# Public hostname for Traefik IngressRoute (set in host_vars to enable)
onepassword_connect_hostname: ""
# k8s service name as created by the Helm chart (release: connect, chart: connect)
onepassword_connect_service_name: "onepassword-connect"
# Kubeconfig path — override for non-standard k8s (e.g. Colima on macOS uses /var/ansible/.kube/config)
onepassword_connect_kubeconfig: "{{ k3s_kubeconfig_path | default('/var/ansible/.kube/config') }}"
# On macOS Homebrew tools (helm, kubectl) live in ansible user's PATH, not root's.
# On Linux become root for system kubeconfig access.
onepassword_connect_become: "{{ ansible_facts['os_family'] != 'Darwin' }}"
</file>

<file path="roles/1password-connect/tasks/main.yml">
---
- name: Set 1password-connect state
  ansible.builtin.set_fact:
    _1pw_state: "{{ onepassword_connect_state | default('present') }}"

- name: Check credentials file
  ansible.builtin.stat:
    path: "{{ onepassword_connect_credentials_file }}"
  register: creds_file
  become: true
  when: _1pw_state == 'present'

- name: Skip if credentials file missing
  ansible.builtin.meta: end_host
  when:
    - _1pw_state == 'present'
    - not creds_file.stat.exists or creds_file.stat.size == 0

- name: Install helm (Linux)
  ansible.builtin.shell: |
    set -o pipefail
    curl https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash
  args:
    creates: /usr/local/bin/helm
    executable: /bin/bash
  become: true
  when:
    - _1pw_state == 'present'
    - ansible_facts['os_family'] != 'Darwin'

- name: Add 1Password Helm repo
  ansible.builtin.command: >
    helm repo add 1password
    https://1password.github.io/connect-helm-charts
  register: repo_add
  changed_when: "'already exists' not in repo_add.stderr"
  become: "{{ onepassword_connect_become }}"
  environment:
    PATH: /opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin
  when: _1pw_state == 'present'

- name: Update Helm repos
  ansible.builtin.command: helm repo update
  become: "{{ onepassword_connect_become }}"
  environment:
    PATH: /opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin
  changed_when: false
  when: _1pw_state == 'present'

- name: Create 1password namespace
  ansible.builtin.command: kubectl create namespace {{ onepassword_connect_namespace }}
  register: ns_create
  failed_when:
    - ns_create.rc != 0
    - "'already exists' not in ns_create.stderr"
  changed_when: ns_create.rc == 0
  become: "{{ onepassword_connect_become }}"
  environment:
    KUBECONFIG: "{{ onepassword_connect_kubeconfig }}"
    PATH: /opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin
  when: _1pw_state == 'present'

- name: Create credentials secret (base64-encoded — required by Connect Helm chart 1.14+)
  ansible.builtin.shell: |
    set -o pipefail
    kubectl create secret generic op-credentials \
      --from-literal=1password-credentials.json="$(base64 < {{ onepassword_connect_credentials_file }})" \
      -n {{ onepassword_connect_namespace }} \
      --dry-run=client -o yaml | kubectl apply -f -
  args:
    executable: /bin/bash
  become: "{{ onepassword_connect_become }}"
  environment:
    KUBECONFIG: "{{ onepassword_connect_kubeconfig }}"
    PATH: /opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin
  changed_when: true
  when: _1pw_state == 'present'

- name: Install 1Password Connect via Helm
  ansible.builtin.command: >
    helm upgrade --install connect 1password/connect
    --namespace {{ onepassword_connect_namespace }}
    --version {{ onepassword_connect_chart_version }}
    --set connect.serviceType=ClusterIP
    --wait
  become: "{{ onepassword_connect_become }}"
  environment:
    KUBECONFIG: "{{ onepassword_connect_kubeconfig }}"
    PATH: /opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin
  changed_when: true
  when: _1pw_state == 'present'


# --- TRAEFIK INGRESSROUTE ---
- name: Render 1Password Connect Traefik IngressRoute
  ansible.builtin.template:
    src: traefik-ingressroute.yaml.j2
    dest: /tmp/onepassword-connect-ingressroute.yaml
    mode: '0600'
  when:
    - _1pw_state == 'present'
    - onepassword_connect_hostname != ""

