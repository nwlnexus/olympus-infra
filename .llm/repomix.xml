<file path="roles/plex/defaults/main.yml">
---
plex_state: present
plex_transcoding_dir: /tmp/plexmedia
plex_tmp_dir: /tmp/plextmp

# Firewall
plex_ufw_tailscale_src: "100.64.0.0/10"   # Tailscale CGNAT range
plex_ufw_lan_src: "192.168.253.0/24"       # LAN CIDR for local clients (TVs, phones, etc.)

# Set true to open local discovery ports (GDM + DLNA) to LAN
# Required for Plex clients to find the server without manual IP entry
plex_ufw_local_discovery: true
</file>

<file path="roles/plex/tasks/main.yml">
---
- name: Install apt-transport-https (prerequisite)
  ansible.builtin.apt:
    name: apt-transport-https
    state: present
    update_cache: false
  become: true
  when: plex_state == "present"

- name: Add Plex GPG key
  ansible.builtin.apt_key:
    url: https://downloads.plex.tv/plex-keys/PlexSign.key
    keyring: /usr/share/keyrings/plex-archive-keyring.gpg
    state: present
  become: true
  when: plex_state == "present"

- name: Add Plex apt repository
  ansible.builtin.apt_repository:
    repo: "deb [signed-by=/usr/share/keyrings/plex-archive-keyring.gpg] https://downloads.plex.tv/repo/deb public main"
    state: present
    filename: plexmediaserver
  become: true
  when: plex_state == "present"

- name: Install plexmediaserver
  ansible.builtin.apt:
    name: plexmediaserver
    state: present
    update_cache: true
  become: true
  when: plex_state == "present"

- name: Deploy tmpfiles.d config for transcoding directory
  ansible.builtin.template:
    src: plexmedia-tmpfiles.conf.j2
    dest: /etc/tmpfiles.d/plexmedia.conf
    owner: root
    group: root
    mode: '0644'
  become: true
  when: plex_state == "present"

- name: Create transcoding directory
  ansible.builtin.file:
    path: "{{ plex_transcoding_dir }}"
    state: directory
    owner: plex
    group: plex
    mode: '0755'
  become: true
  when: plex_state == "present"

- name: Create plex tmp directory
  ansible.builtin.file:
    path: "{{ plex_tmp_dir }}"
    state: directory
    owner: plex
    group: plex
    mode: '0755'
  become: true
  when: plex_state == "present"

- name: Check if UFW is active
  ansible.builtin.command: ufw status
  register: _plex_ufw_status
  changed_when: false
  failed_when: false
  become: true
  when: plex_state == "present"

- name: Allow Plex 32400 from Tailscale range (UFW)
  community.general.ufw:
    rule: allow
    src: "{{ plex_ufw_tailscale_src }}"
    port: '32400'
    proto: tcp
  become: true
  when:
    - plex_state == "present"
    - "'Status: active' in _plex_ufw_status.stdout"

- name: Allow Plex 32400 from LAN (UFW)
  community.general.ufw:
    rule: allow
    src: "{{ plex_ufw_lan_src }}"
    port: '32400'
    proto: tcp
  become: true
  when:
    - plex_state == "present"
    - "'Status: active' in _plex_ufw_status.stdout"

- name: Allow Plex local discovery ports from LAN (UFW)
  community.general.ufw:
    rule: allow
    src: "{{ plex_ufw_lan_src }}"
    port: "{{ item.port }}"
    proto: "{{ item.proto }}"
  become: true
  loop:
    - { port: '32469', proto: tcp }   # DLNA TCP
    - { port: '1900',  proto: udp }   # DLNA SSDP
    - { port: '32410', proto: udp }   # GDM network discovery
    - { port: '32412', proto: udp }   # GDM
    - { port: '32413', proto: udp }   # GDM
    - { port: '32414', proto: udp }   # GDM
  when:
    - plex_state == "present"
    - plex_ufw_local_discovery | bool
    - "'Status: active' in _plex_ufw_status.stdout"

- name: Enable and start plexmediaserver
  ansible.builtin.systemd:
    name: plexmediaserver
    enabled: true
    state: started
  become: true
  when: plex_state == "present"

- name: Stop and disable plexmediaserver (state=absent)
  ansible.builtin.systemd:
    name: plexmediaserver
    enabled: false
    state: stopped
  become: true
  failed_when: false
  when: plex_state == "absent"

- name: Remove plexmediaserver (state=absent)
  ansible.builtin.apt:
    name: plexmediaserver
    state: absent
    purge: true
  become: true
  when: plex_state == "absent"

- name: Remove Plex apt repository (state=absent)
  ansible.builtin.apt_repository:
    repo: "deb [signed-by=/usr/share/keyrings/plex-archive-keyring.gpg] https://downloads.plex.tv/repo/deb public main"
    state: absent
    filename: plexmediaserver
  become: true
  when: plex_state == "absent"

- name: Remove tmpfiles config (state=absent)
  ansible.builtin.file:
    path: /etc/tmpfiles.d/plexmedia.conf
    state: absent
  become: true
  when: plex_state == "absent"

- name: Remove transcoding directory (state=absent)
  ansible.builtin.file:
    path: "{{ plex_transcoding_dir }}"
    state: absent
  become: true
  when: plex_state == "absent"

- name: Remove plex tmp directory (state=absent)
  ansible.builtin.file:
    path: "{{ plex_tmp_dir }}"
    state: absent
  become: true
  when: plex_state == "absent"

- name: Remove Plex GPG keyring (state=absent)
  ansible.builtin.file:
    path: /usr/share/keyrings/plex-archive-keyring.gpg
    state: absent
  become: true
  when: plex_state == "absent"
</file>

<file path="roles/plex/templates/plexmedia-tmpfiles.conf.j2">
# Managed by Ansible (plex role) — do not edit manually
d {{ plex_transcoding_dir | mandatory }} 0755 plex plex -
d {{ plex_tmp_dir | mandatory }} 0755 plex plex -
</file>

<file path="roles/postgresql/defaults/main.yml">
---
postgresql_state: present
postgresql_version: "16"
postgresql_port: 5432
postgresql_data_dir: /opt/homebrew/var/postgresql@16
postgresql_conf_dest: /opt/homebrew/var/postgresql@16/postgresql.conf
postgresql_hba_dest: /opt/homebrew/var/postgresql@16/pg_hba.conf
</file>

<file path="roles/postgresql/handlers/main.yml">
---
- name: Restart PostgreSQL
  ansible.builtin.command: >
    /opt/homebrew/bin/brew services restart postgresql@{{ postgresql_version }}
  become: false
  changed_when: true
</file>

<file path="roles/postgresql/tasks/main.yml">
---
- name: Install postgresql@{{ postgresql_version }} via Homebrew
  community.general.homebrew:
    name: "postgresql@{{ postgresql_version }}"
    state: "{{ 'present' if postgresql_state == 'present' else 'absent' }}"
  become: false

- name: Start PostgreSQL via brew services
  ansible.builtin.command: >
    /opt/homebrew/bin/brew services start postgresql@{{ postgresql_version }}
  register: _pg_start
  changed_when: "'Successfully started' in _pg_start.stdout"
  # "Bootstrap failed: 5" = launchctl error when LaunchAgent is already loaded
  failed_when:
    - _pg_start.rc != 0
    - "'already started' not in (_pg_start.stderr | default(''))"
    - "'Bootstrap failed' not in (_pg_start.stderr | default(''))"
  become: false
  when: postgresql_state == "present"

- name: Wait for PostgreSQL to accept connections
  # postgresql@16 is keg-only — binaries are NOT in /opt/homebrew/bin
  ansible.builtin.command: >
    /opt/homebrew/opt/postgresql@{{ postgresql_version }}/bin/pg_isready
    -h 127.0.0.1 -p {{ postgresql_port }}
  register: _pg_ready
  until: _pg_ready.rc == 0
  retries: 12
  delay: 5
  changed_when: false
  become: false
  when: postgresql_state == "present"

- name: Patch listen_addresses in postgresql.conf
  # Do NOT replace the full file — Homebrew ships 250+ lines of tuning
  ansible.builtin.lineinfile:
    path: "{{ postgresql_conf_dest }}"
    regexp: "^#?listen_addresses"
    line: "listen_addresses = '*'"
    state: present
  notify: Restart PostgreSQL
  when: postgresql_state == "present"

- name: Patch port in postgresql.conf
  ansible.builtin.lineinfile:
    path: "{{ postgresql_conf_dest }}"
    regexp: "^#?port ="
    line: "port = {{ postgresql_port }}"
    state: present
  notify: Restart PostgreSQL
  when: postgresql_state == "present"

- name: Set wal_level = logical (required by ElectricSQL)
  ansible.builtin.lineinfile:
    path: "{{ postgresql_conf_dest }}"
    regexp: "^#?wal_level"
    line: "wal_level = logical"
    state: present
  notify: Restart PostgreSQL
  when: postgresql_state == "present"

- name: Deploy pg_hba.conf
  ansible.builtin.template:
    src: pg_hba.conf.j2
    dest: "{{ postgresql_hba_dest }}"
    owner: "{{ ansible_user }}"
    mode: "0600"
  notify: Restart PostgreSQL
  when: postgresql_state == "present"

- name: Stop and remove PostgreSQL
  ansible.builtin.command: >
    /opt/homebrew/bin/brew services stop postgresql@{{ postgresql_version }}
  register: _pg_stop
  failed_when:
    - _pg_stop.rc != 0
    - "'not started' not in (_pg_stop.stderr | default(''))"
    - "'Could not find' not in (_pg_stop.stderr | default(''))"
  changed_when: "'Successfully stopped' in (_pg_stop.stdout | default(''))"
  become: false
  when: postgresql_state == "absent"
</file>

<file path="roles/postgresql/templates/pg_hba.conf.j2">
# Managed by Ansible — do not edit manually
# TYPE  DATABASE  USER          ADDRESS             METHOD
local   all       all                               trust
# Loopback — trust so Ansible community.postgresql modules can connect without a password
# (Homebrew creates a superuser matching the OS user, not "postgres")
host    all       all           127.0.0.1/32        trust
host    all       all           ::1/128             trust
# Tailscale CGNAT range — remote access requires password
host    all       all           100.64.0.0/10       md5
</file>

<file path="roles/pxe/defaults/main.yml">
---
pxe_state: present

# TFTP root — iPXE binaries land here
pxe_tftp_root: /srv/pxe/tftp

# HTTP root — menu scripts + cloud-init configs
pxe_http_root: /srv/pxe/http
pxe_http_port: 8080

# netboot.xyz — modern iPXE bootstrap binaries (replaces bare ipxe apt package)
# Two-stage boot: TFTP serves netboot.xyz binary → iPXE re-DHCPs with option 175
# → dnsmasq detects iPXE and serves our custom menu URL instead
pxe_netbootxyz_version: "3.0.2"
pxe_netbootxyz_base_url: "https://github.com/netbootxyz/netboot.xyz/releases/download/{{ pxe_netbootxyz_version }}"

# styx LAN IP — used in iPXE menu scripts as the HTTP server
pxe_server_ip: "192.168.253.6"

# Ubuntu autoinstall defaults
pxe_ubuntu_version: "24.04"
pxe_ubuntu_codename: "noble"
pxe_ubuntu_mirror: "http://archive.ubuntu.com/ubuntu"

# ansible-pull handoff (injected into cloud-init user-data)
pxe_ansible_pull_repo: "https://github.com/nwlnexus/olympus-infra.git"
pxe_ansible_pull_branch: "main"

# Secrets (values come from vault)
pxe_ansible_ssh_pubkey: "{{ vault_pxe_ansible_ssh_pubkey }}"
pxe_default_ansible_password_hash: "{{ vault_pxe_default_ansible_password_hash }}"

# Ubuntu 24.04 live-server ISO URLs — downloaded to pxe_ubuntu_iso_dir on the iSCSI mount,
# loop-mounted, and casper/vmlinuz + casper/initrd extracted automatically.
# ISOs are kept after extraction so re-runs are idempotent (stat checks vmlinuz presence).
pxe_ubuntu_iso_dir: "{{ pxe_http_root }}/iso"
pxe_ubuntu_point_release: "24.04.3"
pxe_ubuntu_amd64_iso_url: "https://releases.ubuntu.com/{{ pxe_ubuntu_point_release }}/ubuntu-{{ pxe_ubuntu_point_release }}-live-server-amd64.iso"
pxe_ubuntu_arm64_iso_url: "https://cdimage.ubuntu.com/releases/{{ pxe_ubuntu_point_release }}/release/ubuntu-{{ pxe_ubuntu_point_release }}-live-server-arm64.iso"
pxe_ubuntu_iso_mount_dir: "/tmp/pxe-iso-mount"

# cloud-init hosts — list of { hostname, ip, inventory, playbook }
pxe_hosts: []

# dnsmasq proxyDHCP — arch-aware PXE boot filename selection
pxe_proxy_dhcp_enabled: true
pxe_dhcp_network: "192.168.253.0/24"   # LAN CIDR dnsmasq listens on for PXE

# Raspberry Pi 4 / CM4 native PXE (wildcard — works for any Pi 4 without per-serial config)
# Pi firmware loads netboot.xyz-arm64.efi as kernel → enters iPXE two-stage flow
pxe_pi_enabled: false   # set to true in host_vars to activate
pxe_pi_firmware_base_url: "https://github.com/raspberrypi/firmware/raw/master/boot"
pxe_pi_firmware_files:
  - start4.elf
  - fixup4.dat
  - start4cd.elf
  - fixup4cd.dat
  - bcm2711-rpi-4-b.dtb
  - bcm2711-rpi-cm4.dtb
</file>

<file path="roles/pxe/handlers/main.yml">
---
- name: Restart tftpd-hpa
  ansible.builtin.service:
    name: tftpd-hpa
    state: restarted
  become: true

- name: Reload nginx
  ansible.builtin.service:
    name: nginx
    state: reloaded
  become: true

- name: Restart dnsmasq
  ansible.builtin.service:
    name: dnsmasq
    state: restarted
  become: true
</file>

<file path="roles/pxe/tasks/configure.yml">
---
- name: Configure tftpd-hpa
  ansible.builtin.template:
    src: tftpd-hpa.j2
    dest: /etc/default/tftpd-hpa
    owner: root
    group: root
    mode: "0644"
  become: true
  notify: Restart tftpd-hpa

- name: Render iPXE boot menu
  ansible.builtin.template:
    src: ipxe-menu.ipxe.j2
    dest: "{{ pxe_http_root }}/menu/boot.ipxe"
    owner: root
    group: root
    mode: "0644"
  become: true

- name: Configure nginx for PXE
  ansible.builtin.template:
    src: nginx.conf.j2
    dest: /etc/nginx/sites-available/pxe
    owner: root
    group: root
    mode: "0644"
  become: true
  notify: Reload nginx

- name: Enable nginx PXE site
  ansible.builtin.file:
    src: /etc/nginx/sites-available/pxe
    dest: /etc/nginx/sites-enabled/pxe
    state: link
  become: true
  notify: Reload nginx

- name: Disable nginx default site
  ansible.builtin.file:
    path: /etc/nginx/sites-enabled/default
    state: absent
  become: true
  notify: Reload nginx

- name: Render cloud-init user-data per host
  ansible.builtin.template:
    src: cloud-init/user-data.j2
    dest: "{{ pxe_http_root }}/cloud-init/{{ item.hostname }}/user-data"
    owner: root
    group: root
    mode: "0644"
  become: true
  loop: "{{ pxe_hosts }}"
  when: pxe_hosts | length > 0

- name: Render cloud-init meta-data per host
  ansible.builtin.template:
    src: cloud-init/meta-data.j2
    dest: "{{ pxe_http_root }}/cloud-init/{{ item.hostname }}/meta-data"
    owner: root
    group: root
    mode: "0644"
  become: true
  loop: "{{ pxe_hosts }}"
  when: pxe_hosts | length > 0

- name: Write empty vendor-data per host
  ansible.builtin.copy:
    content: ""
    dest: "{{ pxe_http_root }}/cloud-init/{{ item.hostname }}/vendor-data"
    owner: root
    group: root
    mode: "0644"
  become: true
  loop: "{{ pxe_hosts }}"
  when: pxe_hosts | length > 0

- name: Create default cloud-init directory for Pi hosts
  ansible.builtin.file:
    path: "{{ pxe_http_root }}/cloud-init/default"
    state: directory
    owner: root
    group: root
    mode: "0755"
  become: true
  when: pxe_pi_enabled | bool

- name: Render default cloud-init user-data for Pi
  ansible.builtin.template:
    src: cloud-init/user-data.j2
    dest: "{{ pxe_http_root }}/cloud-init/default/user-data"
    owner: root
    group: root
    mode: "0644"
  become: true
  vars:
    item:
      hostname: "pi-default"
      inventory: "inventory/styx.yml"
      playbook: "playbooks/pull/styx.yml"
  when: pxe_pi_enabled | bool

- name: Render default cloud-init meta-data for Pi
  ansible.builtin.template:
    src: cloud-init/meta-data.j2
    dest: "{{ pxe_http_root }}/cloud-init/default/meta-data"
    owner: root
    group: root
    mode: "0644"
  become: true
  vars:
    item:
      hostname: "pi-default"
  when: pxe_pi_enabled | bool

- name: Write empty vendor-data for default Pi cloud-init
  ansible.builtin.copy:
    content: ""
    dest: "{{ pxe_http_root }}/cloud-init/default/vendor-data"
    owner: root
    group: root
    mode: "0644"
  become: true
  when: pxe_pi_enabled | bool

- name: Configure dnsmasq proxyDHCP for PXE
  ansible.builtin.template:
    src: dnsmasq-pxe.conf.j2
    dest: /etc/dnsmasq.d/pxe.conf
    owner: root
    group: root
    mode: "0644"
  become: true
  notify: Restart dnsmasq
  when: pxe_proxy_dhcp_enabled | bool
</file>

<file path="roles/pxe/tasks/install.yml">
---
- name: Install tftpd-hpa, nginx, and dnsmasq
  ansible.builtin.apt:
    name:
      - tftpd-hpa
      - nginx
      - dnsmasq
    state: present
    update_cache: true
  become: true

- name: Create PXE directory tree
  ansible.builtin.file:
    path: "{{ item }}"
    state: directory
    owner: root
    group: root
    mode: "0755"
  become: true
  loop:
    - "{{ pxe_tftp_root }}"
    - "{{ pxe_http_root }}"
    - "{{ pxe_http_root }}/cloud-init"
    - "{{ pxe_http_root }}/menu"
    - "{{ pxe_http_root }}/ubuntu/{{ pxe_ubuntu_codename }}"
    - "{{ pxe_http_root }}/ubuntu/{{ pxe_ubuntu_codename }}-arm64"

- name: Download netboot.xyz x86_64 UEFI binary
  ansible.builtin.get_url:
    url: "{{ pxe_netbootxyz_base_url }}/netboot.xyz.efi"
    dest: "{{ pxe_tftp_root }}/netboot.xyz.efi"
    mode: "0644"
  become: true

- name: Download netboot.xyz legacy BIOS binary
  ansible.builtin.get_url:
    url: "{{ pxe_netbootxyz_base_url }}/netboot.xyz-undionly.kpxe"
    dest: "{{ pxe_tftp_root }}/netboot.xyz-undionly.kpxe"
    mode: "0644"
  become: true

- name: Download netboot.xyz ARM64 EFI binary (UEFI hosts + Raspberry Pi)
  ansible.builtin.get_url:
    url: "{{ pxe_netbootxyz_base_url }}/netboot.xyz-arm64.efi"
    dest: "{{ pxe_tftp_root }}/netboot.xyz-arm64.efi"
    mode: "0644"
  become: true

# ── Ubuntu amd64 assets ────────────────────────────────────────────────────────

- name: Create ISO staging directory
  ansible.builtin.file:
    path: "{{ pxe_ubuntu_iso_dir }}"
    state: directory
    owner: root
    group: root
    mode: "0755"
  become: true

- name: Check for Ubuntu {{ pxe_ubuntu_codename }} amd64 vmlinuz
  ansible.builtin.stat:
    path: "{{ pxe_http_root }}/ubuntu/{{ pxe_ubuntu_codename }}/vmlinuz"
  register: _pxe_ubuntu_amd64_vmlinuz

- name: Download Ubuntu {{ pxe_ubuntu_codename }} amd64 live-server ISO
  ansible.builtin.get_url:
    url: "{{ pxe_ubuntu_amd64_iso_url }}"
    dest: "{{ pxe_ubuntu_iso_dir }}/ubuntu-{{ pxe_ubuntu_codename }}-amd64.iso"
    mode: "0644"
  become: true
  when: not _pxe_ubuntu_amd64_vmlinuz.stat.exists

- name: Create amd64 ISO mount point
  ansible.builtin.file:
    path: "{{ pxe_ubuntu_iso_mount_dir }}/amd64"
    state: directory
    mode: "0755"
  become: true
  when: not _pxe_ubuntu_amd64_vmlinuz.stat.exists

- name: Mount Ubuntu amd64 ISO (loop)
  ansible.builtin.command:
    cmd: mount -o loop,ro "{{ pxe_ubuntu_iso_dir }}/ubuntu-{{ pxe_ubuntu_codename }}-amd64.iso" "{{ pxe_ubuntu_iso_mount_dir }}/amd64"
  become: true
  when: not _pxe_ubuntu_amd64_vmlinuz.stat.exists
  changed_when: true

- name: Extract vmlinuz + initrd from amd64 ISO
  ansible.builtin.copy:
    src: "{{ pxe_ubuntu_iso_mount_dir }}/amd64/casper/{{ item }}"
    dest: "{{ pxe_http_root }}/ubuntu/{{ pxe_ubuntu_codename }}/{{ item }}"
    remote_src: true
    mode: "0644"
  become: true
  loop:
    - vmlinuz
    - initrd
  when: not _pxe_ubuntu_amd64_vmlinuz.stat.exists

- name: Unmount Ubuntu amd64 ISO
  ansible.builtin.command:
    cmd: umount "{{ pxe_ubuntu_iso_mount_dir }}/amd64"
  become: true
  when: not _pxe_ubuntu_amd64_vmlinuz.stat.exists
  changed_when: true

# ── Ubuntu arm64 assets ────────────────────────────────────────────────────────

- name: Check for Ubuntu {{ pxe_ubuntu_codename }} arm64 vmlinuz
  ansible.builtin.stat:
    path: "{{ pxe_http_root }}/ubuntu/{{ pxe_ubuntu_codename }}-arm64/vmlinuz"
  register: _pxe_ubuntu_arm64_vmlinuz

- name: Download Ubuntu {{ pxe_ubuntu_codename }} arm64 live-server ISO
  ansible.builtin.get_url:
    url: "{{ pxe_ubuntu_arm64_iso_url }}"
    dest: "{{ pxe_ubuntu_iso_dir }}/ubuntu-{{ pxe_ubuntu_codename }}-arm64.iso"
    mode: "0644"
  become: true
  when: not _pxe_ubuntu_arm64_vmlinuz.stat.exists

- name: Create arm64 ISO mount point
  ansible.builtin.file:
    path: "{{ pxe_ubuntu_iso_mount_dir }}/arm64"
    state: directory
    mode: "0755"
  become: true
  when: not _pxe_ubuntu_arm64_vmlinuz.stat.exists

- name: Mount Ubuntu arm64 ISO (loop)
  ansible.builtin.command:
    cmd: mount -o loop,ro "{{ pxe_ubuntu_iso_dir }}/ubuntu-{{ pxe_ubuntu_codename }}-arm64.iso" "{{ pxe_ubuntu_iso_mount_dir }}/arm64"
  become: true
  when: not _pxe_ubuntu_arm64_vmlinuz.stat.exists
  changed_when: true

- name: Extract vmlinuz + initrd from arm64 ISO
  ansible.builtin.copy:
    src: "{{ pxe_ubuntu_iso_mount_dir }}/arm64/casper/{{ item }}"
    dest: "{{ pxe_http_root }}/ubuntu/{{ pxe_ubuntu_codename }}-arm64/{{ item }}"
    remote_src: true
    mode: "0644"
  become: true
  loop:
    - vmlinuz
    - initrd
  when: not _pxe_ubuntu_arm64_vmlinuz.stat.exists

- name: Unmount Ubuntu arm64 ISO
  ansible.builtin.command:
    cmd: umount "{{ pxe_ubuntu_iso_mount_dir }}/arm64"
  become: true
  when: not _pxe_ubuntu_arm64_vmlinuz.stat.exists
  changed_when: true
</file>

