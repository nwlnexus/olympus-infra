#!/usr/bin/env bash
# Managed by Ansible (ansible-pull role) — do not edit manually
#
# Runs ansible-pull for this host. Invoked hourly by:
#   Linux:  ansible-pull.timer → ansible-pull.service (User={{ ansible_pull_user }})
#   macOS:  /Library/LaunchDaemons/com.olympus.ansible-pull.plist (UserName={{ ansible_pull_user }})
# To run by hand, prefer the scheduler so the environment matches:
#   Linux:  sudo systemctl start ansible-pull.service
#   macOS:  sudo launchctl kickstart system/com.olympus.ansible-pull
#
# Exit codes (non-zero always means the run did not complete):
#   0       ansible-pull succeeded
#   1-99    ansible-pull's own exit code (2 = a host failed, 4 = parse error, 5 = bad options, ...)
#   70      malformed Hermes classify response          (EX_SOFTWARE)
#   73      a state/runtime/log directory is not writable (EX_CANTCREAT)
#   75      Hermes unreachable and no cached classify      (EX_TEMPFAIL)
#   77      a credential file exists but is not readable   (EX_NOPERM)
#   78      required configuration/credential missing      (EX_CONFIG)
set -euo pipefail

HERMES_URL="{{ hermes_url | default('https://api.nwlnexus.io') }}"

# Paths. Each accepts a WRAPPER_<NAME> env-var override (BATS tests point them
# at a sandbox; the macOS LaunchDaemon passes the state/runtime dirs).
# Under systemd, StateDirectory=/RuntimeDirectory= export STATE_DIRECTORY and
# RUNTIME_DIRECTORY; those win over the baked-in defaults.
HERMES_TOKEN_FILE="${WRAPPER_HERMES_TOKEN_FILE:-/etc/olympus/hermes-token}"
HERMES_DISABLED_FLAG="${WRAPPER_HERMES_DISABLED_FLAG:-/etc/olympus/hermes-disabled}"
OP_TOKEN_FILE="${WRAPPER_OP_TOKEN_FILE:-/etc/olympus/op-service-account-token}"

CACHE_DIR="${WRAPPER_CACHE_DIR:-${STATE_DIRECTORY:-{{ ansible_pull_state_dir }}}}"
CACHE_FILE="$CACHE_DIR/classify.json"
PENDING_DIR="${WRAPPER_PENDING_DIR:-$CACHE_DIR/pending-completions}"
RUNTIME_DIR="${WRAPPER_RUNTIME_DIR:-${RUNTIME_DIRECTORY:-{{ ansible_pull_runtime_dir }}}}"
LOG_DIR="${WRAPPER_LOG_DIR:-{{ ansible_pull_log_dir }}}"
LOG_FILE="${WRAPPER_LOG_FILE:-{{ ansible_pull_log_file }}}"
RUN_LOG="$RUNTIME_DIR/last-run.log"

PARSER="${WRAPPER_PARSER:-/opt/ansible-pull/parse-play-recap.sh}"

{% if ansible_facts['os_family'] == 'Darwin' %}
# ── macOS: set platform-specific env and binary ──────────────────────────────
export HOME="/var/{{ ansible_pull_user }}"
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:${PATH}"
export DOCKER_HOST="unix:///var/run/docker.sock"
ANSIBLE_PULL_BIN="${WRAPPER_ANSIBLE_PULL_BIN:-{{ ansible_pull_bin_macos }}}"
{% else %}
# ── Linux: ensure user-local bin is on PATH ───────────────────────────────────
export HOME="/home/{{ ansible_pull_user }}"
export PATH="${HOME}/.local/bin:${PATH}"
ANSIBLE_PULL_BIN="${WRAPPER_ANSIBLE_PULL_BIN:-{{ ansible_pull_bin_linux }}}"
{% endif %}

# ── Logging ──────────────────────────────────────────────────────────────────
# Status lines go to stderr (journal on Linux, launchd.log on macOS, the
# terminal when run by hand) AND to $LOG_FILE once it is writable, so a
# failure is visible whichever one you look at. ansible-pull's own output
# goes to $LOG_FILE and to a per-run copy in $RUN_LOG.
log() {
  local level="$1"; shift
  local line
  line="$(date -u '+%Y-%m-%d %H:%M:%S') [$level] $*"
  printf '%s\n' "$line" >&2
  if [[ -w "$LOG_FILE" || ( ! -e "$LOG_FILE" && -w "$LOG_DIR" ) ]]; then
    printf '%s\n' "$line" >> "$LOG_FILE" 2>/dev/null || true
  fi
}

die() {
  local rc="$1"; shift
  log FATAL "$* (exit $rc)"
  exit "$rc"
}

# Create a directory if needed and prove it is writable by the current user.
# Never fails silently: an unwritable dir is a fatal, explained error.
ensure_dir() {
  local dir="$1" what="$2"
  if ! mkdir -p "$dir" 2>/dev/null || [[ ! -w "$dir" ]]; then
    die 73 "$what directory $dir is missing or not writable by user $(id -un);" \
      "the ansible-pull role creates it (Linux: systemd StateDirectory/RuntimeDirectory," \
      "macOS: owned by {{ ansible_pull_user }}). Re-run the ansible-pull role or set WRAPPER_${3}"
  fi
}

ensure_dir "$LOG_DIR" "log" LOG_DIR
ensure_dir "$CACHE_DIR" "state" CACHE_DIR
ensure_dir "$PENDING_DIR" "pending-completions" PENDING_DIR
ensure_dir "$RUNTIME_DIR" "runtime" RUNTIME_DIR

log INFO "Starting Ansible Pull (state=$CACHE_DIR runtime=$RUNTIME_DIR log=$LOG_FILE)"

[[ -x "$ANSIBLE_PULL_BIN" ]] || command -v "$ANSIBLE_PULL_BIN" >/dev/null 2>&1 \
  || die 78 "ansible-pull binary not found at $ANSIBLE_PULL_BIN"

# ── 1. 1Password auth ─────────────────────────────────────────────────────────
# Export the service-account token only. Roles call `op` with plain (non-JSON)
# output, which 1Password Connect rejects ("Connect can only be used in
# combination with the JSON output format"), and `op` prefers Connect whenever
# OP_CONNECT_* is set, so exporting Connect here breaks every role that reads a
# secret. Roles that want Connect set OP_CONNECT_* at the task level.
if [[ ! -e "$OP_TOKEN_FILE" ]]; then
  die 78 "OP service-account token not found at $OP_TOKEN_FILE; bootstrap must place it before pulls can run"
fi
[[ -r "$OP_TOKEN_FILE" ]] || die 77 "OP service-account token $OP_TOKEN_FILE is not readable by user $(id -un)"

unset OP_CONNECT_HOST OP_CONNECT_TOKEN
export OP_SERVICE_ACCOUNT_TOKEN
OP_SERVICE_ACCOUNT_TOKEN=$(cat "$OP_TOKEN_FILE")
log INFO "1Password: using service-account token"

# ── 2. Hermes disabled? ───────────────────────────────────────────────────────
HERMES_ENABLED=1
if [[ -f "$HERMES_DISABLED_FLAG" ]]; then
  HERMES_ENABLED=0
  log INFO "Hermes integration disabled ($HERMES_DISABLED_FLAG present); running without classify"
fi

RUN_ID=""
LOG_UPLOAD_URL=""
classify_json='{"extra_roles": []}'

if [[ "$HERMES_ENABLED" -eq 1 ]]; then
  command -v jq >/dev/null 2>&1 || die 78 "jq is required for Hermes classify but is not on PATH"
  command -v curl >/dev/null 2>&1 || die 78 "curl is required for Hermes classify but is not on PATH"

  # ── 3. Hermes token ───────────────────────────────────────────────────────
  if [[ ! -s "$HERMES_TOKEN_FILE" ]]; then
    die 78 "Hermes token missing at $HERMES_TOKEN_FILE; place it or create $HERMES_DISABLED_FLAG"
  fi
  [[ -r "$HERMES_TOKEN_FILE" ]] || die 77 "Hermes token $HERMES_TOKEN_FILE is not readable by user $(id -un)"
  HERMES_TOKEN=$(cat "$HERMES_TOKEN_FILE")

  # ── 4. Drain pending completions ─────────────────────────────────────────
  for pending in "$PENDING_DIR"/*.json; do
    [[ -e "$pending" ]] || break
    pid=$(basename "$pending" .json)
    body=$(cat "$pending")
    log INFO "retrying pending completion for run $pid"
    if curl -fsS --max-time 5 -X POST "$HERMES_URL/v1/pull/runs/$pid" \
         -H "Authorization: Bearer $HERMES_TOKEN" \
         -H "Content-Type: application/json" \
         -d "$body" >/dev/null; then
      rm -f "$pending"
    else
      log WARN "pending completion for run $pid still failing; leaving it queued"
    fi
  done

  # ── 5. Start run ─────────────────────────────────────────────────────────
  STARTED_AT=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
  CLASSIFY_ETAG=$(jq -r '.etag // ""' "$CACHE_FILE" 2>/dev/null || echo "")
  start_body=$(jq -nc --arg s "$STARTED_AT" --arg e "$CLASSIFY_ETAG" \
    '{started_at: $s, classify_etag: (if $e=="" then null else $e end)}')

  for i in 1 2 3; do
    if start_resp=$(curl -fsS --max-time 5 -X POST "$HERMES_URL/v1/pull/runs" \
                       -H "Authorization: Bearer $HERMES_TOKEN" \
                       -H "Content-Type: application/json" \
                       -d "$start_body"); then
      RUN_ID=$(echo "$start_resp" | jq -r .run_id)
      LOG_UPLOAD_URL=$(echo "$start_resp" | jq -r .log_upload_url)
      break
    fi
    sleep $((i * 2))
  done
  if [[ -z "$RUN_ID" ]]; then
    log WARN "failed to start run with Hermes (after 3 retries); continuing without server-side record"
  fi

  # ── 6. Fetch classify ────────────────────────────────────────────────────
  fetched=""
  for i in 1 2 3; do
    if fetched=$(curl -fsS --max-time 5 -H "Authorization: Bearer $HERMES_TOKEN" \
                     "$HERMES_URL/v1/pull/classify"); then
      break
    fi
    fetched=""
    sleep $((i * 2))
  done
  if [[ -n "$fetched" ]]; then
    if ! echo "$fetched" | jq -e '.extra_roles | type == "array"' >/dev/null 2>&1; then
      die 70 "malformed classify response from $HERMES_URL (no .extra_roles array)"
    fi
    classify_json="$fetched"
    echo "$classify_json" > "$CACHE_FILE.tmp" && mv "$CACHE_FILE.tmp" "$CACHE_FILE"
  elif [[ -f "$CACHE_FILE" ]]; then
{% if ansible_facts['os_family'] == 'Darwin' %}
    log WARN "Hermes unreachable for classify; using cache from $(stat -f %Sm "$CACHE_FILE")"
{% else %}
    log WARN "Hermes unreachable for classify; using cache from $(stat -c %y "$CACHE_FILE")"
{% endif %}
    classify_json=$(cat "$CACHE_FILE")
  else
    die 75 "Hermes unreachable at $HERMES_URL and no cached classify at $CACHE_FILE"
  fi
fi

# ── 7. Materialize layered vars files ────────────────────────────────────────
# Always write all five files so every --extra-vars @file below exists and
# parses. Each is a JSON object (valid YAML); an empty file would make
# ansible reject it ("could not be made into a dictionary", exit 5). Stale
# files from an earlier Hermes-enabled run are removed first.
rm -f "$RUNTIME_DIR"/*.yml
if [[ "$HERMES_ENABLED" -eq 1 ]]; then
  echo "$classify_json" | jq -c '.vars_global // {}' > "$RUNTIME_DIR/00-global.yml"
  echo "$classify_json" | jq -c '[.vars_tags // {} | to_entries[] | .value] | add // {}' > "$RUNTIME_DIR/10-tags.yml"
  echo "$classify_json" | jq -c '[.vars_roles // {} | to_entries[] | .value] | add // {}' > "$RUNTIME_DIR/20-roles.yml"
  echo "$classify_json" | jq -c '.vars_host // {}' > "$RUNTIME_DIR/30-host.yml"
  echo "$classify_json" | jq -c '{hermes_extra_roles: .extra_roles}' > "$RUNTIME_DIR/99-roles.yml"
else
  for f in 00-global 10-tags 20-roles 30-host; do
    echo '{}' > "$RUNTIME_DIR/$f.yml"
  done
  echo '{"hermes_extra_roles": []}' > "$RUNTIME_DIR/99-roles.yml"
fi

# ── 8. Run ansible-pull ──────────────────────────────────────────────────────
log INFO "Running $ANSIBLE_PULL_BIN -U {{ ansible_pull_repo }} -i {{ ansible_pull_inventory }}{% if ansible_pull_limit | default('') != '' %} --limit {{ ansible_pull_limit }}{% endif %}{% if ansible_pull_skip_tags | default('') != '' %} --skip-tags {{ ansible_pull_skip_tags }}{% endif %} {{ ansible_pull_playbook }}"
START_S=$(date +%s)
: > "$RUN_LOG"
set +e
"$ANSIBLE_PULL_BIN" \
  -U {{ ansible_pull_repo }} \
  -i {{ ansible_pull_inventory }} \
  --extra-vars "@$RUNTIME_DIR/00-global.yml" \
  --extra-vars "@$RUNTIME_DIR/10-tags.yml" \
  --extra-vars "@$RUNTIME_DIR/20-roles.yml" \
  --extra-vars "@$RUNTIME_DIR/30-host.yml" \
  --extra-vars "@$RUNTIME_DIR/99-roles.yml" \
{% if ansible_pull_limit | default('') != '' %}
  --limit "{{ ansible_pull_limit }}" \
{% endif %}
{% if ansible_pull_skip_tags | default('') != '' %}
  --skip-tags "{{ ansible_pull_skip_tags }}" \
{% endif %}
  {{ ansible_pull_playbook }} 2>&1 | tee -a "$LOG_FILE" >> "$RUN_LOG"
RC=${PIPESTATUS[0]}
set -e
DURATION_MS=$(( ($(date +%s) - START_S) * 1000 ))

if [[ "$RC" -eq 0 ]]; then
  log INFO "ansible-pull succeeded in $((DURATION_MS / 1000))s"
else
  log ERROR "ansible-pull FAILED with exit code $RC after $((DURATION_MS / 1000))s; last lines of output:"
  tail -n 25 "$RUN_LOG" >&2 || true
fi

# ── 9. Parse counters + upload log + post completion ─────────────────────────
if [[ "$HERMES_ENABLED" -eq 1 && -n "$RUN_ID" ]]; then
  counters=$("$PARSER" "$RUN_LOG")
  FINISHED_AT=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
  AUDIT_LOG_KEY="null"

  if [[ -n "$LOG_UPLOAD_URL" ]]; then
    if upload_resp=$(curl -fsS --max-time 30 -X PUT \
                          -H "Authorization: Bearer $HERMES_TOKEN" \
                          --data-binary "@$RUN_LOG" \
                          "$HERMES_URL$LOG_UPLOAD_URL"); then
      key=$(echo "$upload_resp" | jq -r '.audit_log_key // empty')
      if [[ -n "$key" ]]; then
        AUDIT_LOG_KEY=$(jq -nc --arg k "$key" '$k')
      fi
    else
      log WARN "log upload failed; completion will be posted without audit_log_key"
    fi
  fi

  complete_body=$(jq -nc \
    --arg fa "$FINISHED_AT" \
    --argjson rc "$RC" \
    --argjson dur "$DURATION_MS" \
    --argjson c "$counters" \
    --argjson akey "$AUDIT_LOG_KEY" \
    '{finished_at:$fa, exit_code:$rc, duration_ms:$dur,
      ok_count:$c.ok, changed_count:$c.changed, failed_count:$c.failed,
      skipped_count:$c.skipped, unreachable_count:$c.unreachable,
      audit_log_key:$akey}')

  if ! curl -fsS --max-time 10 -X POST "$HERMES_URL/v1/pull/runs/$RUN_ID" \
         -H "Authorization: Bearer $HERMES_TOKEN" \
         -H "Content-Type: application/json" \
         -d "$complete_body" >/dev/null; then
    log WARN "completion POST failed; queueing pending"
    echo "$complete_body" > "$PENDING_DIR/$RUN_ID.json"
  fi
fi

exit "$RC"
