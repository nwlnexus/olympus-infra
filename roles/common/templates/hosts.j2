# /etc/hosts — Managed by Ansible common role
127.0.0.1   localhost
127.0.1.1   {{ inventory_hostname_short }} {{ inventory_hostname }}

# The following lines are desirable for IPv6 capable hosts
::1         localhost ip6-localhost ip6-loopback
ff02::1     ip6-allnodes
ff02::2     ip6-allrouters
{% if common_hosts_entries is defined %}

# Custom host entries
{% for entry in common_hosts_entries %}
{{ entry.ip }}   {{ entry.names | join(' ') }}
{% endfor %}
{% endif %}
