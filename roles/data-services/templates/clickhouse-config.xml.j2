<!-- Managed by Ansible — do not edit manually -->
<clickhouse>
  <logger>
    <level>information</level>
    <log>{{ data_services_nvme_root }}/logs/clickhouse/clickhouse-server.log</log>
    <errorlog>{{ data_services_nvme_root }}/logs/clickhouse/clickhouse-server.err.log</errorlog>
    <size>500M</size>
    <count>10</count>
  </logger>

  <http_port>{{ data_services_clickhouse_http_port }}</http_port>
  <tcp_port>{{ data_services_clickhouse_native_port }}</tcp_port>
  <interserver_http_port>{{ data_services_clickhouse_replication_port }}</interserver_http_port>

  <listen_host>{{ data_services_tailscale_ip }}</listen_host>

  <path>{{ data_services_nvme_root }}/data/clickhouse/</path>
  <tmp_path>{{ data_services_nvme_root }}/data/clickhouse/tmp/</tmp_path>
  <user_files_path>{{ data_services_nvme_root }}/data/clickhouse/user_files/</user_files_path>
  <format_schema_path>{{ data_services_nvme_root }}/data/clickhouse/format_schemas/</format_schema_path>

  <users_config>{{ data_services_nvme_root }}/config/clickhouse/users.xml</users_config>

  <max_connections>4096</max_connections>
  <max_server_memory_usage_to_ram_ratio>0.20</max_server_memory_usage_to_ram_ratio>

  <!-- Query logging: this custom config replaces ClickHouse's default (which
       ships <query_log> enabled), so without this block system.query_log is
       never created and query-log-backed dashboards fail with UNKNOWN_TABLE.
       TTL bounds disk on the Mac Studio. See olympus-sdk#254. -->
  <query_log>
    <database>system</database>
    <table>query_log</table>
    <engine>ENGINE = MergeTree PARTITION BY event_date ORDER BY event_time TTL event_date + INTERVAL 14 DAY DELETE</engine>
    <flush_interval_milliseconds>7500</flush_interval_milliseconds>
  </query_log>
</clickhouse>
