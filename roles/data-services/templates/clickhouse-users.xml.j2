<!-- Managed by Ansible — do not edit manually -->
<clickhouse>
  <users>
    <default>
      <password_sha256_hex>{{ clickhouse_admin_password | hash('sha256') }}</password_sha256_hex>
      <networks>
        <ip>127.0.0.1</ip>
        <ip>::1</ip>
        <!-- Tailscale CGNAT range -->
        <ip>{{ data_services_tailscale_cidr }}</ip>
      </networks>
      <profile>default</profile>
      <quota>default</quota>
    </default>
  </users>
  <profiles>
    <default>
      <max_memory_usage>10000000000</max_memory_usage>
      <use_uncompressed_cache>0</use_uncompressed_cache>
      <load_balancing>random</load_balancing>
      <!-- Disable runtime expression JIT: this Homebrew build (v26.5.x) throws
           CANNOT_COMPILE_CODE "Could not find symbol …" on compiled expressions,
           breaking cluster-info / telemetry panels. See olympus-sdk#254. -->
      <compile_expressions>0</compile_expressions>
      <compile_aggregate_expressions>0</compile_aggregate_expressions>
    </default>
  </profiles>
  <quotas>
    <default>
      <interval>
        <duration>3600</duration>
        <queries>0</queries>
        <errors>0</errors>
        <result_rows>0</result_rows>
        <read_rows>0</read_rows>
        <execution_time>0</execution_time>
      </interval>
    </default>
  </quotas>
</clickhouse>
