<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.olympus.ollama</string>
  <key>UserName</key>
  <string>_ollama</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/ollama</string>
    <string>serve</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>OLLAMA_HOST</key>
    <string>0.0.0.0</string>
    <key>OLLAMA_MODELS</key>
    <string>{{ data_services_ollama_model_dir }}</string>
    <key>HOME</key>
    <string>{{ data_services_nvme_root }}/data/ollama</string>
    <key>OLLAMA_KEEP_ALIVE</key>
    <string>{{ data_services_ollama_keep_alive }}</string>
    <key>OLLAMA_MAX_LOADED_MODELS</key>
    <string>{{ data_services_ollama_max_loaded_models }}</string>
    <key>OLLAMA_NUM_PARALLEL</key>
    <string>{{ data_services_ollama_num_parallel }}</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>{{ data_services_nvme_root }}/logs/ollama/stdout.log</string>
  <key>StandardErrorPath</key>
  <string>{{ data_services_nvme_root }}/logs/ollama/stderr.log</string>
</dict>
</plist>
