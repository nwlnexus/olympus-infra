<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.olympus.postgres</string>
  <key>UserName</key>
  <string>_postgres</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/usr/local/bin/postgres-serve</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PGDATA</key>
    <string>{{ data_services_nvme_root }}/data/postgres</string>
    <key>LC_ALL</key>
    <string>en_US.UTF-8</string>
    <key>LANG</key>
    <string>en_US.UTF-8</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>{{ data_services_nvme_root }}/data/postgres</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>{{ data_services_nvme_root }}/logs/postgres/stdout.log</string>
  <key>StandardErrorPath</key>
  <string>{{ data_services_nvme_root }}/logs/postgres/stderr.log</string>
</dict>
</plist>
