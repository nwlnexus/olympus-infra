# Managed by Ansible — do not edit manually
bind 0.0.0.0
port {{ data_services_redis_port }}
protected-mode no

requirepass {{ redis_password }}

# Persistence — RDB + AOF
dir {{ data_services_nvme_root }}/data/redis
dbfilename dump.rdb
save 900 1
save 300 10
save 60 10000

appendonly yes
appendfilename appendonly.aof
appendfsync everysec

# Logging
loglevel notice
logfile {{ data_services_nvme_root }}/logs/redis/redis.log

# Memory
maxmemory 8gb
maxmemory-policy allkeys-lru
