<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.olympus.nfs.{{ iscsi_mount_path | replace('/', '_') }}</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>mount -t nfs -o resvport {{ iscsi_portal }}:/compute-hub/ai-hub {{ iscsi_mount_path }} 2>/dev/null || true</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/var/log/olympus-nfs-mount.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/olympus-nfs-mount.log</string>
</dict>
</plist>
