{# Kubernetes API audit policy for the k3s servers (tasks/audit-log.yml).
   kube-apiserver applies the FIRST rule that matches a request, so the order is
   the policy. Metadata never records request or response bodies; Request records
   the request body only (never the response). Within one rule `users` and
   `userGroups` are ANDed, so machine identities get two sibling rules: one by
   group, one by the control-plane user list below. tests/k3s-join-server checks
   the order and the keys. #}
{# Control-plane and k3s identities (k3s v1.35 pkg/daemons/control/deps/deps.go,
   pkg/server/handlers/handlers.go). One list, used by every machine rule. #}
{% set _cp_users = [
     'system:kube-proxy',
     'system:kube-controller-manager',
     'system:kube-scheduler',
     'system:apiserver',
     'system:k3s-supervisor',
     'system:k3s-controller',
     'k3s-cloud-controller-manager',
   ] %}
{% set _machine_groups = ['system:nodes', 'system:serviceaccounts'] %}
{% macro cp_users() %}
    users:
      - "{{ _cp_users | join('"\n      - "') }}"
{%- endmacro %}
{% macro status_resources() %}
    resources:
{% for g in k3s_audit_machine_status_groups %}
      - group: "{{ g }}"
        resources: ["*/status"]
{% endfor %}
{%- endmacro %}
{% macro machine_groups() %}
    userGroups:
      - "{{ _machine_groups | join('"\n      - "') }}"
{%- endmacro %}
# Managed by Ansible (roles/k3s, tasks/audit-log.yml); local edits are overwritten.
apiVersion: audit.k8s.io/v1
kind: Policy
omitStages:
  - RequestReceived
rules:
  # a. Health, metrics, version and OpenAPI probes: never logged.
  - level: None
    nonResourceURLs:
      - "/healthz*"
      - "/readyz*"
      - "/livez*"
      - "/metrics"
      - "/version"
      - "/openapi*"
{% if k3s_audit_discovery_drop_users | default([]) | length > 0 %}
  # a2. API discovery (GET /api, /apis and the group-version documents under them) by
  #     these always-recorded users: a client's background discovery polling, which
  #     names no object. Before rule b; every resource request they make is still
  #     recorded. nonResourceURLs never match a resource request.
  - level: None
    users:
{% for u in k3s_audit_discovery_drop_users %}
      - "{{ u }}"
{% endfor %}
    verbs: ["get"]
    nonResourceURLs:
      - "/api"
      - "/api/*"
      - "/apis"
      - "/apis/*"
{% endif %}
{% if k3s_audit_always_log_users | default([]) | length > 0 %}
  # b. Always-recorded users (agent identities): every request, reads included.
  - level: Metadata
    users:
{% for u in k3s_audit_always_log_users %}
      - "{{ u }}"
{% endfor %}
{% endif %}
{% if k3s_audit_always_log_groups | default([]) | length > 0 %}
  # b. Always-recorded groups (agent identities): every request, reads included.
  - level: Metadata
    userGroups:
{% for g in k3s_audit_always_log_groups %}
      - "{{ g }}"
{% endfor %}
{% endif %}
{% if k3s_audit_drop_lease_names | default([]) | length > 0 %}
  # c. Control-plane VIP election (kube-vip): get/update of these named Leases every
  #    few seconds. The client uses the admin identity, so it is matched by Lease name,
  #    not by user. Create and delete of those Leases are still recorded, and so are
  #    list/watch (resourceNames never matches a request without a name).
  - level: None
    verbs: ["get", "list", "watch", "update", "patch"]
    namespaces: ["kube-system"]
    resources:
      - group: "coordination.k8s.io"
        resources: ["leases"]
        resourceNames:
{% for n in k3s_audit_drop_lease_names %}
          - "{{ n }}"
{% endfor %}
{% endif %}
{% for e in k3s_audit_drop_election_endpoints | default([]) %}
  # c. Leader election on a named Endpoints object ({{ e.namespace }}/{{ e.name }}):
  #    get/update every few seconds by a ServiceAccount of that namespace. Create and
  #    delete, and any other user, are still recorded.
  - level: None
    userGroups:
      - "system:serviceaccounts:{{ e.namespace }}"
    verbs: ["get", "update", "patch"]
    namespaces: ["{{ e.namespace }}"]
    resources:
      - group: ""
        resources: ["endpoints"]
        resourceNames: ["{{ e.name }}"]
{% endfor %}
{% for w in k3s_audit_drop_sa_writes | default([]) %}
  # c. Routine writes by the ServiceAccounts of {{ w.namespace }} to {{ w.group }}
  #    {{ w.resources | join(', ') }} (update/patch only; create and delete are recorded).
  - level: None
    userGroups:
      - "system:serviceaccounts:{{ w.namespace }}"
    verbs: ["update", "patch"]
    resources:
      - group: "{{ w.group }}"
        resources: ["{{ w.resources | join('", "') }}"]
{% endfor %}
  # c. Node reads (kubelets): constant watch traffic.
  - level: None
    userGroups:
      - "system:nodes"
    verbs: ["get", "list", "watch"]
  # c. Control-plane and k3s supervisor reads: constant watch traffic.
  - level: None
{{ cp_users() }}
    verbs: ["get", "list", "watch"]
{% if k3s_audit_machine_status_groups | default([]) | length > 0 %}
  # c. Status subresource writes by nodes and ServiceAccounts (kubelet heartbeats,
  #    controllers reporting their own status): a status write cannot change a spec.
  #    People fall through.
  - level: None
{{ machine_groups() }}
    verbs: ["update", "patch"]
{{ status_resources().rstrip() }}
  # c. Status subresource writes by the control plane.
  - level: None
{{ cp_users() }}
    verbs: ["update", "patch"]
{{ status_resources().rstrip() }}
{% endif %}
  # c. Access reviews (authorization.k8s.io) asked by nodes and ServiceAccounts:
  #    webhook authorization of kubelets and aggregated APIs, a question, never a
  #    change. Token reviews stay recorded (rule d). People fall through.
  - level: None
{{ machine_groups() }}
    verbs: ["create"]
    resources:
      - group: "authorization.k8s.io"
  # c. Access reviews asked by the control plane.
  - level: None
{{ cp_users() }}
    verbs: ["create"]
    resources:
      - group: "authorization.k8s.io"
  # c. Leader-election leases renewed by nodes and ServiceAccounts (people fall through).
  - level: None
{{ machine_groups() }}
    verbs: ["get", "list", "watch", "update", "patch"]
    resources:
      - group: "coordination.k8s.io"
        resources: ["leases"]
  # c. Leader-election leases renewed by the control plane.
  - level: None
{{ cp_users() }}
    verbs: ["get", "list", "watch", "update", "patch"]
    resources:
      - group: "coordination.k8s.io"
        resources: ["leases"]
  # c. Events written and read by nodes and ServiceAccounts (people fall through).
  - level: None
{{ machine_groups() }}
    resources:
      - group: ""
        resources: ["events"]
      - group: "events.k8s.io"
        resources: ["events"]
  # c. Events written and read by the control plane.
  - level: None
{{ cp_users() }}
    resources:
      - group: ""
        resources: ["events"]
      - group: "events.k8s.io"
        resources: ["events"]
  # d. Secrets, ConfigMaps, token requests and token reviews: who touched what,
  #    never the content (Metadata records no bodies). Before every Request rule.
  - level: Metadata
    resources:
      - group: ""
        resources: ["secrets", "configmaps", "serviceaccounts/token"]
      - group: "authentication.k8s.io"
        resources: ["tokenreviews"]
  # e. Other ServiceAccount reads (controllers and operators): noise. The agent
  #    identities matched rule b, and Secrets/ConfigMaps matched rule d.
  - level: None
    userGroups:
      - "system:serviceaccounts"
    verbs: ["get", "list", "watch"]
  # f1. Writes by nodes and ServiceAccounts: recorded without bodies.
  - level: Metadata
{{ machine_groups() }}
    verbs: ["create", "update", "patch", "delete", "deletecollection"]
  # f1. Writes by the control plane: recorded without bodies.
  - level: Metadata
{{ cp_users() }}
    verbs: ["create", "update", "patch", "delete", "deletecollection"]
  # f2. Writes by everyone else (people): with the request body.
  - level: Request
    verbs: ["create", "update", "patch", "delete", "deletecollection"]
  # g. Everything else (remaining reads by people and other clients).
  - level: Metadata
