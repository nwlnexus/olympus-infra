---
# kube-vip for the k3s control plane: ServiceAccount + RBAC + DaemonSet.
# Written to every server's auto-deploy manifests directory
# (/var/lib/rancher/k3s/server/manifests/kube-vip.yaml); k3s applies it as the
# `kube-vip` Addon. Manages the API server VIP in ARP mode, with Lease
# leader election so the VIP moves when its holder dies.
#
# This file MUST render byte-identical on every server. k3s does not sync
# add-on content between servers: each server applies its own copy to the same
# Addon, and differing copies fight. So nothing host-specific belongs here:
#   - vip_interface is deliberately unset. kube-vip v0.8.9 then binds to the
#     interface of the default route, and exits (the pod restarts) if that
#     route is deleted.
#   - Each pod talks to its own node's apiserver: k3s's local kubeconfig is
#     mounted as admin.conf and "kubernetes" resolves to 127.0.0.1. A leader
#     whose apiserver dies cannot renew the lease, so the VIP moves.
#
# Based on `kube-vip manifest daemonset` (v0.8.9) and
# https://kube-vip.io/manifests/rbac.yaml. The ServiceAccount and RBAC are
# unused while admin.conf is mounted (kube-vip prefers it); they are kept so the
# DaemonSet matches upstream.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: kube-vip
  namespace: kube-system
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  annotations:
    rbac.authorization.kubernetes.io/autoupdate: "true"
  name: system:kube-vip-role
rules:
  - apiGroups: [""]
    resources: ["services/status"]
    verbs: ["update"]
  - apiGroups: [""]
    resources: ["services", "endpoints"]
    verbs: ["list", "get", "watch", "update"]
  - apiGroups: [""]
    resources: ["nodes"]
    verbs: ["list", "get", "watch", "update", "patch"]
  - apiGroups: ["coordination.k8s.io"]
    resources: ["leases"]
    verbs: ["list", "get", "watch", "update", "create"]
  - apiGroups: ["discovery.k8s.io"]
    resources: ["endpointslices"]
    verbs: ["list", "get", "watch", "update"]
  - apiGroups: [""]
    resources: ["pods"]
    verbs: ["list"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: system:kube-vip-binding
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: system:kube-vip-role
subjects:
  - kind: ServiceAccount
    name: kube-vip
    namespace: kube-system
---
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: kube-vip-ds
  namespace: kube-system
  labels:
    app.kubernetes.io/name: kube-vip-ds
    app.kubernetes.io/version: v0.8.9
spec:
  selector:
    matchLabels:
      app.kubernetes.io/name: kube-vip-ds
  template:
    metadata:
      labels:
        app.kubernetes.io/name: kube-vip-ds
        app.kubernetes.io/version: v0.8.9
    spec:
      nodeSelector:
        node-role.kubernetes.io/control-plane: "true"
      # Run on every control-plane node whatever its taints
      # (node-role.kubernetes.io/control-plane, CriticalAddonsOnly, ...).
      tolerations:
        - effect: NoSchedule
          operator: Exists
        - effect: NoExecute
          operator: Exists
      serviceAccountName: kube-vip
      priorityClassName: system-node-critical
      hostNetwork: true
      hostAliases:
        - hostnames:
            - kubernetes
          ip: 127.0.0.1
      containers:
        - name: kube-vip
          image: ghcr.io/kube-vip/kube-vip:v0.8.9
          imagePullPolicy: IfNotPresent
          args:
            - manager
          env:
            - name: vip_arp
              value: "true"
            - name: port
              value: "6443"
            - name: vip_nodename
              valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
            - name: vip_cidr
              value: "32"
            - name: cp_enable
              value: "true"
            - name: cp_namespace
              value: kube-system
            - name: vip_leaderelection
              value: "true"
            - name: vip_leasename
              value: plndr-cp-lock
            - name: vip_leaseduration
              value: "5"
            - name: vip_renewdeadline
              value: "3"
            - name: vip_retryperiod
              value: "1"
            - name: address
              value: "{{ k3s_vip }}"
            - name: prometheus_server
              value: ":2112"
          volumeMounts:
            - mountPath: /etc/kubernetes/admin.conf
              name: kubeconfig
          resources:
            requests:
              cpu: 10m
              memory: 32Mi
          securityContext:
            capabilities:
              add:
                - NET_ADMIN
                - NET_RAW
                - SYS_TIME
      volumes:
        - name: kubeconfig
          hostPath:
            path: /etc/rancher/k3s/k3s.yaml
            type: FileOrCreate
