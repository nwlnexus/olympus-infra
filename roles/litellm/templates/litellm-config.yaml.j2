# Managed by Ansible (roles/litellm) — do not edit by hand. Contains secrets (mode 0600).
#
# Aliases are the only names clients use. Everything routes to the local Ollama
# ({{ litellm_ollama_api_base }}), which is not reachable without going through here
# once its bind address is the tailnet/loopback only.
model_list:
  # memory pipeline: embeddings (768-dim) and fact/entity extraction
  - model_name: memory-embed
    litellm_params:
      model: ollama/{{ litellm_embed_model }}
      api_base: {{ litellm_ollama_api_base }}

  - model_name: memory-extract
    litellm_params:
      model: ollama_chat/{{ litellm_extract_model }}
      api_base: {{ litellm_ollama_api_base }}

  # coding executor (olympus-sdk #197): small/fast and large local models
  - model_name: coder-light
    litellm_params:
      model: ollama_chat/{{ litellm_coder_light_model }}
      api_base: {{ litellm_ollama_api_base }}

  - model_name: coder-heavy
    litellm_params:
      model: ollama_chat/{{ litellm_coder_heavy_model }}
      api_base: {{ litellm_ollama_api_base }}

{% if litellm_coder_cloud_enabled | bool %}
  # cloud fallback for the coding executor (real API spend)
  - model_name: coder-cloud
    litellm_params:
      model: {{ litellm_coder_cloud_model }}
      api_key: "{{ litellm_anthropic_api_key }}"
{% else %}
  # coder-cloud is DISABLED until an Anthropic key exists. To enable: store the key
  # at {{ litellm_anthropic_key_op_ref }} and set litellm_coder_cloud_enabled: true.
  #
  # - model_name: coder-cloud
  #   litellm_params:
  #     model: {{ litellm_coder_cloud_model }}
  #     api_key: <from 1Password>
{% endif %}

litellm_settings:
  drop_params: true
  request_timeout: {{ litellm_request_timeout }}

general_settings:
  master_key: "{{ litellm_master_key }}"
