<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.olympus.llama-server-watchdog</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/usr/local/bin/llama-server-watchdog</string>
    </array>
    <key>StartInterval</key>
    <integer>{{ llama_server_watchdog_interval }}</integer>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>{{ llama_server_watchdog_log }}</string>
    <key>StandardErrorPath</key>
    <string>{{ llama_server_watchdog_log }}</string>
</dict>
</plist>
