# dnsmasq — PXE proxyDHCP for {{ pxe_dhcp_network }}
# Acts alongside UniFi DHCP; injects arch-aware PXE boot options only.
# Does NOT allocate IP addresses.
#
# Two-stage chainloading:
#   Stage 1 — native PXE client: serve netboot.xyz binary from TFTP by arch
#   Stage 2 — iPXE already running (option 175 set): serve our custom menu URL
#
# This means ALL arches (x86_64, arm64, Raspberry Pi) converge on the same
# custom iPXE menu once netboot.xyz bootstraps iPXE on the client.

port=0                          # Disable DNS (PXE proxy only)
log-dhcp

# ProxyDHCP: respond to PXE requests on this subnet without allocating IPs
dhcp-range={{ pxe_dhcp_network.split('/')[0] }},proxy

# Stage 2 detection: iPXE sends DHCP option 175 when already running
dhcp-match=set:ipxe,175

# Stage 1 arch detection via DHCP option 93 (client system architecture)
dhcp-match=set:bios,option:client-arch,0
dhcp-match=set:efi-x86_64,option:client-arch,7
dhcp-match=set:efi-x86_64,option:client-arch,9
dhcp-match=set:efi-arm64,option:client-arch,11

# Stage 2: iPXE is running — serve our custom menu (all arches)
dhcp-boot=tag:ipxe,http://{{ pxe_server_ip }}:{{ pxe_http_port }}/menu/boot.ipxe

# Stage 1: native PXE client — serve netboot.xyz binary by arch (tag:!ipxe = not yet iPXE)
dhcp-boot=tag:!ipxe,tag:bios,netboot.xyz-undionly.kpxe,,{{ pxe_server_ip }}
dhcp-boot=tag:!ipxe,tag:efi-x86_64,netboot.xyz.efi,,{{ pxe_server_ip }}
dhcp-boot=tag:!ipxe,tag:efi-arm64,netboot.xyz-arm64.efi,,{{ pxe_server_ip }}
