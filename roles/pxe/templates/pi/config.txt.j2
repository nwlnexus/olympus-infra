# Raspberry Pi 4 / CM4 network boot config
# Generated by Ansible pxe role — do not edit manually
#
# Boot flow:
#   Pi EEPROM → TFTP (this config.txt) → loads netboot.xyz-arm64.efi as kernel
#   → iPXE starts → re-DHCPs with option 175 → dnsmasq serves our custom menu
#   → Ubuntu 24.04 arm64 autoinstall
#
# Requires Pi 4 EEPROM 2020-09-03 or later.
# Enable network boot: raspi-config → Advanced → Boot Order → Network Boot

# 64-bit mode required for EFI application boot
arm_64bit=1

# netboot.xyz ARM64 EFI binary — bootstraps iPXE for the two-stage chainload flow
kernel=netboot.xyz-arm64.efi

# Enable UART serial console (headless debug)
enable_uart=1

# Disable rainbow splash on boot
disable_splash=1
