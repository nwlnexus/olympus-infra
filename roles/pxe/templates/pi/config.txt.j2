# Raspberry Pi 4 / CM4 network boot config
# Generated by Ansible pxe role — do not edit manually

# Use 64-bit kernel
arm_64bit=1

# Ubuntu arm64 installer kernel + initrd (served from TFTP pi/ subdirectory)
# Stage these files: copy from Ubuntu 24.04 arm64 ISO casper/ directory into
#   {{ pxe_tftp_root }}/pi/vmlinuz
#   {{ pxe_tftp_root }}/pi/initrd
kernel=vmlinuz
initramfs initrd followkernel

# Enable UART serial console (headless debug)
enable_uart=1

# Disable rainbow splash on boot
disable_splash=1
