#!/usr/bin/env bash
# Fake `op` for tests/op-cache (olympus-sdk#1039). No network, no real token.
#   FAKE_OP_LOG    every call is appended here (one line: mode and argv)
#   FAKE_OP_MODE   ok (default) | ratelimit | error
#   FAKE_OP_VALUE  what `op read` prints
# Like the real CLI with OP_CONNECT_HOST/OP_CONNECT_TOKEN set, it rejects `op item get` without
# --format json ("Connect can only be used in combination with the JSON output format").
set -u
mode="${FAKE_OP_MODE:-ok}"
connect=0
[[ -n "${OP_CONNECT_HOST:-}" && -n "${OP_CONNECT_TOKEN:-}" ]] && connect=1
printf '%s connect=%s sa=%s %s\n' "$mode" "$connect" "${OP_SERVICE_ACCOUNT_TOKEN:+set}" "$*" >> "${FAKE_OP_LOG:?}"
if [[ "$mode" == ratelimit ]]; then
  echo "[ERROR] 2026/11/19 00:36:30 Too many requests. Your client has been rate-limited. Try again in 5 minutes" >&2
  exit 1
fi
if [[ "$mode" == error ]]; then
  echo "[ERROR] 2026/11/19 00:36:30 could not read secret: connection refused" >&2
  exit 1
fi
if [[ "$connect" == 1 && "${1:-}" == item && " $* " != *" --format json "* && " $* " != *" --format=json "* ]]; then
  echo "[ERROR] Connect can only be used in combination with the JSON output format" >&2
  exit 1
fi
case "${1:-}" in
  read)
    [[ "${2:-}" == op://*/*/* ]] || { echo "[ERROR] invalid secret reference" >&2; exit 1; }
    printf '%s\n' "${FAKE_OP_VALUE:-}"
    ;;
  *)
    echo "[ERROR] fake op: unsupported command $*" >&2
    exit 1
    ;;
esac
